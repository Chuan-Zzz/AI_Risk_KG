# AI Risk Knowledge Graph - Environment Variables
# Copy this file to .env and fill in your values

# ===========================================
# LLM API Configuration
# ===========================================
# Primary LLM API Key (required)
LLM_API_KEY=your_llm_api_key_here

# Alternative: DashScope API Key (阿里云通义千问)
# DASHSCOPE_API_KEY=sk-xxx

# ===========================================
# Neo4j Database Configuration
# ===========================================
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

# ===========================================
# Web Search API (Optional)
# ===========================================
# Tavily API Key for web search augmentation
# TAVILY_API_KEY=tvly-xxx

# Bing Search API (alternative)
# BING_API_KEY=your_bing_api_key
# BING_ENDPOINT=https://api.bing.microsoft.com/v7.0/search
