    airo:sourceDocId "5610" .

<https://w3id.org/airo/incident/evidence/7237592fb846> a airo:Evidence ;
    airo:evidenceText "FaceApp CEO Yaroslav Goncharov has since apologized for the app’s whitewashing, issuing a statement to the FADER acknowledging the app’s criticisms." ;
    airo:sourceDocId "963" .

