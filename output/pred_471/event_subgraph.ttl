    airo:hasEvidence <https://w3id.org/airo/incident/evidence/57a12c3b05b2> ;
    airo:hasSourceDocument <https://w3id.org/airo/incident/document/6374> .

<https://w3id.org/airo/incident/AISystem/aed0b4728819> a airo:AISystem ;
    rdfs:label "Telegram" ;
    airo:confidenceScore "0.9"^^xsd:float ;
    airo:extractionMode "explicit" ;
    airo:hasDescription "Telegram" ;
    airo:hasEvidence <https://w3id.org/airo/incident/evidence/ef9a92b6e342> ;
    airo:hasSourceDocument <https://w3id.org/airo/incident/document/6374> .

<https://w3id.org/airo/incident/AISystem/b3b086236334> a airo:AISystem ;
    rdfs:label "Ultra IP" ;
    airo:confidenceScore "0.95"^^xsd:float ;
    airo:extractionMode "explicit" ;
    airo:hasDescription "Ultra IP" ;
    airo:hasEvidence <https://w3id.org/airo/incident/evidence/922c3dd84dd2> ;
    airo:hasSourceDocument <https://w3id.org/airo/incident/document/6374> .

<https://w3id.org/airo/incident/evidence/922c3dd84dd2> a airo:Evidence ;
    airo:evidenceText "El sistema de videovigilancia es desarrollado por una empresa con sede en Buenos Aires llamada Danaide SA, que vende su tecnología de vigilancia a través de un producto llamado Ultra IP." ;
    airo:sourceDocId "6374" .

<https://w3id.org/airo/incident/evidence/91616410095e> a airo:Evidence ;
    airo:evidenceText "El componente de reconocimiento facial del producto de Danaide es desarrollado por la empresa rusa NTechLab, que confirmó su asociación con la firma argentina a OneZero , pero no brindó más información debido a un acuerdo de no divulgación." ;
    airo:sourceDocId "6374" .

<https://w3id.org/airo/incident/evidence/ef23d3c5fe5d> a airo:Evidence ;
    airo:evidenceText "Biometric Update reported in 2020 that the algorithm used in Buenos Aires is supplied by NtechLab." ;
    airo:sourceDocId "6372" .

