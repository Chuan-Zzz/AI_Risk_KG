    airo:sourceDocId "4001" .

<https://w3id.org/airo/incident/evidence/d7675cc2fe1f> a airo:Evidence ;
    airo:evidenceText "Mother says son killed himself because of Daenerys Targaryen AI chatbot in new lawsuit" ;
    airo:sourceDocId "4003" .

<https://w3id.org/airo/incident/evidence/d83fa47a3d75> a airo:Evidence ;
    airo:evidenceText "Sewell Setzer III committed suicide at his Orlando home in February after becoming obsessed and allegedly falling in love with a chatbot on Character.AI, a lawsuit alleges." ;
    airo:sourceDocId "3996" .

<https://w3id.org/airo/incident/evidence/da0ffc6a82d4> a airo:Evidence ;
    airo:evidenceText "Mother says AI chatbot led her son to kill himself in lawsuit against its maker" ;
    airo:sourceDocId "5478" .

<https://w3id.org/airo/incident/evidence/dc94b750887c> a airo:Evidence ;
    airo:evidenceText "Last week, Megan L. Garcia filed a lawsuit against Character.AI, calling its chatbot feature “dangerous and untested.”" ;
    airo:sourceDocId "4010" .

<https://w3id.org/airo/incident/evidence/de4311f804d3> a airo:Evidence ;
    airo:evidenceText "[4004] ...an application that allows users to have human-like conversations with AI bots. [3994] Sewell Setzer, Garcia’s son, had entered a months-long emotional and sexual relationship with Character.AI’s chatbot Dany..." ;
    airo:sourceDocId "4004" .

<https://w3id.org/airo/incident/evidence/e209adfb116f> a airo:Evidence ;
    airo:evidenceText "Some 18 years after her death, her father Drew Crecente discovered someone had made a bot out of her likeness and it had been used for at least 69 chats." ;
    airo:sourceDocId "3994" .

<https://w3id.org/airo/incident/evidence/e2220df3856b> a airo:Evidence ;
    airo:evidenceText "[3997] Megan Garcia says Character.AI targeted her son, Sewell Setzer, with \"anthropomorphic, hypersexualized, and frighteningly realistic experiences\"." ;
    airo:sourceDocId "3997" .

<https://w3id.org/airo/incident/evidence/e372825194d8> a airo:Evidence ;
    airo:evidenceText "In response to questions for this column, Jerry Ruoti, Character.AI's head of trust and safety, sent a statement that began, \"We want to acknowledge that this is a tragic situation, and our hearts go out to the family." ;
    airo:sourceDocId "3988" .

<https://w3id.org/airo/incident/evidence/e6c9ac7260ed> a airo:Evidence ;
    airo:evidenceText "\"By and large, it's the Wild West out there,\" said Bethanie Maples, a Stanford researcher who has studied the effects of A.I. companionship apps on mental health." ;
    airo:sourceDocId "3988" .

<https://w3id.org/airo/incident/evidence/e7263da55930> a airo:Evidence ;
    airo:evidenceText "Character.AI works by using sophisticated large language models (LLM) to facilitate conversations between users and characters." ;
    airo:sourceDocId "4001" .

<https://w3id.org/airo/incident/evidence/f5d1c26c7346> a airo:Evidence ;
    airo:evidenceText "A 14-year-old boy fell in love with a flirty AI chatbot. He shot himself so they could die together" ;
    airo:sourceDocId "4016" .

<https://w3id.org/airo/incident/evidence/f84e7510a62e> a airo:Evidence ;
    airo:evidenceText "Sewell Setzer: Character.AI, Google sued over teen suicide" ;
    airo:sourceDocId "3995" .

<https://w3id.org/airo/incident/evidence/f99c52f82855> a airo:Evidence ;
    airo:evidenceText "The lawsuit, which names Character Technology Inc (Character.AI), Google, and Shazeer and Adiwardana, alleges that Character.AI used Google's resources and knowledge to target children under 13." ;
    airo:sourceDocId "4023" .

<https://w3id.org/airo/incident/evidence/fd7355255e48> a airo:Evidence ;
    airo:evidenceText "Mother sues AI chatbot company Character.AI, Google over son's suicide" ;
