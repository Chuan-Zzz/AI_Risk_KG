    airo:sourceDocId "3359" .

<https://w3id.org/airo/incident/evidence/367d379557e7> a airo:Evidence ;
    airo:evidenceText "There are also AI-detection tools that can be accessed online, including AI or Not and Maybe's AI Art Detector." ;
