<https://w3id.org/airo/incident/Vulnerability/b5664fa5d8ad> a airo:Vulnerability ;
    rdfs:label "model bias from diversity insertion leading to factual inaccuracies" ;
    airo:confidenceScore "0.9"^^xsd:float ;
    airo:extractionMode "abstracted" ;
    airo:hasEvidence <https://w3id.org/airo/incident/evidence/2497ed84ffce> ;
    airo:hasSourceDocument <https://w3id.org/airo/incident/document/3572> .

<https://w3id.org/airo/incident/evidence/016a865c9bb5> a airo:Evidence ;
    airo:evidenceText "[3559] Open AI last week launched Sora, its new generative AI model that is able to produce video from users' text prompts." ;
    airo:sourceDocId "3559" .

<https://w3id.org/airo/incident/evidence/034a64df582a> a airo:Evidence ;
    airo:evidenceText "[3573] Google started offering image generation through its Gemini AI models earlier this month." ;
    airo:sourceDocId "3573" .

<https://w3id.org/airo/incident/evidence/0447c9be51b5> a airo:Evidence ;
    airo:evidenceText "But that only explains half the story. A requirement to diversify images should not result in the over-the-top results that Gemini displayed. Brin, who has been contributing to Google’s AI projects since late 2022, was at a loss too, saying: “We haven’t fully understood why it leans left in many cases” and “that’s not our intention.”" ;
    airo:sourceDocId "3565" .

<https://w3id.org/airo/incident/evidence/05bdd5a24978> a airo:Evidence ;
    airo:evidenceText "[3559] Open AI last week launched Sora, its new generative AI model that is able to produce video from users' text prompts." ;
    airo:sourceDocId "3559" .

<https://w3id.org/airo/incident/evidence/06d1ededdb94> a airo:Evidence ;
    airo:evidenceText "[3573] Google started offering image generation through its Gemini AI models earlier this month." ;
    airo:sourceDocId "3573" .

<https://w3id.org/airo/incident/evidence/0c5c2bc28d76> a airo:Evidence ;
    airo:evidenceText "[3558] Bard was developed as Google’s attempt to compete with OpenAI’s ChatGPT Plus, which allows users to generate images using capabilities from OpenAI’s image generator DALL-E 3." ;
    airo:sourceDocId "3558" .

<https://w3id.org/airo/incident/evidence/0ee46887d068> a airo:Evidence ;
    airo:evidenceText "Among the bizarre results generated by Google Gemini that users posted on social media was a racially diverse group of images depicting a “1943 German soldier.”" ;
    airo:sourceDocId "3561" .

<https://w3id.org/airo/incident/evidence/0f471aef974a> a airo:Evidence ;
    airo:evidenceText "Gemini can generate a \"wide range of people,\" which the company said is \"generally a good thing\" because people around the world use the system, but it is \"missing the mark.\"" ;
    airo:sourceDocId "3578" .

<https://w3id.org/airo/incident/evidence/0fc3b4f8e8db> a airo:Evidence ;
    airo:evidenceText "The product lead for Gemini, Jack Krawczyk, addressed the issues in a now-deleted post on X, explaining that they had overcorrected with Gemini’s model when attempting to combat widespread AI bias with depictions of people of color." ;
    airo:sourceDocId "3563" .

<https://w3id.org/airo/incident/evidence/135367e0bd9c> a airo:Evidence ;
    airo:evidenceText "[3573] Google started offering image generation through its Gemini AI models earlier this month." ;
    airo:sourceDocId "3573" .

<https://w3id.org/airo/incident/evidence/136639458e25> a airo:Evidence ;
    airo:evidenceText "Generations from Gemini AI from the prompt, \"Paint me a historically accurate depiction of a medieval British king.\"" ;
    airo:sourceDocId "3515" .

<https://w3id.org/airo/incident/evidence/14f875c91726> a airo:Evidence ;
    airo:evidenceText "[3558] Bard was developed as Google’s attempt to compete with OpenAI’s ChatGPT Plus, which allows users to generate images using capabilities from OpenAI’s image generator DALL-E 3." ;
    airo:sourceDocId "3558" .

<https://w3id.org/airo/incident/evidence/1780d86ccb9a> a airo:Evidence ;
    airo:evidenceText "Google is pausing an AI tool that creates images of people following inaccuracies in some historical depictions the model generated." ;
    airo:sourceDocId "3573" .

<https://w3id.org/airo/incident/evidence/17d61ab44924> a airo:Evidence ;
    airo:evidenceText "[3558] Bard was developed as Google’s attempt to compete with OpenAI’s ChatGPT Plus, which allows users to generate images using capabilities from OpenAI’s image generator DALL-E 3." ;
    airo:sourceDocId "3558" .

<https://w3id.org/airo/incident/evidence/18fc60050739> a airo:Evidence ;
    airo:evidenceText "Some Gemini users have shared screenshots of apparent historical inaccuracies, with Gemini creating images of a Native American man and Indian woman when tasked with prompts such as a representative 1820s-era German couple." ;
    airo:sourceDocId "3575" .

<https://w3id.org/airo/incident/evidence/192115cdcc8b> a airo:Evidence ;
    airo:evidenceText "Gemini, a chatbot based on the company’s most advanced AI technology, angered users last week by producing ahistoric images and blocking requests for depictions of white people." ;
    airo:sourceDocId "3513" .

<https://w3id.org/airo/incident/evidence/1e58661af957> a airo:Evidence ;
    airo:evidenceText "[3573] Google started offering image generation through its Gemini AI models earlier this month." ;
    airo:sourceDocId "3573" .

<https://w3id.org/airo/incident/evidence/1e9768874778> a airo:Evidence ;
    airo:evidenceText "[3567] Google launched Gemini, a chatbot formerly known as Bard and powered by a large language model, on February 8—competing with generative AI programs like OpenAI’s ChatGPT, which is backed by rival Microsoft." ;
    airo:sourceDocId "3567" .

<https://w3id.org/airo/incident/evidence/1fca8f48ccf8> a airo:Evidence ;
    airo:evidenceText "“Gemini’s AI image generation does generate a wide range of people. And that’s generally a good thing because people around the world use it. But it’s missing the mark here.”" ;
    airo:sourceDocId "3569" .

<https://w3id.org/airo/incident/evidence/218df143c1e9> a airo:Evidence ;
    airo:evidenceText "[3559] Open AI last week launched Sora, its new generative AI model that is able to produce video from users' text prompts." ;
    airo:sourceDocId "3559" .

<https://w3id.org/airo/incident/evidence/21992c766c60> a airo:Evidence ;
    airo:evidenceText "[3558] Bard was developed as Google’s attempt to compete with OpenAI’s ChatGPT Plus, which allows users to generate images using capabilities from OpenAI’s image generator DALL-E 3." ;
    airo:sourceDocId "3558" .

<https://w3id.org/airo/incident/evidence/272cbd5daf6c> a airo:Evidence ;
    airo:evidenceText "[3559] Open AI last week launched Sora, its new generative AI model that is able to produce video from users' text prompts." ;
    airo:sourceDocId "3559" .

<https://w3id.org/airo/incident/evidence/2841d4426be5> a airo:Evidence ;
    airo:evidenceText "Last week Google rolled out a major update to it with the limited release of Gemini Pro 1.5, which allowed users to handle vast amounts of audio, text, and video input." ;
