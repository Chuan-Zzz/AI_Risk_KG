<https://w3id.org/airo/incident/AISystem/f6c448097b4d> a airo:AISystem ;
    rdfs:label "Microsoft Copilot" ;
    airo:confidenceScore "0.95"^^xsd:float ;
    airo:extractionMode "explicit" ;
    airo:hasDescription "Microsoft’s Copilot" ;
    airo:hasEvidence <https://w3id.org/airo/incident/evidence/d900720060b7> ;
    airo:hasSourceDocument <https://w3id.org/airo/incident/document/3511> .

<https://w3id.org/airo/incident/evidence/3aaf92b0a8fe> a airo:Evidence ;
    airo:evidenceText "3 weeks ago, we launched a new image generation feature for the Gemini conversational app (formerly known as Bard), which included the ability to create images of people." ;
    airo:sourceDocId "3516" .

<https://w3id.org/airo/incident/evidence/97ea7975f9a7> a airo:Evidence ;
    airo:evidenceText "The company’s caution created an opening for the startup OpenAI and its largest backer Microsoft to steal the spotlight with the viral ChatGPT service." ;
    airo:sourceDocId "3513" .

<https://w3id.org/airo/incident/evidence/be23e03bab45> a airo:Evidence ;
    airo:evidenceText "Google launched Gemini, a chatbot formerly known as Bard and powered by a large language model, on February 8—competing with generative AI programs like OpenAI’s ChatGPT, which is backed by rival Microsoft." ;
    airo:sourceDocId "3567" .

<https://w3id.org/airo/incident/evidence/dee745532d15> a airo:Evidence ;
    airo:evidenceText "When we tested Meta's \"Imagine with Meta AI\" image generator in December, we noticed a similar inserted diversity principle at work as an attempt to counteract bias." ;
    airo:sourceDocId "3515" .

<https://w3id.org/airo/incident/evidence/19c807d7148b> a airo:Evidence ;
    airo:evidenceText "ChatGPT reportedly went a bit off the rails Wednesday, providing nonsensical responses to some user queries. OpenAI says it's since 'remediated' the issue." ;
    airo:sourceDocId "3560" .

<https://w3id.org/airo/incident/evidence/c09d98d62b81> a airo:Evidence ;
    airo:evidenceText "As it integrates natural language processing and image recognition, Gemini enables tasks such as image captioning and complex visual parsing." ;
    airo:sourceDocId "3564" .

<https://w3id.org/airo/incident/evidence/7ed15f5fc133> a airo:Evidence ;
    airo:evidenceText "Google has apologized for what it describes as “inaccuracies in some historical image generation depictions” with its Gemini AI tool." ;
    airo:sourceDocId "3557" .

<https://w3id.org/airo/incident/evidence/ca382c75d768> a airo:Evidence ;
    airo:evidenceText "These are direct violations of Rule 3(1)(b) of Intermediary Rules (IT rules) of the IT Act and violations of several provisions of the Criminal Code,” he wrote on social media." ;
    airo:sourceDocId "3553" .

<https://w3id.org/airo/incident/evidence/353cd660d631> a airo:Evidence ;
    airo:evidenceText "Google began offering image generation through its Gemini (formerly Bard) AI platform earlier this month, matching the offerings of competitors like OpenAI.",
        "Google began offering image generation through its Gemini (formerly Bard) AI platform earlier this month." ;
    airo:sourceDocId "3557" .

<https://w3id.org/airo/incident/evidence/938d33f2e334> a airo:Evidence ;
    airo:evidenceText "Google says it’s pausing the ability for its Gemini AI to generate images of people, after the tool was found to be generating inaccurate historical images." ;
    airo:sourceDocId "3511" .

<https://w3id.org/airo/incident/evidence/b456232b8749> a airo:Evidence ;
    airo:evidenceText "Google said Thursday it is temporarily stopping its Gemini artificial intelligence chatbot from generating images of people a day after apologizing for “inaccuracies” in historical depictions that it was creating." ;
    airo:sourceDocId "3510" .

