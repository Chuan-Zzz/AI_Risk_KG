    airo:hasSourceDocument <https://w3id.org/airo/incident/document/7727> .

<https://w3id.org/airo/incident/Vulnerability/37c9cb8d165e> a airo:Vulnerability ;
    rdfs:label "lack of robustness and reliability of driver-assistance systems in complex environments" ;
    airo:confidenceScore "0.9"^^xsd:float ;
    airo:extractionMode "abstracted" ;
    airo:hasEvidence <https://w3id.org/airo/incident/evidence/16499db51752> ;
    airo:hasSourceDocument <https://w3id.org/airo/incident/document/3447> .

<https://w3id.org/airo/incident/evidence/03d0e2c8f9ca> a airo:Evidence ;
    airo:evidenceText "It is worth mentioning that previous serious or fatal crashes involving Tesla vehicles and driver assistance systems, such as Autopilot, have been reported." ;
    airo:sourceDocId "3462" .

<https://w3id.org/airo/incident/evidence/051358b2e6d8> a airo:Evidence ;
    airo:evidenceText "Rossiter's claim that FSD was engaged raises questions about the system's safety and the way drivers interact with it." ;
    airo:sourceDocId "3456" .

<https://w3id.org/airo/incident/evidence/052a2034e0f6> a airo:Evidence ;
    airo:evidenceText "However, NHTSA could not confirm which program was involved in the crash." ;
    airo:sourceDocId "3454" .

<https://w3id.org/airo/incident/evidence/0569587e0886> a airo:Evidence ;
    airo:evidenceText "[3452] Earlier this month, after pressure from NHTSA, Tesla announced a recall of more than 350,000 of its vehicles with 'full driving' or 'auto drive system.'" ;
    airo:sourceDocId "3452" .

<https://w3id.org/airo/incident/evidence/090f8c6f5b69> a airo:Evidence ;
    airo:evidenceText "Colorado State Police determined that intoxication was the main factor behind the accident, but it also conducted an investigation into the possible role of Tesla's Full Self-Driving Beta." ;
    airo:sourceDocId "3449" .

<https://w3id.org/airo/incident/evidence/0b685b4702dd> a airo:Evidence ;
    airo:evidenceText "\"Regardless of how drunk Hans was, Musk has claimed that this car can drive itself and is essentially better than a human,\" von Ohain's widow Nora Bass told WaPo." ;
    airo:sourceDocId "7673" .

<https://w3id.org/airo/incident/evidence/0d660eed8cec> a airo:Evidence ;
    airo:evidenceText "[3463] Ohain's buddy Erik Rossiter, who was in the car when it crashed and erupted in flames, reportedly told The Washington Post that Ohain was using the Tesla's auto-drive option when it went off the road and smashed into a tree." ;
    airo:sourceDocId "3463" .

<https://w3id.org/airo/incident/evidence/0d86a4f27c41> a airo:Evidence ;
    airo:evidenceText "Von Ohain’s widow Nora Bass wants Tesla to take responsibility for her husband’s death:" ;
    airo:sourceDocId "7727" .

<https://w3id.org/airo/incident/evidence/0ea3b5569c57> a airo:Evidence ;
    airo:evidenceText "His friend and fellow passenger Erik Rossiter, who survived the collision, has since told The Washington Post that von Ohain had the car's Full Self-Driving feature turned on at the time of the fatal accident." ;
    airo:sourceDocId "7673" .

<https://w3id.org/airo/incident/evidence/15ecae87852e> a airo:Evidence ;
    airo:evidenceText "Sgt. Robert Madden from the Colorado State Patrol told the Post that there weren't any skid marks, which show up if the car tried to brake before hitting." ;
    airo:sourceDocId "3457" .

<https://w3id.org/airo/incident/evidence/186f07959e4e> a airo:Evidence ;
    airo:evidenceText "This, Colorado State Patrol Sgt. Robert Madden told the Post, was a clear sign that \"fits with the [driver-assistance] feature being engaged.\"" ;
    airo:sourceDocId "3454" .

<https://w3id.org/airo/incident/evidence/1b1e4f0df17d> a airo:Evidence ;
    airo:evidenceText "Sgt. Robert Madden of Colorado State Patrol told the Post there were no skid marks, which would have indicated the vehicle attempted to brake before impact, but there were \"rolling tire marks,\" meaning power was still being deployed to the wheels after the crash." ;
    airo:sourceDocId "6076" .

<https://w3id.org/airo/incident/evidence/1c34a38d096f> a airo:Evidence ;
    airo:evidenceText "Von Ohain and passenger Erik Rossiter were involved in the accident that saw the Tesla Model 3 hit a tree and burst into flames." ;
    airo:sourceDocId "3458" .

<https://w3id.org/airo/incident/evidence/1d794dc7985e> a airo:Evidence ;
    airo:evidenceText "The Tesla Model 3 barreled into a tree and exploded in flames, killing von Ohain, a Tesla employee and devoted fan of CEO Elon Musk." ;
    airo:sourceDocId "3454" .

<https://w3id.org/airo/incident/evidence/22c7684bef54> a airo:Evidence ;
    airo:evidenceText "Hans von Ohain was killed when his Tesla Model 3 crashed into a tree and caught fire in Evergreen, Colorado." ;
    airo:sourceDocId "3461" .

<https://w3id.org/airo/incident/evidence/24abfddecd85> a airo:Evidence ;
    airo:evidenceText "The horrible fatal crash of a Tesla employee using Full Self-Driving Beta has been reported in detail for the first time to highlight responsibility in those accidents." ;
    airo:sourceDocId "3449" .

<https://w3id.org/airo/incident/evidence/2d115739272f> a airo:Evidence ;
    airo:evidenceText "Colorado State Patrol, who is leading the investigation, has yet to finalize its report from the crash but is working to answer those questions." ;
    airo:sourceDocId "3453" .

<https://w3id.org/airo/incident/evidence/2efb57252b1c> a airo:Evidence ;
    airo:evidenceText "'Regardless of how drunk Hans was, Musk has claimed that this car can drive itself and is essentially better than a human,' von Ohain's widow Nora Bass told the Washington Post." ;
    airo:sourceDocId "6131" .

<https://w3id.org/airo/incident/evidence/2fb9b88f6b31> a airo:Evidence ;
    airo:evidenceText "It was possible that the driver-assistance feature was activated at the time of the collision because there were rolling tire marks and no skid marks." ;
    airo:sourceDocId "3463" .

<https://w3id.org/airo/incident/evidence/2feb6f2636f9> a airo:Evidence ;
    airo:evidenceText "Erik Rossiter, a survivor of the accident, has claimed that the Full Self-Driving (FSD) feature was active during the crash." ;
    airo:sourceDocId "3460" .

<https://w3id.org/airo/incident/evidence/305cef39332e> a airo:Evidence ;
    airo:evidenceText "[3463] Ohain's buddy Erik Rossiter, who was in the car when it crashed and erupted in flames, reportedly told The Washington Post that Ohain was using the Tesla's auto-drive option when it went off the road and smashed into a tree." ;
    airo:sourceDocId "3463" .

<https://w3id.org/airo/incident/evidence/31a0f6710f84> a airo:Evidence ;
    airo:evidenceText "Tesla's Full Self-Driving software can't drive your car by itself." ;
    airo:sourceDocId "3454" .

<https://w3id.org/airo/incident/evidence/3303cfe27246> a airo:Evidence ;
    airo:evidenceText "Now, the widow of a driver killed in a crash that involved FSD has accused the automaker of selling a \"false sense of security\" with the software." ;
    airo:sourceDocId "3454" .

<https://w3id.org/airo/incident/evidence/3c1df3823274> a airo:Evidence ;
    airo:evidenceText "There have been numerous crashes, some fatal, linked to Tesla's Autopilot technology, which is designed for use on highways, though Tesla has not been found responsible for the crashes." ;
    airo:sourceDocId "6076" .

<https://w3id.org/airo/incident/evidence/432b6580dcf1> a airo:Evidence ;
    airo:evidenceText "Earlier this year, published reports announced NHTSA was expanding its investigation into the auto drive function on several Tesla models, including the 2021 Model 3 involved in the Evergreen crash." ;
    airo:sourceDocId "3453" .

<https://w3id.org/airo/incident/evidence/4395cf936936> a airo:Evidence ;
    airo:evidenceText "The incident occurred in 2022, when a Tesla employee named Hans von Ohain was using FSD on a winding road in Evergreen, Colorado." ;
    airo:sourceDocId "3462" .

<https://w3id.org/airo/incident/evidence/4ef497aea8f1> a airo:Evidence ;
    airo:evidenceText "The Washington Post described the crash: Hours later, on the way home, the Tesla Model 3 barreled into a tree and exploded in flames, killing von Ohain, a Tesla employee and devoted fan of CEO Elon Musk." ;
    airo:sourceDocId "7727" .

<https://w3id.org/airo/incident/evidence/50be8a3ec22f> a airo:Evidence ;
    airo:evidenceText "Rossiter says that von Ohain was driving on FSD beta, Tesla's driver-assist system that takes over all the driving controls but the driver needs to keep their hands on the steering wheel and be ready to take control at all times." ;
    airo:sourceDocId "3449" .

<https://w3id.org/airo/incident/evidence/581afb21e630> a airo:Evidence ;
    airo:evidenceText "Despite its name, the advanced driver assist program requires drivers keep their eyes on the road at all times and be prepared to take the wheel at a moment's notice." ;
    airo:sourceDocId "3454" .

<https://w3id.org/airo/incident/evidence/5d89061691d1> a airo:Evidence ;
    airo:evidenceText "The Washington Post released a new report on the crash today, which happened back in 2022." ;
    airo:sourceDocId "7727" .

<https://w3id.org/airo/incident/evidence/5df5ce74ac64> a airo:Evidence ;
    airo:evidenceText "In fact, official data cannot even confirm whether it was FSD or Autopilot that was engaged, and the distinction may be meaningful." ;
    airo:sourceDocId "3456" .

<https://w3id.org/airo/incident/evidence/5f06360fc9d8> a airo:Evidence ;
    airo:evidenceText "Family of Tesla recruiter who died in 2022 horror crash say self-driving tech killed him as surviving friend insists he was 'in control' of the vehicle despite being three times the drink drive limit" ;
    airo:sourceDocId "3451" .

<https://w3id.org/airo/incident/evidence/61cdc924a87e> a airo:Evidence ;
    airo:evidenceText "Evidence suggests that Tesla's advanced driver-assistance system, Full Self-Driving (FSD), was engaged during a fatal crash that killed Tesla employee Hans von Ohain in Colorado in 2022." ;
    airo:sourceDocId "3461" .

<https://w3id.org/airo/incident/evidence/664189d8cb0b> a airo:Evidence ;
    airo:evidenceText "While NHTSA documents confirm that Tesla's driver assistance systems were engaged 30 seconds prior to the accident, there is little more official data available." ;
    airo:sourceDocId "3456" .

<https://w3id.org/airo/incident/evidence/6bdf3bb3600d> a airo:Evidence ;
    airo:evidenceText "The driver, 33-year-old Hans von Ohain, died at the scene." ;
    airo:sourceDocId "3453" .

<https://w3id.org/airo/incident/evidence/6ee73c1e824a> a airo:Evidence ;
    airo:evidenceText "Erik Rossiter, a friend of Ohain's who was in the vehicle at the time of the 2022 crash and survived the incident, told first responders Ohain had been using the \"auto-drive feature on the Tesla\" and the vehicle \"just ran straight off the road,\" the outlet reported." ;
    airo:sourceDocId "6076" .

<https://w3id.org/airo/incident/evidence/738b1b6f42a0> a airo:Evidence ;
    airo:evidenceText "Von Ohain's widow, Nora Bass, said she has been unable to find a lawyer willing to take his case to court because he was legally intoxicated." ;
    airo:sourceDocId "3454" .

<https://w3id.org/airo/incident/evidence/7b698173e358> a airo:Evidence ;
    airo:evidenceText "The majority included Tesla's Autopilot, meant for highway use, although full self-driving, intended for more situations, has not been related to any fatalities." ;
    airo:sourceDocId "3459" .

<https://w3id.org/airo/incident/evidence/7c9b96cca7ac> a airo:Evidence ;
    airo:evidenceText "[3452] Earlier this month, after pressure from NHTSA, Tesla announced a recall of more than 350,000 of its vehicles with 'full driving' or 'auto drive system.'" ;
    airo:sourceDocId "3452" .

<https://w3id.org/airo/incident/evidence/7e2db732e3b8> a airo:Evidence ;
    airo:evidenceText "[3463] Ohain's buddy Erik Rossiter, who was in the car when it crashed and erupted in flames, reportedly told The Washington Post that Ohain was using the Tesla's auto-drive option when it went off the road and smashed into a tree." ;
    airo:sourceDocId "3463" .

<https://w3id.org/airo/incident/evidence/849aea11af4c> a airo:Evidence ;
    airo:evidenceText "Family of Tesla recruiter who died in 2022 horror crash say self-driving tech killed him as surviving friend insists he was 'in control' of the vehicle despite being three times the drink drive limit" ;
    airo:sourceDocId "6131" .

<https://w3id.org/airo/incident/evidence/8631538d2adf> a airo:Evidence ;
    airo:evidenceText "Surviving passenger and friend Erik Rossiter informed emergency responders that the victim had activated the \"auto-drive feature\" before the crash." ;
    airo:sourceDocId "3459" .

<https://w3id.org/airo/incident/evidence/873039dae680> a airo:Evidence ;
    airo:evidenceText "Most crashes involved Tesla's simpler Autopilot system." ;
    airo:sourceDocId "3461" .

<https://w3id.org/airo/incident/evidence/879613eb8765> a airo:Evidence ;
    airo:evidenceText "[3463] Ohain's buddy Erik Rossiter, who was in the car when it crashed and erupted in flames, reportedly told The Washington Post that Ohain was using the Tesla's auto-drive option when it went off the road and smashed into a tree." ;
    airo:sourceDocId "3463" .

<https://w3id.org/airo/incident/evidence/935cee8e8b77> a airo:Evidence ;
    airo:evidenceText "Wife of Tesla employee who died in what may have been the first Full Self-Driving crash said she and her husband were 'guinea pigs'" ;
    airo:sourceDocId "3450" .

<https://w3id.org/airo/incident/evidence/9744973db5c1> a airo:Evidence ;
    airo:evidenceText "A Tesla employee died in what may've been the first death tied to Tesla's Full Self-Driving tech." ;
    airo:sourceDocId "6076" .

<https://w3id.org/airo/incident/evidence/a036ce4c8348> a airo:Evidence ;
    airo:evidenceText "Colorado State Patrol Sgt. Robert Madden, who led the investigation, has rolling tire marks at the site of the crash, which means that the motor kept sending power to the wheels at the time of impact." ;
    airo:sourceDocId "7727" .

<https://w3id.org/airo/incident/evidence/a325eca1253a> a airo:Evidence ;
    airo:evidenceText "The National Highway Traffic Safety Administration is already investigating Tesla's Autopilot after several accidents involving emergency response vehicles." ;
    airo:sourceDocId "3460" .

<https://w3id.org/airo/incident/evidence/a4908cf0edbb> a airo:Evidence ;
    airo:evidenceText "Tesla, however, declined to comment on the incident." ;
    airo:sourceDocId "3462" .

<https://w3id.org/airo/incident/evidence/a56c45d29678> a airo:Evidence ;
    airo:evidenceText "Hans von Ohain, 33, was killed in a fiery wreck in Colorado in 2022 after his Tesla swerved violently off a winding country road." ;
    airo:sourceDocId "6131" .

<https://w3id.org/airo/incident/evidence/a6dd2da90f3b> a airo:Evidence ;
    airo:evidenceText "According to survivor Erik Rossiter, who was a passenger in the vehicle, Ohain had been using FSD throughout their journey after a day of golfing." ;
    airo:sourceDocId "3462" .

<https://w3id.org/airo/incident/evidence/a8236cfd721d> a airo:Evidence ;
    airo:evidenceText "[3458] Nora Bass, the widow of von Ohain, shifted blame to Tesla CEO Elon Musk and expressed frustration over not being able to find a lawyer who would take the case." ;
    airo:sourceDocId "3458" .

<https://w3id.org/airo/incident/evidence/a9099bf8346e> a airo:Evidence ;
    airo:evidenceText "Tesla Employee Who Loved Elon Musk Reportedly Killed by Full Self-Driving" ;
    airo:sourceDocId "3448" .

<https://w3id.org/airo/incident/evidence/a915ce25bf71> a airo:Evidence ;
    airo:evidenceText "His passenger Erik Rossiter, who barely escaped the wreck with his life, said that hours earlier the car had already driven erratically by itself, causing the recruiter to grab the wheel several times." ;
    airo:sourceDocId "6131" .

<https://w3id.org/airo/incident/evidence/b13ee9a297a3> a airo:Evidence ;
    airo:evidenceText "His passenger, Erik Rossiter, survived the crash." ;
    airo:sourceDocId "3461" .

<https://w3id.org/airo/incident/evidence/b42d1be0d69a> a airo:Evidence ;
    airo:evidenceText "[3463] Ohain's buddy Erik Rossiter, who was in the car when it crashed and erupted in flames, reportedly told The Washington Post that Ohain was using the Tesla's auto-drive option when it went off the road and smashed into a tree." ;
    airo:sourceDocId "3463" .

<https://w3id.org/airo/incident/evidence/bc54d8f35de5> a airo:Evidence ;
    airo:evidenceText "The Washington Post described the crash: Hours later, on the way home, the Tesla Model 3 barreled into a tree and exploded in flames, killing von Ohain, a Tesla employee and devoted fan of CEO Elon Musk." ;
    airo:sourceDocId "3449" .

<https://w3id.org/airo/incident/evidence/be69e71fa394> a airo:Evidence ;
    airo:evidenceText "Despite the company's misleading marketing, Tesla vehicles are still far from being able to drive themselves, and cautions on its website that drivers must be \"ready to take immediate action including braking.\"" ;
    airo:sourceDocId "7673" .

<https://w3id.org/airo/incident/evidence/c3e13afc3356> a airo:Evidence ;
    airo:evidenceText "Tesla stresses that a fully attentive driver who is ready to take control at any time is required for its present self-driving technology." ;
    airo:sourceDocId "3463" .

<https://w3id.org/airo/incident/evidence/ca9c8064d74d> a airo:Evidence ;
    airo:evidenceText "During the drive there, Rossiter says that von Ohain was driving on FSD beta, Tesla’s driver-assist system that takes over all the driving controls but the driver needs to keep their hands on the steering wheel and be ready to take control at all times." ;
    airo:sourceDocId "7727" .

<https://w3id.org/airo/incident/evidence/cd439bbbb47f> a airo:Evidence ;
    airo:evidenceText "However, Tesla CEO Elon has taken to social media to dispute The Post's story, claiming that Ohain's car wasn't equipped with FSD capability." ;
    airo:sourceDocId "3455" .

<https://w3id.org/airo/incident/evidence/cf2a49d03abd> a airo:Evidence ;
    airo:evidenceText "[6076] Hans von Ohain, a Tesla recruiter, died in a car crash on a Colorado mountain road after his Tesla Model 3 veered off the road and barreled into a tree, bursting into flames." ;
    airo:sourceDocId "6076" .

<https://w3id.org/airo/incident/evidence/d0c83aca16f8> a airo:Evidence ;
    airo:evidenceText "Rossiter's testimony and evidence suggest that Autopilot wasn't being used." ;
    airo:sourceDocId "3458" .

<https://w3id.org/airo/incident/evidence/d5a738b32ad9> a airo:Evidence ;
    airo:evidenceText "If what Rossiter said is true, the incident --- which Tesla has so far refused to acknowledge publicly --- would be the first known fatality linked to the car company's Full Self-Driving technology." ;
    airo:sourceDocId "3450" .

<https://w3id.org/airo/incident/evidence/da31b6667fc2> a airo:Evidence ;
    airo:evidenceText "[6076] Sgt. Robert Madden of Colorado State Patrol told the Post there were no skid marks, which would have indicated the vehicle attempted to brake before impact, but there were 'rolling tire marks,' meaning power was still being deployed to the wheels after the crash." ;
    airo:sourceDocId "6076" .

<https://w3id.org/airo/incident/evidence/dea4ad4cedd4> a airo:Evidence ;
    airo:evidenceText "Hans von Ohain, a Marine veteran and Tesla employee since 2020, was a believer in the potential of Tesla's full self-driving technology." ;
    airo:sourceDocId "3459" .

<https://w3id.org/airo/incident/evidence/e12c19fe3905> a airo:Evidence ;
    airo:evidenceText "[3463] Ohain's buddy Erik Rossiter, who was in the car when it crashed and erupted in flames, reportedly told The Washington Post that Ohain was using the Tesla's auto-drive option when it went off the road and smashed into a tree." ;
    airo:sourceDocId "3463" .

<https://w3id.org/airo/incident/evidence/e530e36bec12> a airo:Evidence ;
    airo:evidenceText "If this proves accurate, a Tesla employee could prove to be the very first fatality caused by Elon Musk's \"self-driving\" software." ;
    airo:sourceDocId "3461" .

<https://w3id.org/airo/incident/evidence/e5a6f06e0073> a airo:Evidence ;
    airo:evidenceText "Tesla worker died in horrible crash on Full Self-Driving beta, but he was also drunk" ;
    airo:sourceDocId "3449" .

<https://w3id.org/airo/incident/evidence/ebf5d91b4e76> a airo:Evidence ;
    airo:evidenceText "Tesla worker killed in fiery crash may be first ‘Full Self-Driving’ fatality" ;
    airo:sourceDocId "3447" .

<https://w3id.org/airo/incident/evidence/ecd3d38d8e46> a airo:Evidence ;
    airo:evidenceText "The passenger in a 2022 crash... has alleged that the driver was utilizing \"Full Self-Driving\" (FSD) when the vehicle careened off the road." ;
    airo:sourceDocId "3456" .

<https://w3id.org/airo/incident/evidence/f22277e7aea5> a airo:Evidence ;
    airo:evidenceText "Tesla has faced growing complaints over unreliable behavior by its driver-assistance software, including sudden swering or braking." ;
    airo:sourceDocId "3461" .

<https://w3id.org/airo/incident/evidence/f625c9300fca> a airo:Evidence ;
    airo:evidenceText "Supporters of self-driving car technologies claim that autonomous features like Tesla's Full Self-Driving system make cars safer." ;
    airo:sourceDocId "3455" .

<https://w3id.org/airo/incident/evidence/f74830889f5f> a airo:Evidence ;
    airo:evidenceText "Colorado State Police determined that intoxication was the main factor behind the accident, but it also conducted an investigation into the possible role of Tesla’s Full Self-Driving Beta." ;
    airo:sourceDocId "7727" .

<https://w3id.org/airo/incident/evidence/ff43be85130c> a airo:Evidence ;
    airo:evidenceText "Tesla CEO Elon Musk claimed that Ohain was not on FSD 'unfortunately.'" ;
    airo:sourceDocId "3457" .

<https://w3id.org/airo/incident/evidence/fffaa88c1dd2> a airo:Evidence ;
    airo:evidenceText "While the National Highway Traffic Safety Administration is already investigating Autopilot following a series of accidents in which Teslas have smashed into emergency response vehicles that were pulled over with sirens or flares, no fatal crash has been definitively linked to FSD — though von Ohain's death, as WaPo reports, sure looks suspicious." ;
    airo:sourceDocId "7673" .

