        <https://w3id.org/airo/incident/document/7673>,
        <https://w3id.org/airo/incident/document/7727> ;
    airo:hasSupportCount 17 ;
    airo:uses <https://w3id.org/airo/incident/AISystem/2c0afc4df3b7>,
        <https://w3id.org/airo/incident/AISystem/aaf2e0eac68a>,
        <https://w3id.org/airo/incident/AISystem/c2d0e50e4764>,
        <https://w3id.org/airo/incident/AISystem/cabce4840895>,
        <https://w3id.org/airo/incident/AISystem/d94f46c5dcfa> .

<https://w3id.org/airo/incident/evidence/050d85a13a16> a airo:Evidence ;
    airo:evidenceText "Earlier this week, the Washington Post reported that the person was Tesla employee Hans von Ohain, who was killed in a fiery collision when his Model 3 left the road and burst into flames after smashing into a tree." ;
    airo:sourceDocId "3455" .

<https://w3id.org/airo/incident/evidence/0cae217f988b> a airo:Evidence ;
    airo:evidenceText "The fiery crash that claimed Hans von Ohain's life occurred near Denver in 2022 as he and his friend, Erik Rossiter, were returning home after a game of golf." ;
    airo:sourceDocId "3456" .

<https://w3id.org/airo/incident/evidence/0f2ead3bd4e8> a airo:Evidence ;
    airo:evidenceText "The Austin, Texas-based company reported the accident to the National Highway Traffic Safety Administration (NHTSA) saying a driver-assistance feature had been used before the impact." ;
    airo:sourceDocId "3458" .

<https://w3id.org/airo/incident/evidence/2d5849b04803> a airo:Evidence ;
    airo:evidenceText "Madden also described the subsequent fire, which engulfed the car, as one of the \"most intense\" vehicle fires he had encountered, due largely to the lithium-ion battery cells housed in the undercarriage of the Tesla that Ohain was driving." ;
    airo:sourceDocId "3450" .

<https://w3id.org/airo/incident/evidence/3e7ddaca9f50> a airo:Evidence ;
    airo:evidenceText "Erik Rossiter, a friend of Ohain's who was in the vehicle at the time of the 2022 crash and survived the incident, told first responders Ohain had been using the \"auto-drive feature on the Tesla\" and the vehicle \"just ran straight off the road,\" the outlet reported." ;
    airo:sourceDocId "3450" .

<https://w3id.org/airo/incident/evidence/42db262a6407> a airo:Evidence ;
    airo:evidenceText "In late 2021, federal regulators began requiring automakers to report crashes involving driver-assistance systems." ;
    airo:sourceDocId "3461" .

<https://w3id.org/airo/incident/evidence/43b51c35c65d> a airo:Evidence ;
    airo:evidenceText "[6076] Hans von Ohain, a Tesla recruiter, died in a car crash on a Colorado mountain road after his Tesla Model 3 veered off the road and barreled into a tree, bursting into flames, according to a new report from The Washington Post." ;
    airo:sourceDocId "6076" .

<https://w3id.org/airo/incident/evidence/5c3ca96b6ca2> a airo:Evidence ;
    airo:evidenceText "Hans von Ohain, a recruiter at Tesla, and his friend Erik Rossiter set out outside Denver, Colorado, in the former’s Tesla Model 3 to go golfing." ;
    airo:sourceDocId "7727" .

<https://w3id.org/airo/incident/evidence/5f045b7a8282> a airo:Evidence ;
    airo:evidenceText "Ohain's buddy Erik Rossiter, who was in the car when it crashed and erupted into flames, reportedly told The Washington Post that Ohain was using the Tesla's auto-drive option when it went off the road and smashed into a tree." ;
    airo:sourceDocId "3463" .

<https://w3id.org/airo/incident/evidence/71044d18238a> a airo:Evidence ;
    airo:evidenceText "[6076] Hans von Ohain, a Tesla recruiter, died in a car crash on a Colorado mountain road after his Tesla Model 3 veered off the road and barreled into a tree, bursting into flames, according to a new report from The Washington Post." ;
    airo:sourceDocId "6076" .

<https://w3id.org/airo/incident/evidence/8d6e63dde783> a airo:Evidence ;
    airo:evidenceText "Though Tesla has not yet commented on the issue, it warns that Autopilot, Enhanced Autopilot, and Full Self-Driving Capability are designed to be utilized by a fully aware driver." ;
    airo:sourceDocId "3459" .

<https://w3id.org/airo/incident/evidence/9f2bcf23e0fa> a airo:Evidence ;
    airo:evidenceText "Denver7 Investigates confirmed that the National Highway Traffic Safety Administration (NHTSA) has collected data and information from the crash as part of its investigation." ;
    airo:sourceDocId "3453" .

<https://w3id.org/airo/incident/evidence/b764c68518e4> a airo:Evidence ;
    airo:evidenceText "Sgt. Robert Madden of Colorado State Patrol told the Post there were no skid marks, which would have indicated the vehicle attempted to brake before impact, but there were \"rolling tire marks,\" meaning power was still being deployed to the wheels after the crash." ;
    airo:sourceDocId "3450" .

<https://w3id.org/airo/incident/evidence/b8639a0fbf07> a airo:Evidence ;
    airo:evidenceText "A recent investigation by The Washington Post has shed light on a fatal crash involving Tesla's advanced driver-assistance software, Full Self-Driving (FSD)." ;
    airo:sourceDocId "3462" .

<https://w3id.org/airo/incident/evidence/c1fe0d25e188> a airo:Evidence ;
    airo:evidenceText "Instead, von Ohain and Rossiter used the full self-driving, function." ;
    airo:sourceDocId "3458" .

<https://w3id.org/airo/incident/evidence/c6ffd073556c> a airo:Evidence ;
    airo:evidenceText "[3463] The untimely demise of Tesla recruiter Hans von Ohain in a collision involving a Model 3 on a route in Colorado's mountains has prompted serious concerns about the reliability and security of Tesla's autonomous driving technology." ;
    airo:sourceDocId "3463" .

<https://w3id.org/airo/incident/evidence/ff2363f4b0ca> a airo:Evidence ;
    airo:evidenceText "Colorado State Patrol Sgt. Robert Madden, who oversaw the agency’s investigation, said the lithium battery cells may have contributed to the fireball, describing it as one of the 'most intense' vehicle fires he had seen." ;
    airo:sourceDocId "6131" .

<https://w3id.org/airo/incident/evidence/0b0be51f5e71> a airo:Evidence ;
    airo:evidenceText "Tesla's disclaimer for its current self-driving technology reads: \"Autopilot, Enhanced Autopilot, and Full Self-Driving Capability are intended for use with a fully attentive driver, who has their hands on the wheel and is prepared to take over at any moment." ;
    airo:sourceDocId "3450" .

<https://w3id.org/airo/incident/evidence/1d44bebd41df> a airo:Evidence ;
    airo:evidenceText "In 2022, Tesla employee Hans von Ohain was driving his Model 3 electric vehicle alongside Erik Rossiter." ;
    airo:sourceDocId "3454" .

<https://w3id.org/airo/incident/evidence/4dcfd00f98f6> a airo:Evidence ;
    airo:evidenceText "Madden said that \"given the crash dynamics and how the vehicle drove off the road with no evidence of a sudden maneuver, that fits with the driver-assistance feature\" being engaged." ;
    airo:sourceDocId "3450" .

<https://w3id.org/airo/incident/evidence/6c9972040719> a airo:Evidence ;
    airo:evidenceText "A report from Clear Creek County, who assisted on the call, notes that the passenger said the car was in its \"auto drive\" function." ;
    airo:sourceDocId "3453" .

<https://w3id.org/airo/incident/evidence/cf266af91db6> a airo:Evidence ;
    airo:evidenceText "The car's driver-assistance software, Full Self-Driving, was struggling to navigate the mountain curves, forcing von Ohain repeatedly to yank it back on course." ;
    airo:sourceDocId "3447" .

<https://w3id.org/airo/incident/evidence/e154557d6de8> a airo:Evidence ;
    airo:evidenceText "A Tesla employee and Elon Musk superfan may have become the first person to die in a crash caused by the company's self-driving tech, an investigation has claimed." ;
    airo:sourceDocId "3451" .

<https://w3id.org/airo/incident/evidence/f42eeaa61cf5> a airo:Evidence ;
    airo:evidenceText "Hans von Ohain, a Tesla recruiter, died in a car crash on a Colorado mountain road after his Tesla Model 3 veered off the road and barreled into a tree, bursting into flames, according to a new report from The Washington Post." ;
    airo:sourceDocId "3450" .

<https://w3id.org/airo/incident/evidence/10c0d94f4cf2> a airo:Evidence ;
    airo:evidenceText "Colorado State Patrol officers also looked into the vehicle's navigation systems." ;
    airo:sourceDocId "3451" .

<https://w3id.org/airo/incident/evidence/6918abbe8956> a airo:Evidence ;
    airo:evidenceText "While the National Highway Traffic Safety Administration is already investigating Autopilot following a series of accidents in which Teslas have smashed into emergency response vehicles that were pulled over with sirens or flares, no fatal crash has been definitively linked to FSD — though von Ohain's death, as WaPo reports, sure looks suspicious." ;
    airo:sourceDocId "3448" .

<https://w3id.org/airo/incident/evidence/8577dfdee385> a airo:Evidence ;
    airo:evidenceText "Still, an investigation by the Colorado State Patrol went beyond drunken driving, seeking to understand what role the Tesla software may have played in the crash." ;
    airo:sourceDocId "3447" .

<https://w3id.org/airo/incident/evidence/8b26d8215fd0> a airo:Evidence ;
    airo:evidenceText "After more than 8 months of investigating, the Colorado State Patrol has finished its investigation into a May 2022 Tesla crash and subsequent fire in Evergreen that killed one person." ;
    airo:sourceDocId "3452" .

<https://w3id.org/airo/incident/evidence/93dc10a2543e> a airo:Evidence ;
    airo:evidenceText "However, Tesla did report the crash to the National Highway Traffic Safety Administration." ;
    airo:sourceDocId "3447" .

<https://w3id.org/airo/incident/evidence/9f4e7056dc4b> a airo:Evidence ;
    airo:evidenceText "Ohain's widow, Nora Bass, whom the Post interviewed, seeks accountability from Tesla, questioning the \"false sense of security\" surrounding FSD." ;
    airo:sourceDocId "3457" .

<https://w3id.org/airo/incident/evidence/beafd5975bd4> a airo:Evidence ;
    airo:evidenceText "Von Ohain's widow Nora Bass wants Tesla to take responsibility for her husband's death:" ;
    airo:sourceDocId "3449" .

<https://w3id.org/airo/incident/evidence/cc212334908d> a airo:Evidence ;
    airo:evidenceText "Von Ohain's widow, Nora Bass, said she has been unable to find a lawyer willing to take his case to court because he was legally intoxicated." ;
    airo:sourceDocId "3447" .

<https://w3id.org/airo/incident/evidence/fce2a5d2e4f7> a airo:Evidence ;
    airo:evidenceText "Von Ohain's widow, Nora Bass, described her husband as a true believer in both Tesla and its CEO, Elon Musk, in a recent interview with The Washington Post.",
        "Von Ohain's widow, Nora Bass, described her husband as a true believer in both Tesla and its CEO, Elon Musk." ;
    airo:sourceDocId "3456" .

