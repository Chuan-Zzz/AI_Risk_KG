<https://w3id.org/airo/incident/evidence/01d50d2a6476> a airo:Evidence ;
    airo:evidenceText "AI-Powered News Site Accidentally Accuses District Attorney of Murder" ;
    airo:sourceDocId "3976" .

<https://w3id.org/airo/incident/evidence/16b73387e654> a airo:Evidence ;
    airo:evidenceText "an article appeared on Hoodline San Jose — one of the media network's many local news sites that span the US — earlier this month with a gruesome headline" ;
    airo:sourceDocId "3976" .

<https://w3id.org/airo/incident/evidence/19fa93d8d275> a airo:Evidence ;
    airo:evidenceText "claiming that the San Mateo County DA had been charged with murder!" ;
    airo:sourceDocId "3977" .

<https://w3id.org/airo/incident/evidence/2b89c73c444a> a airo:Evidence ;
    airo:evidenceText "A national network of local news sites is publishing AI-written articles under fake bylines. Experts are raising alarm" ;
    airo:sourceDocId "3770" .

<https://w3id.org/airo/incident/evidence/372ae9242a24> a airo:Evidence ;
    airo:evidenceText "AI-Powered News Site Accidentally Accuses District Attorney of Murder" ;
    airo:sourceDocId "6966" .

<https://w3id.org/airo/incident/evidence/3c7aea2ae334> a airo:Evidence ;
    airo:evidenceText "[6966] an article appeared on Hoodline San Jose — one of the media network's many local news sites that span the US — earlier this month with a gruesome headline." ;
    airo:sourceDocId "6966" .

<https://w3id.org/airo/incident/evidence/3cba9d1382df> a airo:Evidence ;
    airo:evidenceText "As Techdirt found, Hoodline's AI seems to have taken an X-formerly-Twitter post from the San Mateo DA office's official account... and garbled it so badly that it said the DA himself committed the grisly murder." ;
    airo:sourceDocId "6966" .

<https://w3id.org/airo/incident/evidence/43a7a6bd5f0b> a airo:Evidence ;
    airo:evidenceText "Hoodline's AI seems to have taken an X-formerly-Twitter post from the San Mateo DA office's official account... and garbled it so badly that it said the DA himself committed the grisly murder." ;
    airo:sourceDocId "6966" .

<https://w3id.org/airo/incident/evidence/470c5ab84a58> a airo:Evidence ;
    airo:evidenceText "[6966] Hoodline is openly using AI to find and cough up synthetic 'news.'" ;
    airo:sourceDocId "6966" .

<https://w3id.org/airo/incident/evidence/51e9c04a4433> a airo:Evidence ;
    airo:evidenceText "Hoodline's AI seems to have taken an X-formerly-Twitter post from the San Mateo DA office's official account... and garbled it so badly that it said the DA himself committed the grisly murder." ;
    airo:sourceDocId "6966" .

<https://w3id.org/airo/incident/evidence/9fb1059a3369> a airo:Evidence ;
    airo:evidenceText "An article appeared on Hoodline San Jose — one of the media network's many local news sites that span the US — earlier this month with a gruesome headline." ;
    airo:sourceDocId "6966" .

<https://w3id.org/airo/incident/evidence/c0874dd725ea> a airo:Evidence ;
    airo:evidenceText "[3770] The outlet, Hoodline, is not the first or only news site to harness AI." ;
    airo:sourceDocId "3770" .

<https://w3id.org/airo/incident/evidence/c1e979af288e> a airo:Evidence ;
    airo:evidenceText "he discovered the false AI accusation when the Hoodline piece cropped up in his Google News tab." ;
    airo:sourceDocId "3976" .

<https://w3id.org/airo/incident/evidence/d27844af2909> a airo:Evidence ;
    airo:evidenceText "The News/Media Alliance, which represents more than 2,200 US publishers, has supported news organizations taking legal action against AI developers who are harvesting news content without permission." ;
    airo:sourceDocId "3770" .

<https://w3id.org/airo/incident/evidence/d8277413a2c8> a airo:Evidence ;
    airo:evidenceText "AI Sludge Local News Site Hoodline Falsely Accuses San Mateo DA Of Murder" ;
    airo:sourceDocId "3977" .

<https://w3id.org/airo/incident/Risk/370575a91aa8> a airo:Risk ;
    rdfs:label "Risk of AI-generated misinformation masquerading as legitimate news" ;
    airo:confidenceScore "0.9"^^xsd:float ;
    airo:extractionMode "abstracted" ;
    airo:hasEvidence <https://w3id.org/airo/incident/evidence/6f9f78aa5698> ;
    airo:hasSourceDocument <https://w3id.org/airo/incident/document/6966> ;
