<https://w3id.org/airo/incident/evidence/3e41ea0ccd75> a airo:Evidence ;
    airo:evidenceText "claiming that the San Mateo County DA had been charged with murder!" ;
    airo:sourceDocId "3977" .

<https://w3id.org/airo/incident/evidence/6f9f78aa5698> a airo:Evidence ;
    airo:evidenceText "Hoodline, which is currently owned by a murky media outfit called Impress3, is openly using AI to find and cough up synthetic 'news.'" ;
    airo:sourceDocId "6966" .

<https://w3id.org/airo/incident/evidence/7d72b34abe8f> a airo:Evidence ;
    airo:evidenceText "a story caught my eye, claiming that the San Mateo County DA had been charged with murder!" ;
    airo:sourceDocId "3977" .

<https://w3id.org/airo/incident/AISystem/18e32bf2f2a3> a airo:AISystem ;
    rdfs:label "Google News" ;
    airo:confidenceScore "0.9"^^xsd:float ;
    airo:extractionMode "explicit" ;
    airo:hasDescription "Google News" ;
    airo:hasEvidence <https://w3id.org/airo/incident/evidence/c1e979af288e> ;
    airo:hasSourceDocument <https://w3id.org/airo/incident/document/3976> .

<https://w3id.org/airo/incident/evidence/19d52a1515cd> a airo:Evidence ;
    airo:evidenceText "Hoodline's AI seems to have taken an X-formerly-Twitter post from the San Mateo DA office's official account, in which the office shared a run-of-the-mill press release." ;
    airo:sourceDocId "6966" .

<https://w3id.org/airo/incident/evidence/1b52b0fe240a> a airo:Evidence ;
    airo:evidenceText "Hoodline, which is currently owned by a murky media outfit called Impress3, is openly using AI to find and cough up synthetic \"news\"" ;
    airo:sourceDocId "3976" .

<https://w3id.org/airo/incident/evidence/23d12816b6f9> a airo:Evidence ;
    airo:evidenceText "Tech outlet CNET's AI-generated articles made embarrassing factual errors." ;
    airo:sourceDocId "3770" .

<https://w3id.org/airo/incident/evidence/39620a189749> a airo:Evidence ;
    airo:evidenceText "The way the site uses and discloses AI purposely tricks readers by \"mimicking\" the look and feel of a \"standards-based local news organization with real journalists,\" said Peter Adams, a senior vice president of the News Literacy Project." ;
    airo:sourceDocId "3770" .

<https://w3id.org/airo/incident/evidence/51ec352f6477> a airo:Evidence ;
    airo:evidenceText "The article was attributed to the byline Eileen Vargas, one of the website's many fake, AI-generated reporter personas." ;
    airo:sourceDocId "3976" .

<https://w3id.org/airo/incident/evidence/5668442b6c6f> a airo:Evidence ;
    airo:evidenceText "Hoodline, which is currently owned by a murky media outfit called Impress3, is openly using AI to find and cough up synthetic 'news.'" ;
    airo:sourceDocId "6966" .

<https://w3id.org/airo/incident/evidence/5b56e8efeb67> a airo:Evidence ;
    airo:evidenceText "There might be some implications for Google — an AI company reportedly testing AI news products itself — as well." ;
    airo:sourceDocId "3976" .

<https://w3id.org/airo/incident/evidence/6473aae0e6cd> a airo:Evidence ;
    airo:evidenceText "As Techdirt found, Hoodline's AI seems to have taken an X-formerly-Twitter post from the San Mateo DA office's official account... and garbled it so badly that it said the DA himself committed the grisly murder." ;
    airo:sourceDocId "6966" .

<https://w3id.org/airo/incident/evidence/8d0fcfd53864> a airo:Evidence ;
    airo:evidenceText "The nation's largest newspaper chain owner, Gannett, pulled back on an AI experiment reporting on high school sports games after public mockery." ;
    airo:sourceDocId "3770" .

<https://w3id.org/airo/incident/evidence/a6b854129616> a airo:Evidence ;
    airo:evidenceText "Hoodline, founded in 2014 as a San Francisco-based hyper-local news outlet...once employed a newsroom full of human journalists." ;
    airo:sourceDocId "3770" .

<https://w3id.org/airo/incident/evidence/ab27b61899e7> a airo:Evidence ;
    airo:evidenceText "said Peter Adams, a senior vice president of the News Literacy Project, which aims to educate the public on identifying credible information." ;
    airo:sourceDocId "3770" .

<https://w3id.org/airo/incident/evidence/af6150d12280> a airo:Evidence ;
    airo:evidenceText "As Techdirt first reported, an article appeared on Hoodline San Jose." ;
    airo:sourceDocId "6966" .

<https://w3id.org/airo/incident/evidence/be5e74868c36> a airo:Evidence ;
    airo:evidenceText "Screenshots captured last year by the Internet Archive and local outlet Gazetteer showed Hoodline had further embellished its AI author bylines with what appeared to be AI-generated headshots resembling real people and fake biographical information." ;
    airo:sourceDocId "3770" .

<https://w3id.org/airo/incident/evidence/c545b985b4e8> a airo:Evidence ;
    airo:evidenceText "Gazetteer previously reported that at least two Hoodline employees said on LinkedIn that they were based in the Philippines, far from the US cities that the outlet purports to cover." ;
    airo:sourceDocId "3770" .

<https://w3id.org/airo/incident/evidence/c5a2f1a5d8b2> a airo:Evidence ;
    airo:evidenceText "There might be some implications for Google — an AI company reportedly testing AI news products itself — as well." ;
    airo:sourceDocId "6966" .

<https://w3id.org/airo/incident/evidence/cfdcceb92852> a airo:Evidence ;
    airo:evidenceText "a few days ago, I was reading the news recommended by Google News, and a story caught my eye, claiming that the San Mateo County DA had been charged with murder!" ;
    airo:sourceDocId "3977" .

<https://w3id.org/airo/incident/evidence/e4ceb6672ef7> a airo:Evidence ;
    airo:evidenceText "The News/Media Alliance, which represents more than 2,200 US publishers, has supported news organizations taking legal action against AI developers who are harvesting news content without permission." ;
    airo:sourceDocId "3770" .

<https://w3id.org/airo/incident/evidence/f0d76709a4f4> a airo:Evidence ;
    airo:evidenceText "Sports Illustrated deleted several articles from its website after they were found to have been published under fake author names." ;
    airo:sourceDocId "3770" .

<https://w3id.org/airo/incident/evidence/ed3f46e2eb76> a airo:Evidence ;
    airo:evidenceText "Hoodline's AI seems to have taken an X-formerly-Twitter post from the San Mateo DA office's official account",
        "Hoodline's AI seems to have taken an X-formerly-Twitter post from the San Mateo DA office's official account, in which the office shared a run-of-the-mill press release about a local man" ;
    airo:sourceDocId "3976" .

<https://w3id.org/airo/incident/evidence/b0319d7ca5a2> a airo:Evidence ;
    airo:evidenceText "a nonsense peddling AI sludge factory called “Hoodline” run by a company called Impress3." ;
    airo:sourceDocId "3977" .

<https://w3id.org/airo/incident/evidence/471d1d103e03> a airo:Evidence ;
    airo:evidenceText "Danielle Coffey, the group's chief executive, told CNN that Hoodline's content \"is likely a violation of copyright law.\"" ;
    airo:sourceDocId "3770" .

<https://w3id.org/airo/incident/evidence/61a633ed492e> a airo:Evidence ;
    airo:evidenceText "said Felix Simon, a research fellow in AI and digital news at the Reuters Institute for the Study of Journalism at the University of Oxford." ;
    airo:sourceDocId "3770" .

<https://w3id.org/airo/incident/evidence/896589baeeba> a airo:Evidence ;
    airo:evidenceText "According to an official X account from the San Mateo County District Attorney’s Office, Thompson was apprehended after a collaborative investigation by the DA’s Office and the East Palo Alto Police Department, which initially began as a search for a missing person." ;
    airo:sourceDocId "3977" .

<https://w3id.org/airo/incident/evidence/b284bcc3a142> a airo:Evidence ;
    airo:evidenceText "Nuala Bishari, a former Hoodline reporter, wrote in a recent column for the San Francisco Chronicle that seeing her old job replaced by AI is \"surreal.\"" ;
    airo:sourceDocId "3770" .

<https://w3id.org/airo/incident/evidence/eccb500c9552> a airo:Evidence ;
    airo:evidenceText "Wayback Machine director Mark Graham told CNN that archived pages of Hoodline's AI writers were removed last month \"at the request of the rights holder of the site.\"" ;
    airo:sourceDocId "3770" .

<https://w3id.org/airo/incident/evidence/f1900ec5061e> a airo:Evidence ;
    airo:evidenceText "Some news organizations, like News Corp., are increasingly inking lucrative partnerships with AI developers like OpenAI to help bolster its large language models' knowledge base." ;
    airo:sourceDocId "3770" .

<https://w3id.org/airo/incident/evidence/86d5025099fb> a airo:Evidence ;
    airo:evidenceText "Zachary Chen, chief executive of Hoodline parent company Impress3, which acquired the site in 2020, defended the site's use of AI and its transparency with readers, telling CNN the outlet provides valuable reporting.",
        "Zachary Chen, chief executive of Hoodline parent company Impress3, which acquired the site in 2020, defended the site's use of AI and its transparency with readers." ;
    airo:sourceDocId "3770" .

