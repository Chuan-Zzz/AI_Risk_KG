<https://w3id.org/airo/incident/evidence/1610e634723a> a airo:Evidence ;
    airo:evidenceText "WeChat Apologizes for Translating ‘Black Foreigner’ as N-Word" ;
    airo:sourceDocId "1534" .

<https://w3id.org/airo/incident/evidence/16c021f2b128> a airo:Evidence ;
    airo:evidenceText "Recognizing patterns is the core of language AI." ;
    airo:sourceDocId "1734" .

<https://w3id.org/airo/incident/evidence/254531707aa5> a airo:Evidence ;
    airo:evidenceText "It was spotted by Ann James, a black American living in Shanghai, when she texted her Chinese colleagues to say she was running late." ;
