<https://w3id.org/airo/incident/NewsReport/1766> a airo:NewsReport ;
    rdfs:label "British police defend their new criminal facial recognition technology – even though it's failing at a rate of 92%" ;
    airo:confidenceScore "0.9"^^xsd:float ;
