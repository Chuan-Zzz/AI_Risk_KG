    airo:evidenceText "[1588] When resident physicians at Stanford Medical Center—many of whom work on the front lines of the covid-19 pandemic—found out that only seven out of over 1,300 of them had been prioritized for the first 5,000 doses of the covid vaccine, they were shocked." ;
    airo:sourceDocId "1588" .

<https://w3id.org/airo/incident/evidence/a9698319959e> a airo:Evidence ;
    airo:evidenceText "He added that with the anticipated authorization of Moderna's vaccine, \"we're increasingly confident in getting everyone vaccinated, including all of you.\"" ;
    airo:sourceDocId "1205" .

<https://w3id.org/airo/incident/evidence/b809ba15380d> a airo:Evidence ;
    airo:evidenceText "[1205] An algorithm chose who would be the first 5,000 in line." ;
    airo:sourceDocId "1205" .

<https://w3id.org/airo/incident/evidence/c805948af22e> a airo:Evidence ;
    airo:evidenceText "Jeffrey Kahn, the director of the Johns Hopkins Berkman Institute of Bioethics, says the approach was overcomplicated." ;
    airo:sourceDocId "1588" .

<https://w3id.org/airo/incident/evidence/cd0fe45a1d49> a airo:Evidence ;
    airo:evidenceText "This is the Stanford vaccine algorithm that left out frontline doctors" ;
    airo:sourceDocId "1588" .

<https://w3id.org/airo/incident/evidence/dc9222e89e35> a airo:Evidence ;
    airo:evidenceText "Stanford algorithm decided to vaccinate only seven of its frontline COVID-19 workers, out of 5,000 doses" ;
    airo:sourceDocId "1530" .

<https://w3id.org/airo/incident/evidence/e73874aa429c> a airo:Evidence ;
    airo:evidenceText "Frontline workers protest at Stanford after hospital distributed vaccine to administrators" ;
    airo:sourceDocId "1204" .

<https://w3id.org/airo/incident/Risk/cfb7f3946724> a airo:Risk ;
    rdfs:label "risk of inequitable allocation of scarce medical resources" ;
    airo:confidenceScore "0.95"^^xsd:float ;
