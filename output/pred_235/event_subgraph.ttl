<https://w3id.org/airo/incident/Stakeholder/c0abdd012a11> a airo:Stakeholder ;
    rdfs:label "Stanford Medicine" ;
    airo:confidenceScore "0.95"^^xsd:float ;
    airo:deploys <https://w3id.org/airo/incident/AISystem/850896e0a611>,
        <https://w3id.org/airo/incident/AISystem/cfc893cb06ae>,
        <https://w3id.org/airo/incident/AISystem/dd5b724f4faf>,
        <https://w3id.org/airo/incident/AISystem/f6e8800b36c8> ;
    airo:develops <https://w3id.org/airo/incident/AISystem/850896e0a611>,
        <https://w3id.org/airo/incident/AISystem/cfc893cb06ae>,
        <https://w3id.org/airo/incident/AISystem/dd5b724f4faf>,
        <https://w3id.org/airo/incident/AISystem/f6e8800b36c8> ;
    airo:extractionMode "explicit" ;
    airo:hasDescription "Stanford Medicine" ;
    airo:hasEvidence <https://w3id.org/airo/incident/evidence/9a09d8361448>,
        <https://w3id.org/airo/incident/evidence/cb53a56ccc6a>,
        <https://w3id.org/airo/incident/evidence/d9e02a4d62f2> ;
    airo:hasSourceDocument <https://w3id.org/airo/incident/document/1205>,
        <https://w3id.org/airo/incident/document/1530> ;
    airo:hasSupportCount 2 .

<https://w3id.org/airo/incident/evidence/0a23b4adc159> a airo:Evidence ;
    airo:evidenceText "An algorithm determining which Stanford Medicine employees would receive its 5,000 initial doses of the COVID-19 vaccine included just seven medical residents / fellows on the list." ;
    airo:sourceDocId "1530" .

<https://w3id.org/airo/incident/evidence/36df3a966c11> a airo:Evidence ;
    airo:evidenceText "When resident physicians at Stanford Medical Center—many of whom work on the front lines of the covid-19 pandemic—found out that only seven out of over 1,300 of them had been prioritized for the first 5,000 doses of the covid vaccine, they were shocked." ;
    airo:sourceDocId "1588" .

<https://w3id.org/airo/incident/evidence/615362d9ab0f> a airo:Evidence ;
    airo:evidenceText "In response to the residents' protests, Dr. Niraj Sehgal, chief medical officer, sent an email saying, \"Please know that the perceived lack of priority for residents and fellows was not the intent at all.\"" ;
    airo:sourceDocId "1205" .

<https://w3id.org/airo/incident/evidence/153b66910473> a airo:Evidence ;
    airo:evidenceText "“1 of the core attractions of algorithms is that they allow the powerful to blame a black box for politically unattractive outcomes for which they would otherwise be responsible,” Roger McNamee, a prominent Silicon Valley insider turned critic, wrote on Twitter." ;
    airo:sourceDocId "1588" .

<https://w3id.org/airo/incident/evidence/2072ce140724> a airo:Evidence ;
    airo:evidenceText "When resident physicians at Stanford Medical Center—many of whom work on the front lines of the covid-19 pandemic—found out that only seven out of over 1,300 of them had been prioritized for the first 5,000 doses of the covid vaccine, they were shocked." ;
    airo:sourceDocId "1588" .

<https://w3id.org/airo/incident/evidence/363dec8bec53> a airo:Evidence ;
    airo:evidenceText "Dr. Mary Hawn, chair of the department of surgery, confessed to being \"disturbed and puzzled\" by the vaccination roster that \"included many of the medical staff list that aren't our physicians on the front line.\"" ;
    airo:sourceDocId "1205" .

<https://w3id.org/airo/incident/evidence/3abc1b7c4d68> a airo:Evidence ;
    airo:evidenceText "“But *people* decided who would get the vaccine,” tweeted Veena Dubal, a professor of law at the University of California, Hastings, who researches technology and society." ;
    airo:sourceDocId "1588" .

<https://w3id.org/airo/incident/evidence/480e4087b028> a airo:Evidence ;
    airo:evidenceText "In response to the residents' protests, Dr. Niraj Sehgal, chief medical officer, sent an email saying, \"Please know that the perceived lack of priority for residents and fellows was not the intent at all.\"" ;
    airo:sourceDocId "1205" .

<https://w3id.org/airo/incident/evidence/4b80ae9b2194> a airo:Evidence ;
    airo:evidenceText "And, as first reported by ProPublica, residents were told that because they rotate between departments rather than maintain a single assignment, they lost out on points associated with the departments where they worked." ;
    airo:sourceDocId "1588" .

<https://w3id.org/airo/incident/evidence/57269c331d75> a airo:Evidence ;
    airo:evidenceText "Irene Chen, an MIT doctoral candidate who studies the use of fair algorithms in health care, suspects this is what happened at Stanford: the formula’s designers chose variables that they believed would serve as good proxies for a given staffer’s level of covid risk." ;
    airo:sourceDocId "1588" .

<https://w3id.org/airo/incident/evidence/74ccdc1e2e19> a airo:Evidence ;
    airo:evidenceText "Elsewhere, the University of California San Francisco’s plan is based on a similar assessment of risk of exposure to the virus." ;
    airo:sourceDocId "1588" .

<https://w3id.org/airo/incident/evidence/7cad1d987c86> a airo:Evidence ;
    airo:evidenceText "Kahn, who sat on Johns Hopkins’ 20-member committee on vaccine allocation, says his university allocated vaccines based simply on job and risk of exposure to covid-19." ;
    airo:sourceDocId "1588" .

<https://w3id.org/airo/incident/evidence/987ee4c75cc7> a airo:Evidence ;
    airo:evidenceText "“Our algorithm, that the ethicists, infectious disease experts worked on for weeks … clearly didn’t work right,” Tim Morrison, the director of the ambulatory care team, told residents at the event in a video posted online." ;
    airo:sourceDocId "1588" .

<https://w3id.org/airo/incident/evidence/9d4800e592f2> a airo:Evidence ;
    airo:evidenceText "said Dr. Sarah Johnson, a third-year OB-GYN resident who has delivered babies from COVID-positive patients during the pandemic." ;
    airo:sourceDocId "1205" .

<https://w3id.org/airo/incident/evidence/eef728b69409> a airo:Evidence ;
    airo:evidenceText "\"We take complete responsibility for the errors in the execution of our vaccine distribution plan,\" said Lisa Kim, a Stanford Medicine spokesperson." ;
    airo:sourceDocId "1205" .

<https://w3id.org/airo/incident/evidence/f6cc02da42db> a airo:Evidence ;
    airo:evidenceText "Jeffrey Kahn, the director of the Johns Hopkins Berkman Institute of Bioethics, says the approach was overcomplicated." ;
    airo:sourceDocId "1588" .

