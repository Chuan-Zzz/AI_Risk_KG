<https://w3id.org/airo/incident/Standard/4afaf4aa0ab2> a airo:Standard ;
    rdfs:label "OpenAI Preparedness Framework" ;
    airo:confidenceScore "0.7"^^xsd:float ;
    airo:extractionMode "explicit" ;
    airo:hasDescription "Preparedness Framework" ;
    airo:hasEvidence <https://w3id.org/airo/incident/evidence/e4fba0e89c5c> ;
    airo:hasSourceDocument <https://w3id.org/airo/incident/document/3355> .

<https://w3id.org/airo/incident/evidence/03c9cf79c0a9> a airo:Evidence ;
    airo:evidenceText "In a statement, LAION said it has removed the data sets out of \"an abundance of caution,\" including both LAION-5B and its LAION-400M, \"to ensure they are safe before republishing them.\"" ;
    airo:sourceDocId "3343" .

<https://w3id.org/airo/incident/evidence/04f9e897eba8> a airo:Evidence ;
    airo:evidenceText "Stable Diffusion 1.5 Was Trained On Illegal Child Sexual Abuse Material, Stanford Study Says" ;
    airo:sourceDocId "3352" .

<https://w3id.org/airo/incident/evidence/05aa034dcd24> a airo:Evidence ;
    airo:evidenceText "The toolkits to download, set up, use, and fine-tune a variety of models have been turned into one-click frameworks for anyone with a laptop to use." ;
    airo:sourceDocId "3351" .

<https://w3id.org/airo/incident/evidence/083914311ef7> a airo:Evidence ;
    airo:evidenceText "Stable Diffusion, for example, uses LAION-5B, and Stability AI funded its development." ;
    airo:sourceDocId "3346" .

<https://w3id.org/airo/incident/evidence/08902ee232c8> a airo:Evidence ;
    airo:evidenceText "Child abuse images removed from AI image-generator training source, researchers say" ;
    airo:sourceDocId "3875" .

<https://w3id.org/airo/incident/evidence/0d1c274843d4> a airo:Evidence ;
    airo:evidenceText "\"LAION-5B is a dataset that contains 5.8 billion text and image pairs, which...includes the entirety of my work and the work of almost everyone I know,\" she said." ;
    airo:sourceDocId "3349" .

<https://w3id.org/airo/incident/evidence/13a26df07b92> a airo:Evidence ;
    airo:evidenceText "[3345] In a study published today, the Stanford Internet Observatory (SIO) said it pored over more than 32 million data points in the LAION-5B dataset and was able to validate, using the Microsoft-developed tool PhotoDNA, 1,008 CSAM images -- some included multiple times." ;
    airo:sourceDocId "3345" .

<https://w3id.org/airo/incident/evidence/162f36fa2308> a airo:Evidence ;
    airo:evidenceText "PhotoDNA is a technology that creates unique hashes for images of child exploitation in order to find those images elsewhere on the web and get them removed or pursue abusers or proliferators." ;
    airo:sourceDocId "3346" .

<https://w3id.org/airo/incident/evidence/16a6e34c8db0> a airo:Evidence ;
    airo:evidenceText "Many of those images were confirmed as CSAM by third parties such as PhotoDNA and the Canadian Centre for Child Protection." ;
    airo:sourceDocId "3354" .

<https://w3id.org/airo/incident/evidence/1e13d384dc1a> a airo:Evidence ;
    airo:evidenceText "AI Training Data Contains Child Sexual Abuse Images, Discovery Points to LAION-5B" ;
    airo:sourceDocId "3355" .

<https://w3id.org/airo/incident/evidence/1ee87c834882> a airo:Evidence ;
    airo:evidenceText "[3354] According to their paper, they employed 'perceptual hash‐based detection, cryptographic hash‐based detection, and nearest‐neighbors analysis leveraging the image embeddings in the dataset itself.'" ;
    airo:sourceDocId "3354" .

<https://w3id.org/airo/incident/evidence/222b1c2e422b> a airo:Evidence ;
    airo:evidenceText "AI image training dataset found to include child sexual abuse imagery" ;
    airo:sourceDocId "3341" .

<https://w3id.org/airo/incident/evidence/2b04ac9b4f88> a airo:Evidence ;
    airo:evidenceText "[3875] The alleged distribution of child sexual abuse images on the messaging app Telegram is part of what led French authorities to bring charges on Wednesday against the platform's founder and CEO, Pavel Durov." ;
    airo:sourceDocId "3875" .

<https://w3id.org/airo/incident/evidence/2b6b0cd06f1d> a airo:Evidence ;
    airo:evidenceText "Investigation Finds AI Image Generation Models Trained on Child Abuse" ;
    airo:sourceDocId "3324" .

<https://w3id.org/airo/incident/evidence/2e338b669c0d> a airo:Evidence ;
    airo:evidenceText "The integrity of a major AI image training dataset, LAION-5B, utilized by influential AI models like Stable Diffusion, has been compromised after the discovery of thousands of links to Child Sexual Abuse Material (CSAM)." ;
    airo:sourceDocId "3353" .

<https://w3id.org/airo/incident/evidence/2f957aea6473> a airo:Evidence ;
    airo:evidenceText "[3875] 1 of the LAION-based tools that Stanford identified as the 'most popular model for generating explicit imagery' --- an older and lightly filtered version of Stable Diffusion --- remained easily accessible until Thursday, when the New York-based company Runway ML removed it from the AI model repository Hugging Face." ;
    airo:sourceDocId "3875" .

<https://w3id.org/airo/incident/evidence/317e72c98af0> a airo:Evidence ;
    airo:evidenceText "[3352] Stable Diffusion, one of the most popular text-to-image generative AI tools on the market from the $1 billion startup Stability AI, was trained on a trove of illegal child sexual abuse material, according to new research from the Stanford Internet Observatory." ;
    airo:sourceDocId "3352" .

<https://w3id.org/airo/incident/evidence/375a8b4b0063> a airo:Evidence ;
    airo:evidenceText "In some cases, bad actors were making their own custom versions of these models (a process known as fine-tuning) with real child sexual abuse material to generate bespoke images of specific victims." ;
    airo:sourceDocId "3874" .

<https://w3id.org/airo/incident/evidence/3bea3c5544dc> a airo:Evidence ;
    airo:evidenceText "LAION-5B has been used to train numerous AI applications, including the popular Stable Diffusion image generation app created by Stability AI." ;
    airo:sourceDocId "3347" .

<https://w3id.org/airo/incident/evidence/4212afe76472> a airo:Evidence ;
    airo:evidenceText "Many of the most popular downloadable open-source AI image generators, including the popular Stable Diffusion version 1.5 model, were trained using this data." ;
    airo:sourceDocId "3874" .

<https://w3id.org/airo/incident/evidence/470ffb0a8c8a> a airo:Evidence ;
    airo:evidenceText "In response, LAION told 404 Media on Tuesday that out of \"an abundance of caution,\" it was taking down its datasets temporarily \"to ensure they are safe before republishing them.\"" ;
    airo:sourceDocId "3349" .

<https://w3id.org/airo/incident/evidence/49252d5f8b0a> a airo:Evidence ;
    airo:evidenceText "The report urged stronger regulatory oversight of generative AI models." ;
    airo:sourceDocId "3874" .

<https://w3id.org/airo/incident/evidence/4d20ac02840e> a airo:Evidence ;
    airo:evidenceText "A free AI image dataset, removed for child sex abuse images, has come under fire before" ;
    airo:sourceDocId "3349" .

<https://w3id.org/airo/incident/evidence/4f3519152717> a airo:Evidence ;
    airo:evidenceText "The study was primarily conducted using hashing tools such as PhotoDNA, which match a fingerprint of an image to databases maintained by nonprofits that receive and process reports of online child sexual exploitation and abuse." ;
    airo:sourceDocId "3324" .

<https://w3id.org/airo/incident/evidence/50748ec5933d> a airo:Evidence ;
    airo:evidenceText "[3352] Stable Diffusion, one of the most popular text-to-image generative AI tools on the market from the $1 billion startup Stability AI, was trained on a trove of illegal child sexual abuse material" ;
    airo:sourceDocId "3352" .

<https://w3id.org/airo/incident/evidence/53a893531806> a airo:Evidence ;
    airo:evidenceText "With the goal of quantifying the degree to which CSAM is present in the training dataset as well as eliminating it from both LAION‐5B and derivative datasets, we use various complementary techniques to identify potential CSAM in the dataset: perceptual hash‐based detection, cryptographic hash‐based detection, and nearest‐neighbors analysis leveraging the image embeddings in the dataset itself." ;
    airo:sourceDocId "3346" .

<https://w3id.org/airo/incident/evidence/564e48ec9fb6> a airo:Evidence ;
    airo:evidenceText "Largest Dataset Powering AI Images Removed After Discovery of Child Sexual Abuse Material" ;
    airo:sourceDocId "3346" .

<https://w3id.org/airo/incident/evidence/5d4750085a7d> a airo:Evidence ;
    airo:evidenceText "The latest generative AI models are called \"diffusion models,\" born from academic research at the University of California, Berkeley and Stanford University." ;
    airo:sourceDocId "3351" .

<https://w3id.org/airo/incident/evidence/5ea3bd8d7d59> a airo:Evidence ;
    airo:evidenceText "LAION and the Challenges of Preventing AI-Generated CSAM" ;
    airo:sourceDocId "3351" .

<https://w3id.org/airo/incident/evidence/6e8db9a67b22> a airo:Evidence ;
    airo:evidenceText "However, it's claimed that Stable Diffusion 1.5, which is still available on the internet, does not have the same protections." ;
    airo:sourceDocId "3354" .

<https://w3id.org/airo/incident/evidence/7977409f67c0> a airo:Evidence ;
    airo:evidenceText "The Stanford Internet Observatory (SIO) released a report identifying Child Sexual Abuse Material (CSAM) in the Large-scale Artificial Intelligence Open Network's (LAION) LAION-5B, a popular AI image training database." ;
    airo:sourceDocId "3351" .

<https://w3id.org/airo/incident/evidence/7e81029df9a1> a airo:Evidence ;
    airo:evidenceText "In this changing environment, law enforcement is scrambling to keep up---both in the United States and around the globe." ;
    airo:sourceDocId "3351" .

<https://w3id.org/airo/incident/evidence/878d161d6a5b> a airo:Evidence ;
    airo:evidenceText "The report shows that AI models such as Stable Diffusion and Google's Imagen \"were trained on billions of scraped images in the LAION-5B dataset.\"" ;
    airo:sourceDocId "3348" .

<https://w3id.org/airo/incident/evidence/8c66ee090ca2> a airo:Evidence ;
    airo:evidenceText "Large AI training data set removed after study finds child abuse material" ;
    airo:sourceDocId "3343" .

<https://w3id.org/airo/incident/evidence/8e72a3e8b224> a airo:Evidence ;
    airo:evidenceText "Following a report from researchers at Stanford University, 404 Media reported that LAION confirmed the presence of child sexual abuse material (CSAM) in the dataset..." ;
    airo:sourceDocId "3350" .

<https://w3id.org/airo/incident/evidence/9045606953ff> a airo:Evidence ;
    airo:evidenceText "Major Error Found in Stable Diffusion’s Biggest Training Dataset" ;
    airo:sourceDocId "3353" .

<https://w3id.org/airo/incident/evidence/90dc065c8629> a airo:Evidence ;
    airo:evidenceText "The report warned that CSAM material in the dataset could enable AI products built on this data to output new and potentially realistic child abuse content." ;
    airo:sourceDocId "3349" .

<https://w3id.org/airo/incident/evidence/9248e95d0fda> a airo:Evidence ;
    airo:evidenceText "An Influential AI Dataset Contains Thousands of Suspected Child Sexual Abuse Images" ;
    airo:sourceDocId "3347" .

<https://w3id.org/airo/incident/evidence/93bc29b3baff> a airo:Evidence ;
    airo:evidenceText "A Dec. 20 report from researchers at the Stanford Internet Observatory's Cyber Policy Center said they identified 3,226 instances of suspected CSAM --- or child sexual abuse material --- in the LAION-5B data set, \"much of which was confirmed as CSAM by third parties,\" according to Stanford Cyber Policy Center's Big Data Architect and Chief Technologist David Thiel." ;
    airo:sourceDocId "3343" .

<https://w3id.org/airo/incident/evidence/94425638acc3> a airo:Evidence ;
    airo:evidenceText "Most institutions in the US, including Thiel's team, aren't legally allowed to view CSAM in order to verify it themselves. To do CSAM research, experts often rely on perceptual hashing, which extracts a unique digital signature, or fingerprint, from an image or video." ;
    airo:sourceDocId "3346" .

<https://w3id.org/airo/incident/evidence/9d875ed51431> a airo:Evidence ;
    airo:evidenceText "[3355] A new report from the Stanford Internet Observatory (SIO) and its researcher David Thiel uncovered an alarming case of AI training data that contained more than 1,000 child sexual abuse materials (CSAM)." ;
    airo:sourceDocId "3355" .

<https://w3id.org/airo/incident/evidence/b5df9ba96f65> a airo:Evidence ;
    airo:evidenceText "The report, put together by Stanford University’s Internet Observatory, says that LAION-5B, a massive tranche of visual media, includes a significant number of illegal abuse images." ;
    airo:sourceDocId "3347" .

<https://w3id.org/airo/incident/evidence/b691ec426506> a airo:Evidence ;
    airo:evidenceText "Researchers found child abuse material in the largest AI image generation dataset" ;
    airo:sourceDocId "3354" .

<https://w3id.org/airo/incident/evidence/bc5ed728370c> a airo:Evidence ;
    airo:evidenceText "The repercussions extended to other models, such as Google's Imagen, which found inappropriate content in LAION's datasets during an audit." ;
    airo:sourceDocId "3353" .

<https://w3id.org/airo/incident/evidence/c2da8e7e5cf6> a airo:Evidence ;
    airo:evidenceText "[3875] 1 of the LAION-based tools that Stanford identified as the 'most popular model for generating explicit imagery' --- an older and lightly filtered version of Stable Diffusion --- remained easily accessible until Thursday, when the New York-based company Runway ML removed it from the AI model repository Hugging Face." ;
    airo:sourceDocId "3875" .

<https://w3id.org/airo/incident/evidence/c534c71290c2> a airo:Evidence ;
    airo:evidenceText "Study uncovers presence of CSAM in popular AI training dataset" ;
    airo:sourceDocId "3345" .

<https://w3id.org/airo/incident/evidence/c7ad8d79e644> a airo:Evidence ;
    airo:evidenceText "Abuse material found in openly accessible data set" ;
    airo:sourceDocId "3348" .

<https://w3id.org/airo/incident/evidence/cc932f872813> a airo:Evidence ;
    airo:evidenceText "They looked through hashes or the image’s identifiers. These were sent to CSAM detection platforms like PhotoDNA and verified by the Canadian Centre for Child Protection." ;
    airo:sourceDocId "3341" .

<https://w3id.org/airo/incident/evidence/ce189cddbed0> a airo:Evidence ;
    airo:evidenceText "[3341] LAION-5B, a dataset used by Stable Diffusion creator Stability AI, included at least 1,679 illegal images scraped from social media posts and popular adult websites." ;
    airo:sourceDocId "3341" .

<https://w3id.org/airo/incident/evidence/d1b9a7173587> a airo:Evidence ;
    airo:evidenceText "[3875] The alleged distribution of child sexual abuse images on the messaging app Telegram is part of what led French authorities to bring charges on Wednesday against the platform's founder and CEO, Pavel Durov." ;
    airo:sourceDocId "3875" .

<https://w3id.org/airo/incident/evidence/d49b5e5bb529> a airo:Evidence ;
    airo:evidenceText "[3349] Ortiz, an award-winning artist... spoke at a virtual FTC panel in October and discussed the LAION-5B dataset." ;
    airo:sourceDocId "3349" .

<https://w3id.org/airo/incident/evidence/dd1c6033dfeb> a airo:Evidence ;
    airo:evidenceText "Google's Imagen was trained on a different but related dataset called LAION‐400M, but after developers found troubling imagery and stereotypes in the data, they \"deemed it unfit for public use,\" the report says." ;
    airo:sourceDocId "3352" .

<https://w3id.org/airo/incident/evidence/ddf308392e71> a airo:Evidence ;
    airo:evidenceText "8 months later, LAION said in a blog post that it worked with the Stanford University watchdog group and anti-abuse organizations in Canada and the United Kingdom to fix the problem and release a cleaned-up dataset for future AI research." ;
    airo:sourceDocId "3875" .

<https://w3id.org/airo/incident/evidence/e3dfe0f75129> a airo:Evidence ;
    airo:evidenceText "Stability AI founder Emad Mostaque trained Stable Diffusion using a subset of LAION-5B data." ;
    airo:sourceDocId "3354" .

<https://w3id.org/airo/incident/evidence/e94bf9baa65c> a airo:Evidence ;
    airo:evidenceText "[3345] In a study published today, the Stanford Internet Observatory (SIO) said it pored over more than 32 million data points in the LAION-5B dataset and was able to validate... 1,008 CSAM images" ;
    airo:sourceDocId "3345" .

<https://w3id.org/airo/incident/evidence/ec3f7689ae05> a airo:Evidence ;
    airo:evidenceText "A widely-used artificial intelligence data set used to train Stable Diffusion, Imagen and other AI image generator models has been removed by its creator after a study found it contained thousands of instances of suspected child sexual abuse material." ;
    airo:sourceDocId "3343" .

<https://w3id.org/airo/incident/evidence/ef49b536bb53> a airo:Evidence ;
    airo:evidenceText "Was an AI Image Generator Taken Down for Making Child Porn?" ;
    airo:sourceDocId "3874" .

<https://w3id.org/airo/incident/evidence/f4d7741c34bf> a airo:Evidence ;
    airo:evidenceText "Child Sex Abuse Material Was Found In a Major AI Dataset. Researchers Aren’t Surprised." ;
    airo:sourceDocId "3350" .

<https://w3id.org/airo/incident/Risk/541cd8f34c19> a airo:Risk ;
    rdfs:label "Risk of AI models generating or enabling production of child sexual abuse material" ;
    airo:confidenceScore "0.95"^^xsd:float ;
