<https://w3id.org/airo/incident/Stakeholder/f39846ebe8fa> a airo:Stakeholder ;
    rdfs:label "Lindsey Chiswick" ;
    airo:confidenceScore "0.9"^^xsd:float ;
    airo:extractionMode "explicit" ;
    airo:hasDescription "Lindsey Chiswick" ;
    airo:hasEvidence <https://w3id.org/airo/incident/evidence/d176dc21dd2d> ;
    airo:hasSourceDocument <https://w3id.org/airo/incident/document/3677> .

<https://w3id.org/airo/incident/evidence/11cc860ff48c> a airo:Evidence ;
    airo:evidenceText "[5938] However, just as in the case of Facewatch, the Met's software, provided by NEC, is not infallible either." ;
    airo:sourceDocId "5938" .

<https://w3id.org/airo/incident/evidence/19e8644b3934> a airo:Evidence ;
    airo:evidenceText "This can then be quickly compared to large databases to try to find a match from faces that have already been mapped." ;
    airo:sourceDocId "5938" .

<https://w3id.org/airo/incident/evidence/1ab4f0eeae7e> a airo:Evidence ;
    airo:evidenceText "Innocent woman branded a thief by AI facial recognition software" ;
    airo:sourceDocId "5938" .

<https://w3id.org/airo/incident/evidence/20de9b83db7b> a airo:Evidence ;
    airo:evidenceText "Facewatch is used in numerous stores in the UK - including Budgens, Sports Direct and Costcutter - to identify shoplifters." ;
    airo:sourceDocId "3676" .

<https://w3id.org/airo/incident/evidence/2fcc4109278b> a airo:Evidence ;
    airo:evidenceText "'I was misidentified as shoplifter by facial recognition tech'" ;
    airo:sourceDocId "3676" .

<https://w3id.org/airo/incident/evidence/30c6a2592c8c> a airo:Evidence ;
    airo:evidenceText "[5839] Facewatch later wrote to Sara and acknowledged it had made an error." ;
    airo:sourceDocId "5839" .

<https://w3id.org/airo/incident/evidence/3d1b2c189cc3> a airo:Evidence ;
    airo:evidenceText "Innocent woman branded a shoplifter by facial recognition software" ;
    airo:sourceDocId "3677" .

<https://w3id.org/airo/incident/evidence/42c3b1dcb2d2> a airo:Evidence ;
    airo:evidenceText "It then maps the face, such as measuring the distance between certain features, to create a ‘numerical expression’ for an individual." ;
    airo:sourceDocId "5938" .

<https://w3id.org/airo/incident/evidence/4b63d111e05e> a airo:Evidence ;
    airo:evidenceText "[3677] Shaun Thompson, who works for the youth-advocacy group Street Fathers, said that he was incorrectly identified by police using a facial recognition system near London Bridge." ;
    airo:sourceDocId "3677" .

<https://w3id.org/airo/incident/evidence/5d8e6e180163> a airo:Evidence ;
    airo:evidenceText "That is the exact scenario one woman found herself in due to a mistake made by facial recognition software in a Home Bargains store." ;
    airo:sourceDocId "5938" .

<https://w3id.org/airo/incident/evidence/64386515d56a> a airo:Evidence ;
    airo:evidenceText "On a humid day in Bethnal Green, in east London, we joined the police as they positioned a modified white van on the high street." ;
    airo:sourceDocId "5841" .

<https://w3id.org/airo/incident/evidence/692d81f9c3f6> a airo:Evidence ;
    airo:evidenceText "Since the Notting Hill Carnival in 2016, the Metropolitan Police has used live facial recognition (LFR) technology both at major events and as part of general surveillance on streets." ;
    airo:sourceDocId "5938" .

<https://w3id.org/airo/incident/evidence/6ae519d3f871> a airo:Evidence ;
    airo:evidenceText "Since the Notting Hill Carnival in 2016, the Metropolitan Police has used live facial recognition (LFR) technology both at major events and as part of general surveillance on streets." ;
    airo:sourceDocId "5927" .

<https://w3id.org/airo/incident/evidence/6c30eb654048> a airo:Evidence ;
    airo:evidenceText "She says that anyone's face who is scanned is effectively part of a digital police line-up." ;
    airo:sourceDocId "5839" .

<https://w3id.org/airo/incident/evidence/7369a660b00e> a airo:Evidence ;
    airo:evidenceText "It takes less than a second for the technology to create a biometric image of a person's face, assess it against the bespoke watchlist and automatically delete it when there is no match." ;
    airo:sourceDocId "5841" .

<https://w3id.org/airo/incident/evidence/73f0cfef49d1> a airo:Evidence ;
    airo:evidenceText "I was misidentified as shoplifter by facial recognition tech" ;
    airo:sourceDocId "5841" .

<https://w3id.org/airo/incident/evidence/769fd1d7d8a4> a airo:Evidence ;
    airo:evidenceText "Facewatch is used in numerous stores in the UK - including Budgens, Sports Direct and Costcutter - to identify shoplifters." ;
    airo:sourceDocId "3676" .

<https://w3id.org/airo/incident/evidence/7723ebd601d9> a airo:Evidence ;
    airo:evidenceText "Times analysis shows that since its introduction live facial scanning has been used 62 times over 340 hours, resulting in 152 arrests --- equivalent to almost one arrest every two hours." ;
    airo:sourceDocId "3677" .

<https://w3id.org/airo/incident/evidence/7eefb76d3290> a airo:Evidence ;
    airo:evidenceText "I was misidentified as shoplifter by facial recognition tech" ;
    airo:sourceDocId "5839" .

<https://w3id.org/airo/incident/evidence/957af869302d> a airo:Evidence ;
    airo:evidenceText "Since the Notting Hill Carnival in 2016, the Metropolitan Police has used live facial recognition (LFR) technology both at major events and as part of general surveillance on streets." ;
    airo:sourceDocId "5938" .

<https://w3id.org/airo/incident/evidence/97fff57b9ab8> a airo:Evidence ;
    airo:evidenceText "Earlier this month, a post on X by Tower Hamlets Police alerted residents to use of the software in the borough." ;
    airo:sourceDocId "5938" .

<https://w3id.org/airo/incident/evidence/b200dea0acd4> a airo:Evidence ;
    airo:evidenceText "Innocent woman branded a thief by AI facial recognition software" ;
    airo:sourceDocId "5927" .

<https://w3id.org/airo/incident/evidence/bca06ed30888> a airo:Evidence ;
    airo:evidenceText "Facial recognition starts by identifying face in a still or video – picking out which pixels make up a face and which are the body, background or something else." ;
    airo:sourceDocId "5938" .

<https://w3id.org/airo/incident/evidence/bcc395e36f24> a airo:Evidence ;
    airo:evidenceText "Earlier this year the government announced that £230 million would be spent over four years on police technology, including facial recognition vans." ;
    airo:sourceDocId "3677" .

<https://w3id.org/airo/incident/evidence/d0d4841fc678> a airo:Evidence ;
    airo:evidenceText "[5841] But civil liberty groups are worried that its accuracy is yet to be fully established, and point to cases such as Shaun Thompson's." ;
    airo:sourceDocId "5841" .

<https://w3id.org/airo/incident/evidence/e46fee6dd409> a airo:Evidence ;
    airo:evidenceText "Mr Thompson, who works for youth-advocacy group Streetfathers, didn't think much of it when he walked by a white van near London Bridge in February." ;
    airo:sourceDocId "5841" .

<https://w3id.org/airo/incident/evidence/ee296c16d50c> a airo:Evidence ;
    airo:evidenceText "The BBC also reported a case of mistaken identity by the Metropolitan Police using facial recognition." ;
    airo:sourceDocId "3677" .

<https://w3id.org/airo/incident/evidence/ef4517ae3b81> a airo:Evidence ;
    airo:evidenceText "[5839] Sara - who wants to remain anonymous - was wrongly accused after being flagged by a facial-recognition system called Facewatch." ;
    airo:sourceDocId "5839" .

<https://w3id.org/airo/incident/Risk/c8917c921a7f> a airo:Risk ;
    rdfs:label "risk of false accusations from facial recognition" ;
    airo:confidenceScore "0.9"^^xsd:float ;
    airo:extractionMode "abstracted" ;
    airo:hasEvidence <https://w3id.org/airo/incident/evidence/bf27e046f003> ;
    airo:hasSourceDocument <https://w3id.org/airo/incident/document/3677> ;
    airo:leadsTo <https://w3id.org/airo/incident/Consequence/87c1815559fc> .

<https://w3id.org/airo/incident/evidence/28ff5fb6acf4> a airo:Evidence ;
    airo:evidenceText "[3677] The BBC also reported a case of mistaken identity by the Metropolitan Police using facial recognition." ;
    airo:sourceDocId "3677" .

<https://w3id.org/airo/incident/evidence/74325835924f> a airo:Evidence ;
    airo:evidenceText "[5938] That is the exact scenario one woman found herself in due to a mistake made by facial recognition software in a Home Bargains store." ;
    airo:sourceDocId "5938" .

<https://w3id.org/airo/incident/evidence/859aa620ff51> a airo:Evidence ;
    airo:evidenceText "The company's system is used in stores throughout the UK --- including Budgens, Sports Direct and Costcutter." ;
    airo:sourceDocId "3677" .

<https://w3id.org/airo/incident/evidence/bf27e046f003> a airo:Evidence ;
    airo:evidenceText "[3677] A woman said that an employee at Home Bargains, the variety store chain, accused her of being a shoplifter when she was incorrectly flagged by the Facewatch software." ;
    airo:sourceDocId "3677" .

<https://w3id.org/airo/incident/evidence/e776b4b95202> a airo:Evidence ;
    airo:evidenceText "Sara - who wants to remain anonymous - was wrongly accused after being flagged by a facial-recognition system called Facewatch." ;
    airo:sourceDocId "5841" .

<https://w3id.org/airo/incident/evidence/803e26344e7f> a airo:Evidence ;
    airo:evidenceText "Sara - who wants to remain anonymous - was wrongly accused after being flagged by a facial-recognition system called Facewatch." ;
    airo:sourceDocId "5839" .

<https://w3id.org/airo/incident/evidence/e725d6eb3a09> a airo:Evidence ;
    airo:evidenceText "Sara - who wants to remain anonymous - was wrongly accused after being flagged by a facial-recognition system called Facewatch." ;
    airo:sourceDocId "3676" .

<https://w3id.org/airo/incident/evidence/11889bbd6c7c> a airo:Evidence ;
    airo:evidenceText "Facewatch, which is based in central London, declined to comment but said its technology helped to prevent crime and protect workers." ;
    airo:sourceDocId "3677" .

<https://w3id.org/airo/incident/evidence/1a5c22ad27f1> a airo:Evidence ;
    airo:evidenceText "Alongside the Met, South Wales Police uses facial recognition technology, including as major events – it will be deployed at a Take That concert next month." ;
    airo:sourceDocId "5938" .

<https://w3id.org/airo/incident/evidence/29e7698f057f> a airo:Evidence ;
    airo:evidenceText "although a study last year by the National Physical Laboratory (NPL) found algorithms used by the UK forces did not discriminate based on gender, age or ethnicity." ;
    airo:sourceDocId "5927" .

<https://w3id.org/airo/incident/evidence/2bb1d68424b9> a airo:Evidence ;
    airo:evidenceText "...although a study last year by the National Physical Laboratory (NPL) found algorithms used by the UK forces did not discriminate based on gender, age or ethnicity." ;
    airo:sourceDocId "5938" .

<https://w3id.org/airo/incident/evidence/32e2e2e74e51> a airo:Evidence ;
    airo:evidenceText "Silkie Carlo, director of Big Brother Watch, has filmed the police on numerous facial-recognition deployments." ;
    airo:sourceDocId "5839" .

<https://w3id.org/airo/incident/evidence/37461d16c7df> a airo:Evidence ;
    airo:evidenceText "Chris Philp, the policing minister, said: 'Facial recognition has the potential to completely revolutionise policing.'" ;
    airo:sourceDocId "3677" .

<https://w3id.org/airo/incident/evidence/37535d08752e> a airo:Evidence ;
    airo:evidenceText "However, just as in the case of Facewatch, the Met’s software, provided by NEC, is not infallible either." ;
    airo:sourceDocId "5927" .

<https://w3id.org/airo/incident/evidence/3d2e10713f38> a airo:Evidence ;
    airo:evidenceText "But civil liberty groups are worried that its accuracy is yet to be fully established, and point to cases such as Shaun Thompson's." ;
    airo:sourceDocId "5841" .

<https://w3id.org/airo/incident/evidence/5345ea64903e> a airo:Evidence ;
    airo:evidenceText "On the day we were filming, the Metropolitan Police said they made six arrests with the assistance of the tech." ;
    airo:sourceDocId "5841" .

<https://w3id.org/airo/incident/evidence/659c5e525818> a airo:Evidence ;
    airo:evidenceText "Michael Birtwhistle, head of research at the Ada Lovelace Institute research group, believes the technology is so new that the laws have not yet caught up." ;
    airo:sourceDocId "5839" .

<https://w3id.org/airo/incident/evidence/705f79b7a7fd> a airo:Evidence ;
    airo:evidenceText "However, just as in the case of Facewatch, the Met's software, provided by NEC, is not infallible either." ;
    airo:sourceDocId "5938" .

<https://w3id.org/airo/incident/evidence/9725a5fbee94> a airo:Evidence ;
    airo:evidenceText "Michael Birtwhistle, head of research at the Ada Lovelace Institute research group, believes the technology is so new that the laws have not yet caught up." ;
    airo:sourceDocId "5841" .

<https://w3id.org/airo/incident/evidence/987e3f7dcf0e> a airo:Evidence ;
    airo:evidenceText "Silkie Carlo, director of Big Brother Watch, has filmed the police on numerous facial-recognition deployments." ;
    airo:sourceDocId "5841" .

<https://w3id.org/airo/incident/evidence/ab3f8478cc3d> a airo:Evidence ;
    airo:evidenceText "Alongside the Met, South Wales Police uses facial recognition technology, including as major events – it will be deployed at a Take That concert next month." ;
    airo:sourceDocId "5927" .

<https://w3id.org/airo/incident/evidence/b78e7b424d1d> a airo:Evidence ;
    airo:evidenceText "Home Bargains, too, declined to comment." ;
    airo:sourceDocId "3676" .

<https://w3id.org/airo/incident/evidence/bbe19294effb> a airo:Evidence ;
    airo:evidenceText "Michael Birtwhistle, head of research at the Ada Lovelace Institute research group, believes the technology is so new that the laws have not yet caught up." ;
    airo:sourceDocId "3676" .

<https://w3id.org/airo/incident/evidence/bbf248a25708> a airo:Evidence ;
    airo:evidenceText "Facewatch later wrote to Sara and acknowledged it had made an error." ;
    airo:sourceDocId "5839" .

<https://w3id.org/airo/incident/evidence/d176dc21dd2d> a airo:Evidence ;
    airo:evidenceText "In an interview last month to mark a year of the technology's use, Lindsey Chiswick, the force's director of intelligence, said that it had been the biggest breakthrough for crime detection since the advent of DNA profiling." ;
    airo:sourceDocId "3677" .

<https://w3id.org/airo/incident/evidence/d6227e072453> a airo:Evidence ;
    airo:evidenceText "On the day we were filming, the Metropolitan Police said they made six arrests with the assistance of the tech." ;
    airo:sourceDocId "3676" .

<https://w3id.org/airo/incident/evidence/dd43c482ca0d> a airo:Evidence ;
    airo:evidenceText "Sara needed some chocolate - she had had one of those days - so wandered into a Home Bargains store." ;
    airo:sourceDocId "5841" .

<https://w3id.org/airo/incident/evidence/eb41b2f3d300> a airo:Evidence ;
    airo:evidenceText "Sara needed some chocolate - she had had one of those days - so wandered into a Home Bargains store." ;
    airo:sourceDocId "5839" .

<https://w3id.org/airo/incident/evidence/ebd3b0348a12> a airo:Evidence ;
    airo:evidenceText "On the day we were filming, the Metropolitan Police said they made six arrests with the assistance of the tech." ;
    airo:sourceDocId "5839" .

<https://w3id.org/airo/incident/evidence/a3221006f1c4> a airo:Evidence ;
    airo:evidenceText "Silkie Carlo, director of Big Brother Watch, has filmed the police on numerous facial-recognition deployments." ;
    airo:sourceDocId "3676" .

<https://w3id.org/airo/incident/evidence/2f79e24445ce> a airo:Evidence ;
    airo:evidenceText "Shaun Thompson, who works for the youth-advocacy group Street Fathers, said that he was incorrectly identified by police using a facial recognition system near London Bridge." ;
    airo:sourceDocId "3677" .

