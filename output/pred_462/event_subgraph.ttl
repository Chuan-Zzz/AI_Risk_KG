    airo:evidenceText "AI诈骗正在全国爆发" ;
    airo:sourceDocId "8261" .

<https://w3id.org/airo/incident/Risk/b6d4eb24356f> a airo:Risk ;
    rdfs:label "risk of AI-powered fraud through identity spoofing" ;
    airo:confidenceScore "1.0"^^xsd:float ;
