    airo:sourceDocId "511" .

<https://w3id.org/airo/incident/evidence/54aabbf20226> a airo:Evidence ;
    airo:evidenceText "Dong Mingzhu, chairwoman of China’s biggest maker of air conditioners Gree Electric Appliances, who found her face splashed on a huge screen erected along a street in the port city of Ningbo that displays images of people caught jaywalking by..." ;
    airo:sourceDocId "508" .

<https://w3id.org/airo/incident/evidence/83119168e9a4> a airo:Evidence ;
    airo:evidenceText "After the picture went viral on Chinese social network Weibo, the local police admitted the mistake and revealed that the problem had been fixed with a software update." ;
    airo:sourceDocId "505" .

<https://w3id.org/airo/incident/evidence/ab721628ba56> a airo:Evidence ;
    airo:evidenceText "Chinese traffic police have increasingly relied on facial recognition systems to catch those who violate the rules." ;
    airo:sourceDocId "5070" .

<https://w3id.org/airo/incident/evidence/d2ac040c5a2f> a airo:Evidence ;
    airo:evidenceText "As reported by Abacus, one camera caught a jaywalker at an intersection in Jiangxia Bridge East, but it turned out to be merely the face of a famous businesswoman, Dong Mingzhu." ;
    airo:sourceDocId "512" .

<https://w3id.org/airo/incident/evidence/eeb0486155af> a airo:Evidence ;
    airo:evidenceText "As first reported by Abacus, it all took place in the Zhejiang province, south of Shanghai." ;
    airo:sourceDocId "517" .

<https://w3id.org/airo/incident/evidence/4fac0944f222> a airo:Evidence ;
    airo:evidenceText "SenseTime’s facial recognition and video analysis technologies are used by the Chinese government and the company is aiming for its ‘Viper’ system to be able to process and analyse over 100,000 simultaneous real-time streams from traffic cameras, ATMs, and more to automatically tag and keep track of individuals." ;
    airo:sourceDocId "506" .

<https://w3id.org/airo/incident/evidence/7d013984120c> a airo:Evidence ;
    airo:evidenceText "Local police soon admitted in a statement on microblogging site Weibo that identifying Dong as a jaywalker was an error made by the facial recognition system, and claimed that the problem had now been fixed by an upgrade." ;
    airo:sourceDocId "5070" .

<https://w3id.org/airo/incident/evidence/db720dbe618e> a airo:Evidence ;
    airo:evidenceText "A system deployed by the Chinese government to identify jaywalkers, reportedly using real-time facial recognition, has mistakenly identified a celebrity as an offender after scanning her face from an advertisement on the side of a passing bus, Chinese tech website Abacus reports." ;
    airo:sourceDocId "513" .

<https://w3id.org/airo/incident/evidence/e3ffc416e346> a airo:Evidence ;
    airo:evidenceText "Zhejiang is 1 of the provinces that last year deployed facial recognition technology that humiliates citizens who jaywalk by putting their photos on massive LED screens." ;
    airo:sourceDocId "501" .

<https://w3id.org/airo/incident/evidence/74592940fdbb> a airo:Evidence ;
    airo:evidenceText "Abacus News reports that the camera spotted Dong Mingzhu, the incredibly rich and famous president of Gree Electric Appliances, on the side of a bus and naturally concluded that this surprisingly non-human-sized human was some kind of giant jaywalker." ;
    airo:sourceDocId "505" .

<https://w3id.org/airo/incident/evidence/2b2f42d75cf1> a airo:Evidence ;
    airo:evidenceText "Chinese facial recognition provider SenseTime became the most funded AI startup in the world earlier this year, with a reported valuation of over $3 billion." ;
    airo:sourceDocId "506" .

<https://w3id.org/airo/incident/evidence/a263ea858f65> a airo:Evidence ;
    airo:evidenceText "NYPD has been using Clearview AI's facial recognition technology since 2018." ;
    airo:sourceDocId "515" .

<https://w3id.org/airo/incident/evidence/eb3777790a80> a airo:Evidence ;
    airo:evidenceText "A facial recognition system in the city of Ningbo caught Dong Mingzhu, the chair of appliance-making giant Gree Electric, running a red light." ;
    airo:sourceDocId "511" .

<https://w3id.org/airo/incident/evidence/e48547b70e64> a airo:Evidence ;
    airo:evidenceText "Developments are also underway to engage the country’s mobile network operators and social media platforms, such as Tencent Holdings’ WeChat and Sina Weibo, to establish a system in which offenders will receive personal text messages as soon as they are caught violating traffic rules." ;
    airo:sourceDocId "519" .

<https://w3id.org/airo/incident/evidence/9e805454f656> a airo:Evidence ;
    airo:evidenceText "According to the South China Morning Post, police in the city of Ningbo have been doing this to crack down on jaywalking." ;
    airo:sourceDocId "509" .

<https://w3id.org/airo/incident/evidence/e8fef8b10ae2> a airo:Evidence ;
    airo:evidenceText "Local police soon admitted in a statement on microblogging site Weibo that identifying Dong as a jaywalker was an error made by the facial recognition system" ;
    airo:sourceDocId "517" .

<https://w3id.org/airo/incident/evidence/cf37117fd997> a airo:Evidence ;
    airo:evidenceText "The AI genius employed by said cops comes from Shenzhen-based Intellifusion, whose \"DeepEye\" provides “Cloud based deep learning for public safety and industrial monitoring” according to the company." ;
    airo:sourceDocId "499" .

<https://w3id.org/airo/incident/evidence/0e2a6ba9538e> a airo:Evidence ;
    airo:evidenceText "Shan Jun, the deputy chief of the police at the railway station in Zhengzhou, where a police officer identified a heroin smuggler using facial recognition glasses, told the Times." ;
    airo:sourceDocId "501" .

<https://w3id.org/airo/incident/evidence/ff96ed71e4f5> a airo:Evidence ;
    airo:evidenceText "A facial recognition system in Ningbo mistakenly identified an advertisement featuring Dong Mingzhu, chair of Gree Electric, as the actual person and charged her with jaywalking." ;
    airo:sourceDocId "5067" .

