<https://w3id.org/airo/incident/Vulnerability/7309741edaf3> a airo:Vulnerability ;
    rdfs:label "AI autocomplete system aggregates and presents information without verifying its factual accuracy or defamatory nature" ;
    airo:confidenceScore "0.85"^^xsd:float ;
    airo:extractionMode "abstracted" ;
    airo:hasEvidence <https://w3id.org/airo/incident/evidence/66ab12b4fc9e> ;
    airo:hasSourceDocument <https://w3id.org/airo/incident/document/674> .

<https://w3id.org/airo/incident/evidence/1fd03261aea9> a airo:Evidence ;
    airo:evidenceText "The South Australian Supreme Court has found that Google published defamatory statements that appeared in autocomplete and related search terms on its search engine." ;
    airo:sourceDocId "685" .

<https://w3id.org/airo/incident/evidence/250758fd9f11> a airo:Evidence ;
    airo:evidenceText "In Germany, a man recently won a legal battle with Google over the fact that when you searched for his name, the autocomplete suggestions connected him to 'scientology' and 'fraud'" ;
    airo:sourceDocId "674" .

<https://w3id.org/airo/incident/evidence/2864b26baccb> a airo:Evidence ;
    airo:evidenceText "An Australian man who alleges Google defamed him on Wednesday won a court battle to sue the search engine giant." ;
    airo:sourceDocId "679" .

<https://w3id.org/airo/incident/evidence/2876fe4361c4> a airo:Evidence ;
    airo:evidenceText "This morning, the Federal Supreme Court (Bundesgerichtshof) has held Google liable for a functionality of its search engine, the autocomplete function." ;
    airo:sourceDocId "683" .

<https://w3id.org/airo/incident/evidence/2a0b34c36cdf> a airo:Evidence ;
    airo:evidenceText "His Honour Justice Blue also followed the reasoning of the Victorian Supreme Court in Trkulja v Google Inc LLC (No 5) and held that Google was the publisher of defamatory search results." ;
    airo:sourceDocId "685" .

<https://w3id.org/airo/incident/evidence/2b99fec667fc> a airo:Evidence ;
    airo:evidenceText "On Tuesday, lead counsel Carlo Piana wrote on his blog that the Court of Milan has upheld its earlier decision to order Google to filter out libellous search suggestions." ;
    airo:sourceDocId "676" .

<https://w3id.org/airo/incident/evidence/2d46ca226e28> a airo:Evidence ;
    airo:evidenceText "Google has lost a case in Italy over the defamatory nature of autocomplete suggestions, according to a lawyer for the complainant." ;
    airo:sourceDocId "676" .

<https://w3id.org/airo/incident/evidence/3583f2524d53> a airo:Evidence ;
    airo:evidenceText "Google's auto-complete and related search functions are revealing the identity of rape victims who have been granted anonymity." ;
    airo:sourceDocId "6487" .

<https://w3id.org/airo/incident/evidence/393ddd177c9e> a airo:Evidence ;
    airo:evidenceText "His Honour Justice Blue reasoned that the defamatory phrase was 'generated by Google programs as a result of Google's programming'." ;
    airo:sourceDocId "685" .

<https://w3id.org/airo/incident/evidence/3a1b9ce323f6> a airo:Evidence ;
    airo:evidenceText "I automatically collected data on both Google and Bing autocompletions for a number of different queries relating to public companies and politicians." ;
    airo:sourceDocId "674" .

<https://w3id.org/airo/incident/evidence/47bfd3d4e966> a airo:Evidence ;
    airo:evidenceText "Algorithmic Defamation: The Case of the Shameless Autocomplete" ;
    airo:sourceDocId "674" .

<https://w3id.org/airo/incident/evidence/4bb0f14ecefa> a airo:Evidence ;
    airo:evidenceText "In his judgment, his Honour referred to the 'only authority' on this point as supporting this conclusion, being the decision of the High Court of Hong Kong in Dr Yeung Sau Shing Albert v Google Inc." ;
    airo:sourceDocId "685" .

<https://w3id.org/airo/incident/evidence/631518ca35a2> a airo:Evidence ;
    airo:evidenceText "I automatically collected data on both Google and Bing autocompletions for a number of different queries relating to public companies and politicians." ;
