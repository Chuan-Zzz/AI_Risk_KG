<https://w3id.org/airo/incident/Obligation/133fbcf62463> a airo:Obligation ;
    rdfs:label "filter out libellous search suggestions upon court order or notice" ;
    airo:confidenceScore "0.9"^^xsd:float ;
    airo:extractionMode "inferred" ;
    airo:hasEvidence <https://w3id.org/airo/incident/evidence/c2ae9ad6b5e4> ;
    airo:hasReasoning "The court order creates a legal obligation for Google to take action to mitigate the harm caused by its AI system." ;
    airo:hasSourceDocument <https://w3id.org/airo/incident/document/676> .

<https://w3id.org/airo/incident/Purpose/db91c4d83497> a airo:Purpose ;
    rdfs:label "generate autocomplete search suggestions for user queries" ;
    airo:confidenceScore "0.95"^^xsd:float ;
