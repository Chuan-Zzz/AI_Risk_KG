<https://w3id.org/airo/incident/evidence/cbc1cc24b3f5> a airo:Evidence ;
    airo:evidenceText "The case involved someone who was upset that doing a Google search on his name popped up \"con man\" (\"truffatore\") and \"fraud\" (\"truffa\") as autocomplete Google search suggestions." ;
    airo:sourceDocId "684" .

