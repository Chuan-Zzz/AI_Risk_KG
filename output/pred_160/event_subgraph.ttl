<https://w3id.org/airo/incident/Standard/9c6f344e3501> a airo:Standard ;
    rdfs:label "Meta Deepfake Detection Challenge" ;
    airo:confidenceScore "0.8"^^xsd:float ;
    airo:extractionMode "explicit" ;
    airo:hasDescription "deepfake detection challenge" ;
    airo:hasEvidence <https://w3id.org/airo/incident/evidence/d8e68783cc33> ;
    airo:hasSourceDocument <https://w3id.org/airo/incident/document/2618> .

<https://w3id.org/airo/incident/evidence/0d363dc157c3> a airo:Evidence ;
    airo:evidenceText "4chan members used ElevenLabs to make deepfake voices of Emma Watson, Joe Rogan, and others saying racist, transphobic, and violent things." ;
    airo:sourceDocId "2552" .

<https://w3id.org/airo/incident/evidence/1af5f7d898f1> a airo:Evidence ;
    airo:evidenceText "Meta, which owns Facebook and Instagram, ran a competition in 2021 to develop programs capable of identifying deepfakes, resulting in one tool that could spot them 83 percent of the time." ;
    airo:sourceDocId "2618" .

<https://w3id.org/airo/incident/evidence/1fce439dd03c> a airo:Evidence ;
    airo:evidenceText "1 week after opening access to its voice-cloning platform, AI speech startup ElevenLabs says it may need to rethink that openness amid \"an increasing number of voice cloning misuse cases.\"" ;
    airo:sourceDocId "8028" .

<https://w3id.org/airo/incident/evidence/21c72ef7932c> a airo:Evidence ;
    airo:evidenceText "People Are Still Terrible: AI Voice-Cloning Tool Misused for Deepfake Celeb Clips" ;
    airo:sourceDocId "8028" .

<https://w3id.org/airo/incident/evidence/23ecacbf4cd1> a airo:Evidence ;
    airo:evidenceText "In November, the company debuted a speech-cloning tool that can be trained to replicate voices in seconds." ;
    airo:sourceDocId "2618" .

<https://w3id.org/airo/incident/evidence/2c68be1f0e8d> a airo:Evidence ;
    airo:evidenceText "Similar advances in automation previously led to a rise in deepfake videos (specifically: pornography)." ;
    airo:sourceDocId "8028" .

<https://w3id.org/airo/incident/evidence/3197b1c4e790> a airo:Evidence ;
    airo:evidenceText "No specific technical documents like model cards or risk assessments are referenced." ;
    airo:sourceDocId "8028" .

<https://w3id.org/airo/incident/evidence/3eb8ca17c7c3> a airo:Evidence ;
    airo:evidenceText "Twitter also removed some of the videos." ;
    airo:sourceDocId "2618" .

<https://w3id.org/airo/incident/evidence/457e1137e278> a airo:Evidence ;
    airo:evidenceText "ElevenLabs — an AI startup founded by former Google and Palantir employees — announced two things: a $2 million funding round, and the release of a beta for a AI voice generator called Eleven, described in a company press release as an \"AI speech platform promising to revolutionize audio storytelling.\"" ;
    airo:sourceDocId "8027" .

<https://w3id.org/airo/incident/evidence/473ff48d8c23> a airo:Evidence ;
    airo:evidenceText "But given the high quality of the generated voices, and the apparent ease at which people created them, they highlight the looming risk of deepfake audio clips." ;
    airo:sourceDocId "8031" .

<https://w3id.org/airo/incident/evidence/49c43f1533ab> a airo:Evidence ;
    airo:evidenceText "And while ElevenLabs built its software with the goal to \"instantly convert spoken audio between languages\"—there will always be someone who abuses it." ;
    airo:sourceDocId "8028" .

<https://w3id.org/airo/incident/evidence/4b0c05571748> a airo:Evidence ;
    airo:evidenceText "some users appear to have taken the voice-cloning tool, which can generate a deepfake from a recording of just one minute, to create recordings of Watson, Attenborough and other prominent people." ;
    airo:sourceDocId "2668" .

<https://w3id.org/airo/incident/evidence/4b634f8d0dd8> a airo:Evidence ;
    airo:evidenceText "For the latter, ElevenLabs says it can generate a clone of someone’s voice from a clean sample recording, over one minute in length." ;
    airo:sourceDocId "8031" .

<https://w3id.org/airo/incident/evidence/50698bb014ab> a airo:Evidence ;
    airo:evidenceText "ElevenLabs, founded by ex-Google and Palantir staffers, said it had found an “increasing number of voice cloning misuse cases” during its recently launched beta." ;
    airo:sourceDocId "2552" .

<https://w3id.org/airo/incident/evidence/51cd682d2b40> a airo:Evidence ;
    airo:evidenceText "Users took the voice-cloning technology to create the audio files and posted them on the message board 4Chan in the latest abuse of AI technology." ;
    airo:sourceDocId "2668" .

<https://w3id.org/airo/incident/evidence/56889cdfe3e8> a airo:Evidence ;
    airo:evidenceText "In a statement, a spokeswoman for YouTube said the video of Mr. Rogan and Mr. Trudeau did not violate the platform’s policies because it “provides sufficient context.”" ;
    airo:sourceDocId "2618" .

<https://w3id.org/airo/incident/evidence/600982305b50> a airo:Evidence ;
    airo:evidenceText "1 week after opening access to its voice-cloning platform, AI speech startup ElevenLabs says it may need to rethink that openness amid \"an increasing number of voice cloning misuse cases.\"" ;
    airo:sourceDocId "8028" .

<https://w3id.org/airo/incident/evidence/650f7e41c08b> a airo:Evidence ;
    airo:evidenceText "Text-to-speech AI and voice cloning are among \"generative AI\" technologies that are catching the eye of investors and the public." ;
    airo:sourceDocId "2668" .

<https://w3id.org/airo/incident/evidence/6618cdf206f1> a airo:Evidence ;
    airo:evidenceText "ElevenLabs said it had found an “increasing number of voice cloning misuse cases” during its recently launched beta." ;
    airo:sourceDocId "2552" .

<https://w3id.org/airo/incident/evidence/7408424897f0> a airo:Evidence ;
    airo:evidenceText "Compañía que hace voces con IA tomará acciones ante usuarios que usan su tecnología para racismo y misoginia" ;
    airo:sourceDocId "8030" .

<https://w3id.org/airo/incident/evidence/79330015976f> a airo:Evidence ;
    airo:evidenceText "The research company ElevenLabs released its new text-to-audio tool that enables users to type in words and hear them reproduced immediately in a human voice." ;
    airo:sourceDocId "2668" .

<https://w3id.org/airo/incident/evidence/857f809cd1ab> a airo:Evidence ;
    airo:evidenceText "ElevenLabs said on Twitter that it would introduce new safeguards, like limiting voice cloning to paid accounts and providing a new A.I. detecting tool." ;
    airo:sourceDocId "2618" .

<https://w3id.org/airo/incident/evidence/862c390de499> a airo:Evidence ;
    airo:evidenceText "\"Professional cloning,\" meanwhile, can allegedly reproduce any accent, for use in newsletters, books, and videos." ;
    airo:sourceDocId "8028" .

<https://w3id.org/airo/incident/evidence/8d7de357fc70> a airo:Evidence ;
    airo:evidenceText "1 post contained a link to Prime Voice AI, suggesting the company's software may have been employed." ;
    airo:sourceDocId "8028" .

<https://w3id.org/airo/incident/evidence/a6490d9bba6a> a airo:Evidence ;
    airo:evidenceText "AI-Generated Voice Firm Clamps Down After 4chan Makes Celebrity Voices for Abuse" ;
    airo:sourceDocId "2552" .

<https://w3id.org/airo/incident/evidence/a96c13bf09f4> a airo:Evidence ;
    airo:evidenceText "In much the same way deepfake video started as a method for people to create non-consensual pornography of specific people before branching onto other use cases, the trajectory of deepfake audio is only just beginning." ;
    airo:sourceDocId "8031" .

<https://w3id.org/airo/incident/evidence/ab6ab028acab> a airo:Evidence ;
    airo:evidenceText "ElevenLabs offers \"speech synthesis\" and \"voice cloning\"—the latter of which results in a clean sample recording, more than one minute in length." ;
    airo:sourceDocId "8028" .

<https://w3id.org/airo/incident/evidence/aca03162642a> a airo:Evidence ;
    airo:evidenceText "No enforcement actions are described in the evidence sentences." ;
    airo:sourceDocId "8028" .

<https://w3id.org/airo/incident/evidence/af93d0f923be> a airo:Evidence ;
    airo:evidenceText "In an email, a spokeswoman for ElevenLabs said the company was looking to collaborate with other A.I. developers to create a universal detection system that could be adopted across the industry." ;
    airo:sourceDocId "2618" .

<https://w3id.org/airo/incident/evidence/b1ee1b7f27a5> a airo:Evidence ;
    airo:evidenceText "Motherboard found 4chan members appear to have used the product to generate voices that sound like Joe Rogan, Ben Shapiro, and Emma Watson to spew racist and other sorts of material." ;
    airo:sourceDocId "8031" .

<https://w3id.org/airo/incident/evidence/b5b6783d9134> a airo:Evidence ;
    airo:evidenceText "1 week after opening access to its voice-cloning platform, AI speech startup ElevenLabs says it may need to rethink that openness amid \"an increasing number of voice cloning misuse cases.\"" ;
    airo:sourceDocId "8028" .

<https://w3id.org/airo/incident/evidence/b76135b5c4cc> a airo:Evidence ;
    airo:evidenceText "A TikTok spokesman said the company used “a combination of technology and human moderation to detect and remove” manipulated videos, but declined to elaborate on its methods." ;
    airo:sourceDocId "2618" .

<https://w3id.org/airo/incident/evidence/bda0f529afa1> a airo:Evidence ;
    airo:evidenceText "ElevenLabs also offers “professional cloning,” which it says can reproduce any accent." ;
    airo:sourceDocId "2552" .

<https://w3id.org/airo/incident/evidence/be79c5e68af2> a airo:Evidence ;
    airo:evidenceText "Emma Watson reads Mein Kampf on 4Chan in deepfake audio trick" ;
    airo:sourceDocId "2668" .

<https://w3id.org/airo/incident/evidence/c44349de2739> a airo:Evidence ;
    airo:evidenceText "ElevenLabs is already being forced to reckon with, as they put it in a Monday Twitter thread, \"an increasing number of voice cloning misuse cases.\"" ;
    airo:sourceDocId "8027" .

<https://w3id.org/airo/incident/evidence/d25368bd3f78> a airo:Evidence ;
    airo:evidenceText "Startup Shocked When 4Chan Immediately Abuses Its Voice-Cloning AI" ;
