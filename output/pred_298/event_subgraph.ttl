<https://w3id.org/airo/incident/Stakeholder/569c8bf95771> a airo:Stakeholder ;
    rdfs:label "OpenAI" ;
    airo:confidenceScore "0.95"^^xsd:float ;
    airo:develops <https://w3id.org/airo/incident/AIModel/374b8f9d0637>,
        <https://w3id.org/airo/incident/AIModel/975bdfb138b8>,
        <https://w3id.org/airo/incident/AISystem/057385f8a11b>,
