<https://w3id.org/airo/incident/Threat/83357879bcbb> a airo:Threat ;
    rdfs:label "adversarial or unanticipated user inputs triggering inappropriate responses" ;
    airo:confidenceScore "0.75"^^xsd:float ;
    airo:extractionMode "abstracted" ;
    airo:hasEvidence <https://w3id.org/airo/incident/evidence/8c410b75b0d0> ;
    airo:hasSourceDocument <https://w3id.org/airo/incident/document/2899> .

<https://w3id.org/airo/incident/Vulnerability/7f08b303f14e> a airo:Vulnerability ;
    rdfs:label "chatbot generating advice outside its programmed cognitive behavioral therapy parameters" ;
    airo:confidenceScore "0.9"^^xsd:float ;
    airo:extractionMode "abstracted" ;
    airo:hasEvidence <https://w3id.org/airo/incident/evidence/8306d4d9d841> ;
    airo:hasSourceDocument <https://w3id.org/airo/incident/document/2930> .

<https://w3id.org/airo/incident/evidence/072b1b63f2bb> a airo:Evidence ;
    airo:evidenceText "Eating disorder activist Sharon Maxwell was the first to sound the alarm in an Instagram post revealing that the chatbot offered her problematic advice." ;
    airo:sourceDocId "2904" .

<https://w3id.org/airo/incident/evidence/07cd6f73e27b> a airo:Evidence ;
    airo:evidenceText "Fat activist Sharon Maxwell revealed on Instagram that during her interactions with Tessa, the bot actually encouraged her to engage in disordered eating." ;
    airo:sourceDocId "2926" .

<https://w3id.org/airo/incident/evidence/08513e6fd240> a airo:Evidence ;
    airo:evidenceText "the National Eating Disorder Association says that the AI chatbot that was going to replace the humans “may have given” harmful information, according to multiple reports." ;
    airo:sourceDocId "2922" .

<https://w3id.org/airo/incident/evidence/090e7cc8ede1> a airo:Evidence ;
    airo:evidenceText "An activist called Sharon Maxwell made the issues with Tessa public by stating: “Every single thing Tessa suggested were things that led to the development of my eating disorder.”" ;
    airo:sourceDocId "2920" .

<https://w3id.org/airo/incident/evidence/0b7e22f87463> a airo:Evidence ;
    airo:evidenceText "This advice was outside of its original programming, and beyond the intentions of the organization, according to Liz Thompson, NEDA’s CEO." ;
    airo:sourceDocId "2922" .

<https://w3id.org/airo/incident/evidence/0bb8188be589> a airo:Evidence ;
    airo:evidenceText "1 Tessa user Sharon Maxwell, who calls herself a 'fat activist,' tells Yahoo Life that she wanted to see how it worked and was met with 'troubling' responses." ;
    airo:sourceDocId "2923" .

<https://w3id.org/airo/incident/evidence/0bda34099220> a airo:Evidence ;
    airo:evidenceText "A Wellness Chatbot Is Offline After Its ‘Harmful’ Focus on Weight Loss" ;
    airo:sourceDocId "2900" .

<https://w3id.org/airo/incident/evidence/0f9af00440c2> a airo:Evidence ;
    airo:evidenceText "In a statement shared with Insider, NEDA CEO Elizabeth Thompson said NEDA has 'not seen any of the kinds of messages or issues reported on Monday with any previous users,' since the chatbot was made available to the public in February 2022." ;
    airo:sourceDocId "2929" .

<https://w3id.org/airo/incident/evidence/107895a6b23d> a airo:Evidence ;
    airo:evidenceText "In March, the staffers of the National Eating Disorders Association (NEDA) crisis hotline voted to unionize." ;
    airo:sourceDocId "2926" .

<https://w3id.org/airo/incident/evidence/11b67c162609> a airo:Evidence ;
    airo:evidenceText "Ellen Fitzsimmons, a psychologist in a post on NEDA website has said that the chatbot ‘Tessa’ was thought as a solution for making eating disorder prevention widely available." ;
    airo:sourceDocId "2936" .

<https://w3id.org/airo/incident/evidence/12092fe195ce> a airo:Evidence ;
    airo:evidenceText "Abbie Harper, a helpline staffer, wrote in a blog post about NEDA's reported plan to fire its human staff that 'Some of us have personally recovered from eating disorders and bring that invaluable experience to our work.'" ;
    airo:sourceDocId "2929" .

<https://w3id.org/airo/incident/evidence/152747e02556> a airo:Evidence ;
    airo:evidenceText "Commenting on the remarks, Neda’s interim chief Elizabeth Thompson told The Register that claims of the non-profit replacing its helpline service with a chatbot were untrue." ;
    airo:sourceDocId "2937" .

<https://w3id.org/airo/incident/evidence/161d75a81e52> a airo:Evidence ;
    airo:evidenceText "The National Eating Disorders Association (NEDA) has suspended an AI chatbot after it dispensed potentially damaging advice to individuals seeking help for their eating disorders." ;
    airo:sourceDocId "2939" .

<https://w3id.org/airo/incident/evidence/189e4ce314cb> a airo:Evidence ;
    airo:evidenceText "Thompson clarified that the chatbot is not run by ChatGPT and is “not a highly functional AI system”." ;
    airo:sourceDocId "2902" .

<https://w3id.org/airo/incident/evidence/192466bfad11> a airo:Evidence ;
    airo:evidenceText "A Chatbot Was Designed to Help Prevent Eating Disorders. Then It Gave Dieting Tips." ;
    airo:sourceDocId "2898" .

<https://w3id.org/airo/incident/evidence/194fd77fa3b4> a airo:Evidence ;
    airo:evidenceText "Tessa has been available on our site since February 2022 and has had incredibly positive outcomes both in testing it before we launched on our website, as well as during the last year it has been available to NEDA users, Thompson continued." ;
    airo:sourceDocId "2930" .

<https://w3id.org/airo/incident/evidence/1988ee6b3998> a airo:Evidence ;
    airo:evidenceText "Alexis Conason, a psychologist who specializes in the treatment of eating disorders, was able to replicate some of the harmful advice when she tried the chatbot herself." ;
    airo:sourceDocId "2935" .

<https://w3id.org/airo/incident/evidence/1a187de3b97d> a airo:Evidence ;
    airo:evidenceText "Conason reached out to Tessa after another Instagram user, @heysharonmaxwell, posted that she received advice that encouraged behavior engaged in by people with disordered eating." ;
    airo:sourceDocId "2917" .

<https://w3id.org/airo/incident/evidence/1a988abfcd6b> a airo:Evidence ;
    airo:evidenceText "NEDA helpline staffer Abbie Harper told NPR that the volume of calls doubled during the Covid-19 pandemic and included people not only struggling with eating disorders, but also self-harm, suicidal thoughts, and other “crisis-type” situations." ;
    airo:sourceDocId "2917" .

<https://w3id.org/airo/incident/evidence/1c144739541c> a airo:Evidence ;
    airo:evidenceText "According to NEDA CEO Liz Thompson, the problem with Tessa lay in its use of language, which violated the organization's core principles and policies relating to eating disorders." ;
    airo:sourceDocId "2939" .

<https://w3id.org/airo/incident/evidence/1d4735354cb7> a airo:Evidence ;
    airo:evidenceText "Activist Sharon Maxwell tells Scripps News the bot was \"harmful\" for allegedly suggesting she cut up to 1,000 calories from her diet to lose weight and suggesting she buy a tool that measures skin folds." ;
    airo:sourceDocId "2910" .

<https://w3id.org/airo/incident/evidence/1ddef01ea34c> a airo:Evidence ;
    airo:evidenceText "NEDA CEO Liz Thompson told VentureBeat in an email." ;
    airo:sourceDocId "2934" .

<https://w3id.org/airo/incident/evidence/1eba645079b7> a airo:Evidence ;
    airo:evidenceText "According to Ellen Fitzsimmons-Craft, a professor of psychiatry at Washington University School of Medicine who worked on creating the program, it is built to give an interactive program called Body Positive, a cognitive behavioral therapy-based tool intended to prevent eating disorders rather than cure them." ;
    airo:sourceDocId "2942" .

<https://w3id.org/airo/incident/evidence/1f4d1b899418> a airo:Evidence ;
    airo:evidenceText "In a statement to the Guardian, Neda’s CEO, Liz Thompson, said that the chatbot was not meant to replace the helpline but was rather created as a separate program." ;
    airo:sourceDocId "2902" .

<https://w3id.org/airo/incident/evidence/1fcaf0334a1f> a airo:Evidence ;
    airo:evidenceText "When NEDA refused (to recognize our union), we filed for an election with the National Labor Relations Board and won." ;
    airo:sourceDocId "2935" .

<https://w3id.org/airo/incident/evidence/212e3d3ed79c> a airo:Evidence ;
    airo:evidenceText "Organizations looking to supplement or even replace some human customer support employees might want to first review the cautionary tale of the National Eating Disorder Association (NEDA) that played out this week." ;
    airo:sourceDocId "2934" .

<https://w3id.org/airo/incident/evidence/21c7bb862291> a airo:Evidence ;
    airo:evidenceText "“Every single thing Tessa suggested were things that led to the development of my eating disorder,” activist Sharon Maxwell wrote in a social media post." ;
    airo:sourceDocId "2941" .

<https://w3id.org/airo/incident/evidence/252c1cb70221> a airo:Evidence ;
    airo:evidenceText "A weight-inclusive consultant, Sharon Maxwell, posted on Instagram earlier this week claiming that she had conversed with Tessa and that the chatbot had given her advice that could cause harm, including for restrictive dieting." ;
    airo:sourceDocId "2934" .

<https://w3id.org/airo/incident/evidence/253b9960ab00> a airo:Evidence ;
