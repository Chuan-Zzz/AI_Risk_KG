<https://w3id.org/airo/incident/AISystem/d8b1d9d06095> a airo:AISystem ;
    rdfs:label "Facebook Watch" ;
    airo:confidenceScore "0.95"^^xsd:float ;
    airo:extractionMode "explicit" ;
    airo:hasDescription "Facebook's Watch" ;
    airo:hasEvidence <https://w3id.org/airo/incident/evidence/f7de9921d914> ;
    airo:hasSourceDocument <https://w3id.org/airo/incident/document/2200> .

<https://w3id.org/airo/incident/evidence/40beca918b9f> a airo:Evidence ;
    airo:evidenceText "Only a small fraction of posts on Facebook – less than one-tenth of one percent, according to company estimates – show violating content, said Drew Pusateri, a spokesperson for Facebook's parent company, Meta." ;
    airo:sourceDocId "2200" .

<https://w3id.org/airo/incident/evidence/52e45b568253> a airo:Evidence ;
    airo:evidenceText "A 2019 report from Facebook’s Civic Integrity team details the results of a study that measured the impact of removing certain integrity protections from some users’ News Feeds." ;
    airo:sourceDocId "2199" .

<https://w3id.org/airo/incident/evidence/73f7e0b6ce26> a airo:Evidence ;
    airo:evidenceText "A survey of 67,000 Facebook users across 17 countries conducted by the Digital Literacy Working group found that at least one fourth and up to one third of the global Facebook population lacks key digital skills while at least one sixth of the U.S. Facebook population has medium or low digital skills." ;
    airo:sourceDocId "2199" .

<https://w3id.org/airo/incident/evidence/75e6aa2757d9> a airo:Evidence ;
    airo:evidenceText "When you think about who's being harmed by the choices that Facebook and other platforms are making, it is those who have been who've been harmed in the past in structurally, historically, systemic kinds of ways, said Angela Siefer, executive director of the National Digital Inclusion Alliance, an advocacy group that aims to bridge the digital divide in part through digital literacy education." ;
    airo:sourceDocId "2200" .

<https://w3id.org/airo/incident/evidence/ca479e490363> a airo:Evidence ;
    airo:evidenceText "The company — which now goes by the name Meta — conducted a user survey a couple of years ago with the goal of analyzing the digital literacy skills of its audience." ;
    airo:sourceDocId "2198" .

<https://w3id.org/airo/incident/evidence/e98fb7904b1f> a airo:Evidence ;
    airo:evidenceText "Regarding hate speech, Facebook’s spokesperson directed TIME to an October 17 Facebook Newsroom post from Facebook’s vice president for Integrity Guy Rosen reemphasizing that the company views “prevalence”—the percentage of viewed content that consists of hate speech—as the most meaningful hate speech metric." ;
    airo:sourceDocId "2199" .

<https://w3id.org/airo/incident/evidence/ef6547095895> a airo:Evidence ;
    airo:evidenceText "In an October 17 installment of its “Facebook Files” series of investigative reports on the Facebook Papers, the Wall Street Journal detailed the extent to which Facebook’s artificial-intelligence systems are tripped up by various forms of disturbing content." ;
    airo:sourceDocId "2199" .

<https://w3id.org/airo/incident/evidence/810bad1ba0e1> a airo:Evidence ;
    airo:evidenceText "Facebook has been dealing with scandal after scandal for some time and has come under intense scrutiny from global lawmakers and regulators." ;
    airo:sourceDocId "2121" .

<https://w3id.org/airo/incident/evidence/8b038dd2721a> a airo:Evidence ;
    airo:evidenceText "Throughout the past few weeks, leaked internal research material courtesy of whistleblower Frances Haugen has revealed a history of questionable choices made by the company." ;
    airo:sourceDocId "2198" .

<https://w3id.org/airo/incident/evidence/a5d928b74d60> a airo:Evidence ;
    airo:evidenceText "Facebook researchers conducted a five-question survey designed to assess its users' digital literacy skills." ;
    airo:sourceDocId "2200" .

<https://w3id.org/airo/incident/evidence/428dee0883c5> a airo:Evidence ;
    airo:evidenceText "Amy VanDeVelde is the national technology program director for Connections, a branch of The Oasis Institute, a St. Louis-based nonprofit that teaches older adults digital literacy and cybersecurity skills." ;
    airo:sourceDocId "2200" .

<https://w3id.org/airo/incident/evidence/528a0affd5e7> a airo:Evidence ;
    airo:evidenceText "This reporting is based on Haugen’s disclosures to the Securities and Exchange Commission (SEC), which were also provided to Congress in redacted form by her legal team." ;
    airo:sourceDocId "2199" .

<https://w3id.org/airo/incident/evidence/c7204eb03ae4> a airo:Evidence ;
    airo:evidenceText "Some users are significantly more likely to see disturbing content on Facebook than others, according to internal company documents leaked by whistleblower Frances Haugen." ;
    airo:sourceDocId "2199" .

