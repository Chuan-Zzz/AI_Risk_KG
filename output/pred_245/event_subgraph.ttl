<https://w3id.org/airo/incident/Hazard/18b1f4c3af9d> a airo:Hazard ;
    rdfs:label "Use of biased algorithm to guide high-stakes medical care decisions" ;
    airo:confidenceScore "0.85"^^xsd:float ;
    airo:extractionMode "abstracted" ;
    airo:hasEvidence <https://w3id.org/airo/incident/evidence/f106374cee1f> ;
    airo:hasSourceDocument <https://w3id.org/airo/incident/document/2062> .

<https://w3id.org/airo/incident/Obligation/7f2a44c5d99b> a airo:Obligation ;
    rdfs:label "correct detected bias in algorithm" ;
    airo:confidenceScore "0.7"^^xsd:float ;
    airo:extractionMode "inferred" ;
    airo:hasEvidence <https://w3id.org/airo/incident/evidence/e503c6984c9c> ;
    airo:hasReasoning "The evidence implies an obligation or best practice to correct bias once identified, though not explicitly regulatory." ;
    airo:hasSourceDocument <https://w3id.org/airo/incident/document/2062> .

<https://w3id.org/airo/incident/Purpose/72fc24cd51f3> a airo:Purpose ;
    rdfs:label "predict patient future health care needs and costs to target care programs" ;
    airo:confidenceScore "0.9"^^xsd:float ;
    airo:extractionMode "inferred" ;
    airo:hasEvidence <https://w3id.org/airo/incident/evidence/8352d8d86e29> ;
    airo:hasReasoning "The evidence states the algorithm was sold to guide care decision-making and predict patient needs, indicating its purpose is to identify high-risk patients for targeted interventions." ;
    airo:hasSourceDocument <https://w3id.org/airo/incident/document/2062> .

<https://w3id.org/airo/incident/RiskSource/07e7a97b629a> a airo:RiskSource ;
    rdfs:label "Bias in health care algorithm design using race as a variable" ;
    airo:causes <https://w3id.org/airo/incident/Risk/65f88fee0d69> ;
    airo:confidenceScore "0.9"^^xsd:float ;
    airo:extractionMode "abstracted" ;
    airo:hasEvidence <https://w3id.org/airo/incident/evidence/5c64598a186d> ;
    airo:hasHazard <https://w3id.org/airo/incident/Hazard/18b1f4c3af9d> ;
    airo:hasSourceDocument <https://w3id.org/airo/incident/document/2062> .

<https://w3id.org/airo/incident/Vulnerability/eddbe6790361> a airo:Vulnerability ;
    rdfs:label "Algorithm designed to predict health care costs rather than health needs, disadvantaging low-income and minority patients" ;
    airo:confidenceScore "0.85"^^xsd:float ;
    airo:extractionMode "abstracted" ;
    airo:hasEvidence <https://w3id.org/airo/incident/evidence/43cacabdfd7a> ;
    airo:hasSourceDocument <https://w3id.org/airo/incident/document/2062> .

<https://w3id.org/airo/incident/evidence/01723ced3a37> a airo:Evidence ;
    airo:evidenceText "Suchi Saria, a machine learning and health-care expert at Johns Hopkins University, said the study was fascinating because it showed how, once a bias is detected, it can be corrected." ;
    airo:sourceDocId "2062" .

<https://w3id.org/airo/incident/evidence/01d01b12ff48> a airo:Evidence ;
    airo:evidenceText "Earlier this year, the American Thoracic Society, which represents lung-care doctors, issued a statement recommending replacement of race-focused adjustments." ;
    airo:sourceDocId "3040" .

<https://w3id.org/airo/incident/evidence/05f2304c294b> a airo:Evidence ;
    airo:evidenceText "Earlier this year, the American Thoracic Society, which represents lung-care doctors, issued a statement recommending replacement of race-focused adjustments." ;
    airo:sourceDocId "3040" .

<https://w3id.org/airo/incident/evidence/0e7b480265c1> a airo:Evidence ;
    airo:evidenceText "Mullainathan and his collaborators discovered that the algorithm they studied, which was designed to help health systems target patients who would have the greatest future health-care needs, was predicting how likely people were to use a lot of health care and rack up high costs in the future." ;
    airo:sourceDocId "2062" .

<https://w3id.org/airo/incident/evidence/1429de842a70> a airo:Evidence ;
    airo:evidenceText "Mullainathan and his collaborators discovered that the algorithm they studied, which was designed to help health systems target patients who would have the greatest future health-care needs, was predicting how likely people were to use a lot of health care and rack up high costs in the future." ;
    airo:sourceDocId "2062" .

<https://w3id.org/airo/incident/evidence/1da1a2d1e127> a airo:Evidence ;
    airo:evidenceText "Christine Vogeli, director of evaluation and research at the Center for Population Health at Partners HealthCare, a nonprofit health system in Massachusetts, said when her team first tested the algorithm, they mapped the highest scores in their patient population and found them concentrated in some of the most affluent suburbs of Boston." ;
    airo:sourceDocId "2062" .

<https://w3id.org/airo/incident/evidence/20117da8a351> a airo:Evidence ;
    airo:evidenceText "The problem was caught in an algorithm sold by a leading health services company, called Optum, to guide care decision-making for millions of people." ;
    airo:sourceDocId "2062" .

<https://w3id.org/airo/incident/evidence/219db9c7d380> a airo:Evidence ;
    airo:evidenceText "Ruha Benjamin, an associate professor of African American studies at Princeton University, drew a parallel to the way Henrietta Lacks, a young African American mother with cervical cancer, was treated by the medical system." ;
    airo:sourceDocId "2062" .

<https://w3id.org/airo/incident/evidence/2678254cae87> a airo:Evidence ;
    airo:evidenceText "“There were stark differences in outcomes,” says Ziad Obermeyer, a physician and researcher at UC Berkeley who worked on the project with colleagues from the University of Chicago and Brigham and Women’s and Massachusetts General hospitals in Boston." ;
    airo:sourceDocId "1262" .

<https://w3id.org/airo/incident/evidence/2bf0765b9673> a airo:Evidence ;
    airo:evidenceText "The new study looked at more than 2,700 Black men and 5,700 white men tested by University of Pennsylvania Health System doctors between 2010 and 2020." ;
    airo:sourceDocId "3040" .

<https://w3id.org/airo/incident/evidence/2dcac213afd6> a airo:Evidence ;
    airo:evidenceText "When Obermeyer and his team reported their findings to the algorithm’s developers — Optum of Eden Prairie, Minnesota — the company repeated their analysis and found the same results." ;
    airo:sourceDocId "2500" .

<https://w3id.org/airo/incident/evidence/33deaa89771d> a airo:Evidence ;
    airo:evidenceText "“There were stark differences in outcomes,” says Ziad Obermeyer, a physician and researcher at UC Berkeley who worked on the project with colleagues from the University of Chicago and Brigham and Women’s and Massachusetts General hospitals in Boston." ;
    airo:sourceDocId "1262" .

<https://w3id.org/airo/incident/evidence/3a20e253676c> a airo:Evidence ;
    airo:evidenceText "Mullainathan and his collaborators discovered that the algorithm they studied, which was designed to help health systems target patients who would have the greatest future health-care needs, was predicting how likely people were to use a lot of health care and rack up high costs in the future." ;
    airo:sourceDocId "2062" .

<https://w3id.org/airo/incident/evidence/3ae060eee708> a airo:Evidence ;
    airo:evidenceText "Ziad Obermeyer, who studies machine learning and health-care management at the University of California, Berkeley, and his team stumbled onto the problem while examining the impact of programmes that provide additional resources and closer medical supervision for people with multiple, sometimes overlapping, health problems." ;
    airo:sourceDocId "2500" .

<https://w3id.org/airo/incident/evidence/3bf3d5933208> a airo:Evidence ;
    airo:evidenceText "This study, published in JAMA Network Open, offers one of the first real-world examples of how the the issue may affect diagnosis and care for lung patients, said Dr. Darshali Vyas, a pulmonary care doctor at Massachusetts General Hospital." ;
    airo:sourceDocId "3040" .

<https://w3id.org/airo/incident/evidence/3e1bebeb5d4f> a airo:Evidence ;
    airo:evidenceText "The new study looked at more than 2,700 Black men and 5,700 white men tested by University of Pennsylvania Health System doctors between 2010 and 2020." ;
    airo:sourceDocId "3040" .

<https://w3id.org/airo/incident/evidence/4020dcfb5c0a> a airo:Evidence ;
    airo:evidenceText "Christine Vogeli, director of evaluation and research at the Center for Population Health at Partners HealthCare, a nonprofit health system in Massachusetts, said when her team first tested the algorithm, they mapped the highest scores in their patient population and found them concentrated in some of the most affluent suburbs of Boston." ;
    airo:sourceDocId "2062" .

<https://w3id.org/airo/incident/evidence/45a9fab0d52b> a airo:Evidence ;
    airo:evidenceText "Ziad Obermeyer, who studies machine learning and health-care management at the University of California, Berkeley, and his team stumbled onto the problem while examining the impact of programmes that provide additional resources and closer medical supervision for people with multiple, sometimes overlapping, health problems." ;
    airo:sourceDocId "2500" .

<https://w3id.org/airo/incident/evidence/49afdfe71b04> a airo:Evidence ;
    airo:evidenceText "When Obermeyer and his team reported their findings to the algorithm’s developers — Optum of Eden Prairie, Minnesota — the company repeated their analysis and found the same results." ;
    airo:sourceDocId "2500" .

<https://w3id.org/airo/incident/evidence/4bb3bc9648e4> a airo:Evidence ;
    airo:evidenceText "The software used to predict patients' need for more intensive medical support was an outgrowth of the Affordable Care Act, which created financial incentives for health systems to keep people well instead of waiting to treat them when they got sick." ;
    airo:sourceDocId "2062" .

<https://w3id.org/airo/incident/evidence/4d7a42e13c8a> a airo:Evidence ;
    airo:evidenceText "While physicians also look at symptoms, lab work, X-rays and family histories of breathing problems, the pulmonary function testing can be an important part of diagnoses, “especially when patients are borderline,” said Dr. Albert Rizzo, the chief medical officer at the American Lung Association." ;
    airo:sourceDocId "3040" .

<https://w3id.org/airo/incident/evidence/5a43838df101> a airo:Evidence ;
    airo:evidenceText "Black men were likely underdiagnosed with lung problems because of bias in software, study suggests" ;
    airo:sourceDocId "3040" .

<https://w3id.org/airo/incident/evidence/68d3e747f156> a airo:Evidence ;
    airo:evidenceText "The new study looked at more than 2,700 Black men and 5,700 white men tested by University of Pennsylvania Health System doctors between 2010 and 2020." ;
    airo:sourceDocId "3040" .

<https://w3id.org/airo/incident/evidence/72f36212884a> a airo:Evidence ;
    airo:evidenceText "The new study looked at more than 2,700 Black men and 5,700 white men tested by University of Pennsylvania Health System doctors between 2010 and 2020." ;
    airo:sourceDocId "3040" .

<https://w3id.org/airo/incident/evidence/7dd4e168cf02> a airo:Evidence ;
    airo:evidenceText "Care for some of the sickest Americans is decided in part by algorithm. New research shows that software guiding care for tens of millions of people systematically privileges white patients over black patients." ;
    airo:sourceDocId "1262" .

<https://w3id.org/airo/incident/evidence/821c57902d14> a airo:Evidence ;
    airo:evidenceText "This study, published in JAMA Network Open, offers one of the first real-world examples of how the the issue may affect diagnosis and care for lung patients, said Dr. Darshali Vyas, a pulmonary care doctor at Massachusetts General Hospital." ;
    airo:sourceDocId "3040" .

<https://w3id.org/airo/incident/evidence/86fedab35ebc> a airo:Evidence ;
    airo:evidenceText "The problem was caught in an algorithm sold by a leading health services company, called Optum, to guide care decision-making for millions of people." ;
    airo:sourceDocId "2062" .

<https://w3id.org/airo/incident/evidence/885cd1ae8be8> a airo:Evidence ;
    airo:evidenceText "Earlier this year, the American Thoracic Society, which represents lung-care doctors, issued a statement recommending replacement of race-focused adjustments." ;
    airo:sourceDocId "3040" .

