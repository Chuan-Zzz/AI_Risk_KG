<https://w3id.org/airo/incident/Standard/ba79ed315821> a airo:Standard ;
    rdfs:label "Face Recognition Vendor Test (FRVT)" ;
    airo:confidenceScore "0.9"^^xsd:float ;
    airo:extractionMode "explicit" ;
    airo:hasDescription "Face Recognition Vendor Test (FRVT)" ;
    airo:hasEvidence <https://w3id.org/airo/incident/evidence/49a88b59703b> ;
    airo:hasSourceDocument <https://w3id.org/airo/incident/document/1458> .

<https://w3id.org/airo/incident/evidence/05ca414de0e2> a airo:Evidence ;
    airo:evidenceText "Commissioner Rohit Chopra issued a separate statement." ;
    airo:sourceDocId "1460" .

<https://w3id.org/airo/incident/evidence/0f25f247fb02> a airo:Evidence ;
    airo:evidenceText "The American Civil Liberties Union (ACLU) of Northern California said the business was an “egregious violation of people’s privacy,” as few knew their family photos were being used to build surveillance technology." ;
    airo:sourceDocId "1458" .

<https://w3id.org/airo/incident/evidence/193087ff9ed2> a airo:Evidence ;
    airo:evidenceText "Column: Millions of faces scanned without approval. We need rules for facial recognition" ;
    airo:sourceDocId "1459" .

<https://w3id.org/airo/incident/evidence/1b1cec947d0e> a airo:Evidence ;
    airo:evidenceText "Everalbum offered an app called “Ever” that allowed users to upload photos and videos from their mobile devices, computers, or social media accounts to be stored and organized using the company’s cloud-based storage service." ;
    airo:sourceDocId "1460" .

<https://w3id.org/airo/incident/evidence/313b52799077> a airo:Evidence ;
    airo:evidenceText "The proposed settlement requires Everalbum to delete: ... any facial recognition models or algorithms developed with Ever users’ photos or videos." ;
    airo:sourceDocId "1460" .

<https://w3id.org/airo/incident/evidence/3ab441c94c79> a airo:Evidence ;
    airo:evidenceText "Chopra has since been appointed by President Biden to serve as director of the Consumer Financial Protection Bureau." ;
    airo:sourceDocId "1459" .

<https://w3id.org/airo/incident/evidence/3d8ab50ab053> a airo:Evidence ;
    airo:evidenceText "That could be difficult to do for systems involving complex machine-learning models built from multiple sources of data." ;
    airo:sourceDocId "8647" .

<https://w3id.org/airo/incident/evidence/412d739576bf> a airo:Evidence ;
    airo:evidenceText "A Startup Will Nix Algorithms Built on Ill-Gotten Facial Data" ;
    airo:sourceDocId "8647" .

<https://w3id.org/airo/incident/evidence/443b6d1cf041> a airo:Evidence ;
    airo:evidenceText "The company also must delete all “face embeddings,” which it describes as “data reflecting facial features that can be used for facial recognition purposes” that were derived from users’ photos who didn’t give consent for their use." ;
    airo:sourceDocId "8646" .

<https://w3id.org/airo/incident/evidence/4ab116d3eb6d> a airo:Evidence ;
    airo:evidenceText "I recalled that fracas after the Federal Trade Commission announced the other day that it had reached a settlement with a San Francisco company called Everalbum, which offered online storage of photos and videos." ;
    airo:sourceDocId "1459" .

<https://w3id.org/airo/incident/evidence/50718024802a> a airo:Evidence ;
    airo:evidenceText "The company is alleged to have combined users' faces with facial images from other information to create four datasets that informed its facial recognition technology, which became the basis of a face detection service for enterprise customers." ;
    airo:sourceDocId "1461" .

<https://w3id.org/airo/incident/evidence/53365ec204ec> a airo:Evidence ;
    airo:evidenceText "California Company Settles FTC Allegations It Deceived Consumers about use of Facial Recognition in Photo Storage App" ;
    airo:sourceDocId "1460" .

<https://w3id.org/airo/incident/evidence/54a8d17c11f9> a airo:Evidence ;
    airo:evidenceText "The company, via its Ever app, scanned millions of facial images without customers’ knowledge and used the data to develop facial recognition software for corporate clients, the FTC said." ;
    airo:sourceDocId "1459" .

<https://w3id.org/airo/incident/evidence/6451a19010f1> a airo:Evidence ;
    airo:evidenceText "Amnesty International similarly called this week for a global ban on facial recognition systems." ;
    airo:sourceDocId "1459" .

<https://w3id.org/airo/incident/evidence/6b921bdcb456> a airo:Evidence ;
    airo:evidenceText "[8646] The Federal Trade Commission has reached a settlement with photo storage app Ever that it says used customers’ photos to develop facial recognition technology without telling them, the agency announced Monday." ;
    airo:sourceDocId "8646" .

<https://w3id.org/airo/incident/evidence/6d681276dc55> a airo:Evidence ;
    airo:evidenceText "Millions of faces scanned without approval. We need rules for facial recognition" ;
    airo:sourceDocId "5064" .

<https://w3id.org/airo/incident/evidence/703529a195a7> a airo:Evidence ;
    airo:evidenceText "“Since there aren’t federal laws on facial recognition, it seems pretty likely that there are other companies using this invasive technology without users’ knowledge or consent,” said Caitlin Seeley George, campaign director for the digital rights group Fight for the Future." ;
    airo:sourceDocId "1459" .

<https://w3id.org/airo/incident/evidence/714025c4ea0b> a airo:Evidence ;
    airo:evidenceText "In a phone interview with The Register, Adam Schwartz, senior staff attorney for the Electronic Frontier Foundation, said the EFF is generally supportive of this FTC remedy." ;
    airo:sourceDocId "8645" .

<https://w3id.org/airo/incident/evidence/7969a253a25e> a airo:Evidence ;
    airo:evidenceText "The startup used millions of the photos to develop technology offered to government agencies and other customers under the brand Paravision." ;
    airo:sourceDocId "8647" .

<https://w3id.org/airo/incident/evidence/7eb2ecbeb1e4> a airo:Evidence ;
    airo:evidenceText "Ever, once accused of building facial recognition tech using customer data, shuts down consumer app" ;
    airo:sourceDocId "1458" .

<https://w3id.org/airo/incident/evidence/80d5d71f9bae> a airo:Evidence ;
    airo:evidenceText "[8645] A California-based facial recognition biz has been directed by the US Federal Trade Commission to delete the AI models and algorithms that it developed by harvesting people's photos and videos without permission..." ;
    airo:sourceDocId "8645" .

<https://w3id.org/airo/incident/evidence/83e6c34e9625> a airo:Evidence ;
    airo:evidenceText "Privacy pilfering project punished by FTC purge penalty: AI upstart told to delete data and algorithms" ;
    airo:sourceDocId "8645" .

<https://w3id.org/airo/incident/evidence/8433016220fc> a airo:Evidence ;
    airo:evidenceText "[1460] In its complaint, the FTC alleges that, in February 2017, Everalbum launched a new feature in the Ever app, called “Friends,” that used facial recognition technology to group users’ photos by the faces of the people who appear in them and allowed users to “tag” people by name." ;
    airo:sourceDocId "1460" .

<https://w3id.org/airo/incident/evidence/86f4553da035> a airo:Evidence ;
    airo:evidenceText "[1461] According to FTC Commissioner Rohit Chopra, when Google and YouTube agreed to pay $170m over allegations the companies had collected data from children without parental consent, the FTC settlement 'allowed Google and YouTube to profit from its conduct, even after paying a civil penalty.'" ;
    airo:sourceDocId "1461" .

<https://w3id.org/airo/incident/evidence/89d5eebc3b7b> a airo:Evidence ;
    airo:evidenceText "Privacy pilfering project punished by FTC purge penalty: AI upstart told to delete data and algorithms" ;
    airo:sourceDocId "1461" .

<https://w3id.org/airo/incident/evidence/8e8a0f047186> a airo:Evidence ;
    airo:evidenceText "FTC settles with photo storage app that pivoted to facial recognition" ;
    airo:sourceDocId "8646" .

<https://w3id.org/airo/incident/evidence/9446e866ba6a> a airo:Evidence ;
    airo:evidenceText "The company allegedly let users in certain regions – Illinois, Texas, Washington, and the EU – make that choice, but automatically activated the feature for those located elsewhere." ;
    airo:sourceDocId "8645" .

<https://w3id.org/airo/incident/evidence/984345bc3af9> a airo:Evidence ;
    airo:evidenceText "They told consumers they'd do one thing with their photography and turned around and used it for a facial surveillance technology." ;
    airo:sourceDocId "8645" .

<https://w3id.org/airo/incident/evidence/9c2ecb4023cf> a airo:Evidence ;
    airo:evidenceText "“Face recognition and computer vision technology have the potential to improve our lives in profound ways and we take the gravity of its impacts extremely seriously,” the spokesperson continued, adding that Paravision has been recognized as an “accurate provider” of face recognition technology." ;
    airo:sourceDocId "8646" .

<https://w3id.org/airo/incident/evidence/9d1de7240eec> a airo:Evidence ;
    airo:evidenceText "David Vladeck, a former director of the FTC’s Bureau of Consumer Protection and a law professor at Georgetown, says Monday’s settlement is consistent with prior ones that required deletion of data." ;
    airo:sourceDocId "8647" .

<https://w3id.org/airo/incident/evidence/a487dd865cd5> a airo:Evidence ;
    airo:evidenceText "The watchdog agency claims the app deployed facial recognition code to organize users' photos by default, without permission." ;
    airo:sourceDocId "1461" .

<https://w3id.org/airo/incident/evidence/ab60c7f6d227> a airo:Evidence ;
    airo:evidenceText "The agency may gain considerable new legal powers if Democrats pass the first federal US privacy law, as some, like US senator Maria Cantwell (D-Washington), have proposed." ;
    airo:sourceDocId "8647" .

<https://w3id.org/airo/incident/evidence/acdc1f268f20> a airo:Evidence ;
    airo:evidenceText "A California-based facial recognition biz has been directed by the US Federal Trade Commission to delete the AI models and algorithms that it developed by harvesting people's photos and videos without permission, a remedy that suggests privacy violators may no longer be allowed to benefit from ill-gotten data." ;
    airo:sourceDocId "8645" .

<https://w3id.org/airo/incident/evidence/b4e1767042a6> a airo:Evidence ;
    airo:evidenceText "The company, via its Ever app, scanned millions of facial images without customers’ knowledge and used the data to develop facial recognition software for corporate clients, the FTC said." ;
    airo:sourceDocId "5064" .

<https://w3id.org/airo/incident/evidence/ca25ac6478a7> a airo:Evidence ;
    airo:evidenceText "[1460] In its complaint, the FTC alleges that, in February 2017, Everalbum launched a new feature in the Ever app, called 'Friends,' that used facial recognition technology to group users' photos by the faces of the people who appear in them and allowed users to 'tag' people by name." ;
    airo:sourceDocId "1460" .

<https://w3id.org/airo/incident/evidence/cf69ab631a1b> a airo:Evidence ;
    airo:evidenceText "[8645] A California-based facial recognition biz has been directed by the US Federal Trade Commission to delete the AI models and algorithms that it developed by harvesting people's photos and videos without permission, a remedy that suggests privacy violators may no longer be allowed to benefit from ill-gotten data." ;
    airo:sourceDocId "8645" .

<https://w3id.org/airo/incident/evidence/d248ccd7c10e> a airo:Evidence ;
    airo:evidenceText "Amnesty International similarly called this week for a global ban on facial recognition systems." ;
    airo:sourceDocId "5064" .

<https://w3id.org/airo/incident/evidence/dd86f478d837> a airo:Evidence ;
    airo:evidenceText "In 2013, software company DesignerWare and seven rent-to-own retailers agreed to delete geotracking data gathered without consent from spyware installed on laptops." ;
    airo:sourceDocId "8647" .

<https://w3id.org/airo/incident/evidence/eb41d92d17c6> a airo:Evidence ;
    airo:evidenceText "Everalbum, which shut down Ever in August and rebranded itself as Paravision AI, is also prohibited from misrepresenting how it collects and uses personal information and how it protects users’ privacy." ;
    airo:sourceDocId "8646" .

<https://w3id.org/airo/incident/evidence/f1b1b83cce54> a airo:Evidence ;
    airo:evidenceText "Seeley George at Fight for the Future said, “Congress needs to act now to ban facial recognition, and should absolutely stay away from industry-friendly regulations that could speed up adoption of the technology and make it even more pervasive.”" ;
    airo:sourceDocId "5064" .

<https://w3id.org/airo/incident/evidence/f57851b55466> a airo:Evidence ;
    airo:evidenceText "Last year, NBC News reported the company had been using its customers’ photos to develop facial recognition technology that it turned around and offered for sale by way of the Ever API to business clients, including law enforcement and the military." ;
    airo:sourceDocId "1458" .

<https://w3id.org/airo/incident/evidence/fa7a470e5f0b> a airo:Evidence ;
    airo:evidenceText "The Federal Trade Commission said Everalbum had agreed to settle charges that it had applied face-recognition technology to images uploaded to a photo app without users’ permission and retained them after telling users they would be deleted." ;
    airo:sourceDocId "8647" .

<https://w3id.org/airo/incident/evidence/ffcd6ad5f30c> a airo:Evidence ;
    airo:evidenceText "The startup used millions of the photos to develop technology offered to government agencies and other customers under the brand Paravision." ;
    airo:sourceDocId "8647" .

