<https://w3id.org/airo/incident/Vulnerability/17c887438b02> a airo:Vulnerability ;
    rdfs:label "Lack of robustness and reliability in generative AI for factual legal research" ;
    airo:confidenceScore "0.85"^^xsd:float ;
    airo:extractionMode "abstracted" ;
    airo:hasEvidence <https://w3id.org/airo/incident/evidence/9a6901afd26a> ;
    airo:hasSourceDocument <https://w3id.org/airo/incident/document/2827> .

<https://w3id.org/airo/incident/evidence/0186ba123fbf> a airo:Evidence ;
    airo:evidenceText "[2810] Lawyer Steven A. Schwartz admitted in an affidavit that he had used OpenAI’s chatbot for his research." ;
    airo:sourceDocId "2810" .

<https://w3id.org/airo/incident/evidence/0248a5faf769> a airo:Evidence ;
    airo:evidenceText "But this wasn't even the case with a bar-certified lawyer, Mr. Steven A. Schwartz." ;
    airo:sourceDocId "2839" .

<https://w3id.org/airo/incident/evidence/02c931e95264> a airo:Evidence ;
    airo:evidenceText "[2834] ...other generative AI models like... Alphabet Inc.’s Google Bard..." ;
    airo:sourceDocId "2834" .

<https://w3id.org/airo/incident/evidence/03f2bb3c179f> a airo:Evidence ;
    airo:evidenceText "Both Schwartz and lawyer Peter LoDuca, who was not aware that ChatGPT had been used while researching the case, are facing a hearing on June 8 about the incident." ;
    airo:sourceDocId "2826" .

<https://w3id.org/airo/incident/evidence/05e497f49f09> a airo:Evidence ;
    airo:evidenceText "...their client, Roberto Mata, seeks to hold the airline Avianca responsible for an injury he says he sustained when a metal serving cart hit his knee during an August 2019 flight from El Salvador to New York." ;
    airo:sourceDocId "2949" .

<https://w3id.org/airo/incident/evidence/076939bb2b43> a airo:Evidence ;
    airo:evidenceText "Steven A Schwartz, an attorney with over 30 years of experience, utilized ChatGPT to search for similar prior cases, according to BBC." ;
    airo:sourceDocId "2846" .

<https://w3id.org/airo/incident/evidence/084571fb3f47> a airo:Evidence ;
    airo:evidenceText "A lawyer from New York is now facing a court hearing because his law firm utilized the AI tool ChatGPT for conducting legal research." ;
    airo:sourceDocId "2846" .

<https://w3id.org/airo/incident/evidence/112e9f2bf170> a airo:Evidence ;
    airo:evidenceText "[2834] ...it is well known that OpenAI’s chatGPT and other generative AI models like Microsoft Corp’s Bing AI..." ;
    airo:sourceDocId "2834" .

<https://w3id.org/airo/incident/evidence/11827be35017> a airo:Evidence ;
    airo:evidenceText "A lawyer in New York has found himself in trouble with a judge after he submitted legal research which had been created by artificial intelligence (AI) chatbot ChatGPT." ;
    airo:sourceDocId "2826" .

<https://w3id.org/airo/incident/evidence/12d7d17b1acc> a airo:Evidence ;
    airo:evidenceText "US District Judge Kevin Castel confirmed, “Six of the submitted cases appear to be bogus judicial decisions with bogus quotes and bogus internal citations,” and set up a hearing as he considers sanctions for the plaintiff’s lawyers." ;
    airo:sourceDocId "2810" .

<https://w3id.org/airo/incident/evidence/13a02a1338a8> a airo:Evidence ;
    airo:evidenceText "When Avianca asked a Manhattan judge to dismiss the lawsuit based on the statute of limitations, Mata's lawyer, Steven A. Schwartz, submitted a brief based on research done by ChatGPT." ;
    airo:sourceDocId "2812" .

<https://w3id.org/airo/incident/evidence/1483b2aa185c> a airo:Evidence ;
    airo:evidenceText "US District Judge Kevin Castel wrote in an order yesterday." ;
    airo:sourceDocId "2977" .

<https://w3id.org/airo/incident/evidence/14d8ad32ca5f> a airo:Evidence ;
    airo:evidenceText "[2837] This report comes at a time when tech industry leaders like Amazon, Microsoft, Alphabet and Meta are doubling down on future-fit innovations in generative AI..." ;
    airo:sourceDocId "2837" .

<https://w3id.org/airo/incident/evidence/15295e2923cd> a airo:Evidence ;
    airo:evidenceText "[2834] ...other generative AI models like... Alphabet Inc.’s Google Bard..." ;
    airo:sourceDocId "2834" .

<https://w3id.org/airo/incident/evidence/1b50c798f819> a airo:Evidence ;
    airo:evidenceText "[2834] ...it is well known that OpenAI’s chatGPT and other generative AI models like Microsoft Corp’s Bing AI..." ;
    airo:sourceDocId "2834" .

<https://w3id.org/airo/incident/evidence/205eeb4b6db1> a airo:Evidence ;
    airo:evidenceText "[2834] ...it is well known that OpenAI’s chatGPT and other generative AI models like Microsoft Corp’s Bing AI..." ;
    airo:sourceDocId "2834" .

<https://w3id.org/airo/incident/evidence/23734cc670ce> a airo:Evidence ;
    airo:evidenceText "Judge Kevin Castel then asked Mata’s lawyers to explain what had been submitted." ;
    airo:sourceDocId "2835" .

<https://w3id.org/airo/incident/evidence/24e2e7d69e91> a airo:Evidence ;
    airo:evidenceText "\"The Court is presented with an unprecedented circumstance,\" wrote U.S. District Judge Kevin Castel in a show cause notice." ;
    airo:sourceDocId "2839" .

<https://w3id.org/airo/incident/evidence/2813d715ca5e> a airo:Evidence ;
    airo:evidenceText "[2834] ...other generative AI models like... Alphabet Inc.’s Google Bard..." ;
    airo:sourceDocId "2834" .

<https://w3id.org/airo/incident/evidence/282e4460d872> a airo:Evidence ;
    airo:evidenceText "In a bizarre case surrounding Mata Vs. Avianca, which involved a customer suing the airline for a knee injury caused by a serving cart, the use of chatGPT took a surprising turn." ;
    airo:sourceDocId "2834" .

<https://w3id.org/airo/incident/evidence/2a7b14e68b71> a airo:Evidence ;
    airo:evidenceText "[2834] ...other generative AI models like... Alphabet Inc.’s Google Bard..." ;
    airo:sourceDocId "2834" .

<https://w3id.org/airo/incident/evidence/2b4523e44886> a airo:Evidence ;
    airo:evidenceText "[2810] Lawyer Steven A. Schwartz admitted in an affidavit that he had used OpenAI’s chatbot for his research." ;
    airo:sourceDocId "2810" .

<https://w3id.org/airo/incident/evidence/2e0ac9e77bc0> a airo:Evidence ;
    airo:evidenceText "[2810] Lawyer Steven A. Schwartz admitted in an affidavit that he had used OpenAI’s chatbot for his research." ;
    airo:sourceDocId "2810" .

<https://w3id.org/airo/incident/evidence/2eb730797988> a airo:Evidence ;
    airo:evidenceText "A New York lawyer has been forced to admit he used the artificial intelligence tool ChatGPT to carry out legal research after it referenced several made-up court cases." ;
    airo:sourceDocId "2851" .

<https://w3id.org/airo/incident/evidence/2f35b104923e> a airo:Evidence ;
    airo:evidenceText "A lawyer asked ChatGPT for examples of cases that supported an argument they were trying to make." ;
    airo:sourceDocId "2848" .

<https://w3id.org/airo/incident/evidence/317dab027bfb> a airo:Evidence ;
    airo:evidenceText "Looking at what he described as a legal submission full of “bogus judicial decisions, with bogus quotes and bogus internal citations,” and describing the situation as unprecedented, Judge Castel has ordered a hearing for early next month to consider possible penalties." ;
    airo:sourceDocId "2827" .

<https://w3id.org/airo/incident/evidence/357e59a67ae7> a airo:Evidence ;
    airo:evidenceText "Schwartz also said that Peter LoDuca, the attorney named as counsel of record on the case, had no part in drafting the document that contained false sources." ;
    airo:sourceDocId "2818" .

<https://w3id.org/airo/incident/evidence/365055b6e94b> a airo:Evidence ;
    airo:evidenceText "A lawyer who relied on ChatGPT to prepare a court filing on behalf of a man suing an airline is now all too familiar with the artificial intelligence tool's shortcomings — including its propensity to invent facts." ;
    airo:sourceDocId "2812" .

<https://w3id.org/airo/incident/evidence/37aa5f7bf973> a airo:Evidence ;
    airo:evidenceText "Mata and his attorney, Peter LoDuca, alleged that Avianca caused Mata personal injuries when he was \"struck by a metal serving cart\" on board a 2019 flight bound for New York." ;
    airo:sourceDocId "2829" .

<https://w3id.org/airo/incident/evidence/3a217795adc6> a airo:Evidence ;
    airo:evidenceText "[2810] Lawyer Steven A. Schwartz admitted in an affidavit that he had used OpenAI’s chatbot for his research." ;
    airo:sourceDocId "2810" .

<https://w3id.org/airo/incident/evidence/3a2733b8793d> a airo:Evidence ;
    airo:evidenceText "After the airline asked a Manhattan judge to toss out the case because the statute of limitations had expired, Mata's lawyer Steven Schwartz submitted a 10-page brief featuring half a dozen relevant court decisions." ;
    airo:sourceDocId "2833" .

<https://w3id.org/airo/incident/evidence/3a6c03974049> a airo:Evidence ;
    airo:evidenceText "[2834] ...other generative AI models like... Alphabet Inc.’s Google Bard..." ;
    airo:sourceDocId "2834" .

<https://w3id.org/airo/incident/evidence/3c09f2b4854c> a airo:Evidence ;
    airo:evidenceText "Judge Kevin Castel was skeptical of the brief when it was submitted." ;
    airo:sourceDocId "2838" .

<https://w3id.org/airo/incident/evidence/3c41363a0ed9> a airo:Evidence ;
    airo:evidenceText "By April 18, 2022, Peter Lo Duca, counsel of record for plaintiff, shall file an affidavit annexing copies of the following cases cited in his submission to this Court: as set forth herein." ;
    airo:sourceDocId "2848" .

<https://w3id.org/airo/incident/evidence/3ca498a886f1> a airo:Evidence ;
    airo:evidenceText "[2810] Lawyer Steven A. Schwartz admitted in an affidavit that he had used OpenAI’s chatbot for his research." ;
    airo:sourceDocId "2810" .

<https://w3id.org/airo/incident/evidence/3ed41b8f57a1> a airo:Evidence ;
    airo:evidenceText "Lawyers for Avianca first brought the concerns to the judge overseeing the case." ;
    airo:sourceDocId "2819" .

<https://w3id.org/airo/incident/evidence/40cf5160d71a> a airo:Evidence ;
    airo:evidenceText "Peter LoDuca, another lawyer at Schwartz’s firm, argued in a separate affidavit that “sanctions are not appropriate in this instance as there was no bad faith nor intent to deceive either the Court or the defendant.”" ;
    airo:sourceDocId "2819" .

<https://w3id.org/airo/incident/evidence/40d8eabe534b> a airo:Evidence ;
    airo:evidenceText "Despite ChatGPT’s widely known warnings that it can sometimes produce incorrect information, Schwartz defended himself in an affidavit attesting that he was “unaware that its content could be false.”" ;
    airo:sourceDocId "2838" .

<https://w3id.org/airo/incident/evidence/423bcea26198> a airo:Evidence ;
    airo:evidenceText "Judge P Kevin Castel, in New York, examined them." ;
    airo:sourceDocId "2852" .

<https://w3id.org/airo/incident/evidence/43d74c8f82f2> a airo:Evidence ;
    airo:evidenceText "But when the airline company pushed for the case to be tossed, the man's legal team---including a lawyer by the name of Steven A. Schwartz---pointed to a number of prior court rulings they argued supported their stance." ;
    airo:sourceDocId "2845" .

<https://w3id.org/airo/incident/evidence/4790d1894348> a airo:Evidence ;
    airo:evidenceText "Here's a neat summary: So, wait. They file a brief that cites cases fabricated by ChatGPT." ;
    airo:sourceDocId "2848" .

<https://w3id.org/airo/incident/evidence/47ad7cf0ad15> a airo:Evidence ;
    airo:evidenceText "[2810] Lawyer Steven A. Schwartz admitted in an affidavit that he had used OpenAI’s chatbot for his research." ;
    airo:sourceDocId "2810" .

<https://w3id.org/airo/incident/evidence/48450e77f4f6> a airo:Evidence ;
    airo:evidenceText "Schwartz isn’t admitted to practice in the Southern District of New York but originally filed the lawsuit before it was moved to that court and says he continued to work on it." ;
    airo:sourceDocId "2810" .

<https://w3id.org/airo/incident/evidence/4c1bae1e32f9> a airo:Evidence ;
    airo:evidenceText "The case involved a man named Roberto Mata suing Avianca, claiming he was injured when a metal service cart struck his knee during a flight." ;
    airo:sourceDocId "2805" .

<https://w3id.org/airo/incident/evidence/4d46e7e0b5a9> a airo:Evidence ;
    airo:evidenceText "he used an artificial intelligence chatbot to help write the Manhattan federal court filing." ;
    airo:sourceDocId "2809" .

<https://w3id.org/airo/incident/evidence/4df94513642d> a airo:Evidence ;
    airo:evidenceText "Judge Kevin Castel wrote in an order demanding an explanation, per the BBC." ;
    airo:sourceDocId "2824" .

<https://w3id.org/airo/incident/evidence/4e1f8ba90275> a airo:Evidence ;
    airo:evidenceText "US District Judge Kevin Castel reviewed the submissions and confirmed that six of the cases included in the lawyer's arguments were based on fabricated judicial decisions, complete with false quotes and internal citations." ;
    airo:sourceDocId "2847" .

<https://w3id.org/airo/incident/evidence/4e51bbd41e03> a airo:Evidence ;
    airo:evidenceText "Bard, Google’s AI chatbot, made up a fact about the James Webb Space Telescope in its first demo." ;
    airo:sourceDocId "8248" .

<https://w3id.org/airo/incident/evidence/4ec053adcc7c> a airo:Evidence ;
    airo:evidenceText "Mata's lawsuit against the airline was originally filed in a New York state court, but Avianca had it moved to the federal court." ;
    airo:sourceDocId "2811" .

<https://w3id.org/airo/incident/evidence/505af30cbf58> a airo:Evidence ;
    airo:evidenceText "[2810] Lawyer Steven A. Schwartz admitted in an affidavit that he had used OpenAI’s chatbot for his research." ;
    airo:sourceDocId "2810" .

<https://w3id.org/airo/incident/evidence/511d8c8a5218> a airo:Evidence ;
    airo:evidenceText "Schwartz ― an attorney with Levidow, Levidow & Oberman who’s been licensed in New York for more than 30 years ― then confessed in an affidavit that he’d used ChatGPT to produce the cases in support of his client and was “unaware of the possibility that its content could be false.”" ;
    airo:sourceDocId "2819" .

<https://w3id.org/airo/incident/evidence/56b73840d741> a airo:Evidence ;
    airo:evidenceText "[2810] Lawyer Steven A. Schwartz admitted in an affidavit that he had used OpenAI’s chatbot for his research." ;
    airo:sourceDocId "2810" .

<https://w3id.org/airo/incident/evidence/5730cadc3bc5> a airo:Evidence ;
    airo:evidenceText "[2834] ...it is well known that OpenAI’s chatGPT and other generative AI models like Microsoft Corp’s Bing AI..." ;
    airo:sourceDocId "2834" .

<https://w3id.org/airo/incident/evidence/57395cabaa03> a airo:Evidence ;
