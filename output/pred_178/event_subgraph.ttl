        <https://w3id.org/airo/incident/evidence/77604f4a4210> ;
    airo:hasSourceDocument <https://w3id.org/airo/incident/document/1247>,
        <https://w3id.org/airo/incident/document/2309>,
        <https://w3id.org/airo/incident/document/2626>,
        <https://w3id.org/airo/incident/document/3843> ;
    airo:hasSupportCount 4 ;
    airo:provides <https://w3id.org/airo/incident/AISystem/c5e4c93af0a9> .

<https://w3id.org/airo/incident/evidence/05c323cd8706> a airo:Evidence ;
    airo:evidenceText "[3844] ShotSpotter, a system the Police Department uses to detect gunfire, is overwhelmingly inaccurate and leads officers to spend hundreds of hours each month investigating nonexistent shots." ;
    airo:sourceDocId "3844" .

<https://w3id.org/airo/incident/evidence/9af5a0521acb> a airo:Evidence ;
    airo:evidenceText "[2626] A pair of deadly shootings recently went undetected by ShotSpotter, the controversial gunshot detection technology currently being piloted by the city of Durham." ;
    airo:sourceDocId "2626" .

<https://w3id.org/airo/incident/evidence/f578d159038d> a airo:Evidence ;
    airo:evidenceText "[2473] The Durham Police Department hopes ShotSpotter will help officers quickly respond to gunfire." ;
    airo:sourceDocId "2473" .

<https://w3id.org/airo/incident/evidence/1e0ee21f6f61> a airo:Evidence ;
    airo:evidenceText "Durham Mayor Pro Tempore Mark-Anthony Middleton, an early advocate for piloting the technology in Durham, defended its continued usage." ;
    airo:sourceDocId "2626" .

<https://w3id.org/airo/incident/evidence/29531c0e9b8c> a airo:Evidence ;
    airo:evidenceText "A spokeswoman for Mayor Eric Adams, Kayla Mamelak, called ShotSpotter \"one of many tools we use to help fight crime to keep our city safe.\"" ;
    airo:sourceDocId "3844" .

<https://w3id.org/airo/incident/evidence/2d58a8b82efc> a airo:Evidence ;
    airo:evidenceText "Chicago's mayor campaigned on a promise to jettison the technology and blamed it for the death of an unarmed 13-year old shot by officers responding to an alert in 2021." ;
    airo:sourceDocId "3844" .

<https://w3id.org/airo/incident/evidence/5bd08444735c> a airo:Evidence ;
    airo:evidenceText "The Police Department \"is wasting precious time and money on this technology and needs to do a better job managing its resources,\" the comptroller, Brad Lander, said in a statement." ;
    airo:sourceDocId "3844" .

<https://w3id.org/airo/incident/evidence/7cdb0a8aeda0> a airo:Evidence ;
    airo:evidenceText "After being reelected, Durham District Attorney Satana Deberry was sworn into office on Tuesday." ;
    airo:sourceDocId "2309" .

<https://w3id.org/airo/incident/evidence/91e9a6027d4e> a airo:Evidence ;
    airo:evidenceText "\"However, my understanding is that there wasn't a corresponding ShotSpotter report,\" said Mayor Pro Tem Mark-Anthony Middleton." ;
    airo:sourceDocId "2309" .

<https://w3id.org/airo/incident/evidence/a625baf47e63> a airo:Evidence ;
    airo:evidenceText "In July 2019, at the request of ShotSpotter, The Policing Project at NYU Law School conducted a Privacy Audit and Assessment of ShotSpotter, Inc.'s Gunshot Detection Technology." ;
    airo:sourceDocId "3843" .

<https://w3id.org/airo/incident/evidence/bf2f3eeae58d> a airo:Evidence ;
    airo:evidenceText "New York must decide before December whether to renew its contract with SoundThinking, the California company that owns the system, and the audit advises officials to decline until the system can be fully evaluated." ;
    airo:sourceDocId "3844" .

<https://w3id.org/airo/incident/evidence/cbb62952fe16> a airo:Evidence ;
    airo:evidenceText "Durham Mayor Pro-Tem Mark-Anthony Middleton." ;
    airo:sourceDocId "2473" .

<https://w3id.org/airo/incident/evidence/fd71de1cc1b0> a airo:Evidence ;
    airo:evidenceText "Mayor Lou Rosamilia said he backed the decision to end participation in ShotSpotter." ;
    airo:sourceDocId "1247" .

<https://w3id.org/airo/incident/evidence/16bb91ea7a0c> a airo:Evidence ;
    airo:evidenceText "The displeasure with the acoustic surveillance system is so prevalent that Tedesco and Officer Robert Fitzgerald, the Troy Police Benevolent Association president, who usually disagree on issues, both agree that it's time is over." ;
    airo:sourceDocId "1247" .

<https://w3id.org/airo/incident/evidence/00cd8e757c6d> a airo:Evidence ;
    airo:evidenceText "A ShotSpotter spokeswoman could not be immediately reached Tuesday night for comment." ;
    airo:sourceDocId "1247" .

<https://w3id.org/airo/incident/evidence/29a6ab44daad> a airo:Evidence ;
    airo:evidenceText "A spokesperson for the Durham Police Department told CBS17 that police did not receive an alert for a Feb. 5 shooting at Fay and Juniper Streets and a shooting last Thursday on Park Avenue." ;
    airo:sourceDocId "2626" .

<https://w3id.org/airo/incident/evidence/3fc4c560a8e8> a airo:Evidence ;
    airo:evidenceText "According to its monthly report for January, ShotSpotter sent the Durham Police 197 alerts, detecting 998 rounds fired." ;
    airo:sourceDocId "2626" .

<https://w3id.org/airo/incident/evidence/54fbea258cbc> a airo:Evidence ;
    airo:evidenceText "Why didn't ShotSpotter sensors notify Durham police of weekend's mass shooting?" ;
    airo:sourceDocId "2309" .

<https://w3id.org/airo/incident/evidence/77604f4a4210> a airo:Evidence ;
    airo:evidenceText "The system was created and is managed by ShotSpotter, Inc." ;
    airo:sourceDocId "3843" .

<https://w3id.org/airo/incident/evidence/a0462caecb05> a airo:Evidence ;
    airo:evidenceText "The audit found that the New York City Police Department (NYPD) ensures that the billing, invoices, and payments to ShotSpotter are accurate, and that ShotSpotter generally meets its currently specified contractual obligations." ;
    airo:sourceDocId "3843" .

<https://w3id.org/airo/incident/evidence/0398d7415e74> a airo:Evidence ;
    airo:evidenceText "Retired Chief Nicholas Kaiser pushed for the installation of the system, which was supported by former Mayor Harry Tutunjian." ;
    airo:sourceDocId "1247" .

<https://w3id.org/airo/incident/evidence/bb126f9f2a35> a airo:Evidence ;
    airo:evidenceText "A pair of deadly shootings recently went undetected by ShotSpotter, the controversial gunshot detection technology currently being piloted by the city of Durham." ;
    airo:sourceDocId "2626" .

<https://w3id.org/airo/incident/evidence/cca463aa97ac> a airo:Evidence ;
    airo:evidenceText "Daniel Schwarz, a technology and privacy strategist for the New York Civil Liberties Union, said that he hoped the audit would start a conversation about how the technology is used in New York." ;
    airo:sourceDocId "3844" .

<https://w3id.org/airo/incident/evidence/ee7816a03eeb> a airo:Evidence ;
    airo:evidenceText "The Durham Police Department hopes ShotSpotter will help officers quickly respond to gunfire." ;
    airo:sourceDocId "2473" .

<https://w3id.org/airo/incident/evidence/fddde68b3f47> a airo:Evidence ;
    airo:evidenceText "\"We are discontinuing Shot-Spotter,\" Chief John Tedesco said Tuesday night during the Public Safety Committee's review of the police department budget for 2013." ;
    airo:sourceDocId "1247" .

<https://w3id.org/airo/incident/evidence/8b21b2a2be9d> a airo:Evidence ;
    airo:evidenceText "ShotSpotter, a system the Police Department uses to detect gunfire, is overwhelmingly inaccurate and leads officers to spend hundreds of hours each month investigating nonexistent shots, according to an audit the New York City comptroller released Thursday." ;
    airo:sourceDocId "3844" .

