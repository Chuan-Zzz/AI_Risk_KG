<https://w3id.org/airo/incident/evidence/0f0d30212ddf> a airo:Evidence ;
    airo:evidenceText "2 self-driving cars owned by Google and Delphi only just escaped a collision on Californian roads earlier this week." ;
    airo:sourceDocId "5290" .

<https://w3id.org/airo/incident/evidence/10b2ee98ef53> a airo:Evidence ;
    airo:evidenceText "Auto parts maker Delphi says that its experimental self-driving car was on a street in Silicon Valley when the near accident occurred as both car moved in to the same lane of traffic." ;
    airo:sourceDocId "5292" .

<https://w3id.org/airo/incident/evidence/ed2ebcb2e529> a airo:Evidence ;
    airo:evidenceText "A car from Google's fleet reportedly cut off an Audi being tested by rival Delphi Automotive during a lane change." ;
    airo:sourceDocId "5290" .

<https://w3id.org/airo/incident/evidence/f267d6c263e1> a airo:Evidence ;
    airo:evidenceText "Google agreed." ;
    airo:sourceDocId "5292" .

<https://w3id.org/airo/incident/evidence/486f575d4cb1> a airo:Evidence ;
    airo:evidenceText "The firm told Reuters on Friday that the news wire's earlier report – which earlier this week had quoted John Absmeier, Delphi's Silicon Valley lab director, describing a close call with Google's car – was wrong." ;
    airo:sourceDocId "267" .

