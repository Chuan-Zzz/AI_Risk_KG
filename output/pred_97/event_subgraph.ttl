<https://w3id.org/airo/incident/Vulnerability/f8cb9f92d728> a airo:Vulnerability ;
    rdfs:label "lack of data subject consent for biometric data processing" ;
    airo:confidenceScore "0.95"^^xsd:float ;
    airo:extractionMode "abstracted" ;
    airo:hasEvidence <https://w3id.org/airo/incident/evidence/bf8fb4129525> ;
