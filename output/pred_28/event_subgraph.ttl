<https://w3id.org/airo/incident/evidence/01c009b5f6bf> a airo:Evidence ;
    airo:evidenceText "(News Focus) Chatbot Luda controversy leave questions over AI ethics, data collection" ;
    airo:sourceDocId "1234" .

<https://w3id.org/airo/incident/evidence/04689987e9c3> a airo:Evidence ;
    airo:evidenceText "AI Chatbot Shut Down After Learning to Talk Like a Racist Asshole" ;
    airo:sourceDocId "1229" .

<https://w3id.org/airo/incident/evidence/07043605b746> a airo:Evidence ;
    airo:evidenceText "The bot learned from some 10 billion real-life conversations between young couples drawn from the country’s popular messenger app KakaoTalk." ;
    airo:sourceDocId "1237" .

<https://w3id.org/airo/incident/evidence/087572e3af9f> a airo:Evidence ;
    airo:evidenceText "Chatbot Gone Awry Starts Conversations About AI Ethics in South Korea" ;
    airo:sourceDocId "1235" .

<https://w3id.org/airo/incident/evidence/08d051d6e0af> a airo:Evidence ;
    airo:evidenceText "Chatbot shut down after saying it 'hates lesbians' and using racist slurs" ;
    airo:sourceDocId "2155" .

<https://w3id.org/airo/incident/evidence/0d0ff84f002f> a airo:Evidence ;
    airo:evidenceText "According to Yonhap News Agency, Lee Luda was trained on conversations from another Scatter Lab app called Science of Love that analyzes the level of affection in conversations between young partners." ;
    airo:sourceDocId "9155" .

<https://w3id.org/airo/incident/evidence/0e3f4a920c96> a airo:Evidence ;
    airo:evidenceText "In Tensorflow Korea, an A.I. developer Facebook community, a developer revealed that this KakaoTalk data containing private information had been available on Github for almost six months." ;
    airo:sourceDocId "1238" .

<https://w3id.org/airo/incident/evidence/13a7cd13de97> a airo:Evidence ;
    airo:evidenceText "Lee Luda was trained on conversations from another Scatter Lab app called Science of Love that analyzes the level of affection in conversations between young partners." ;
    airo:sourceDocId "1232" .

<https://w3id.org/airo/incident/evidence/1b427d6bd2c0> a airo:Evidence ;
    airo:evidenceText "[1222] The government organizations -- the Personal Information Protection Committee and the Korea Internet & Security Agency -- are also separately investigating whether the service violated the personal information protection law." ;
    airo:sourceDocId "1222" .

<https://w3id.org/airo/incident/evidence/1bb9fd4e82aa> a airo:Evidence ;
    airo:evidenceText "South Korean chatbot 'Lee Luda' killed off for spewing hate" ;
    airo:sourceDocId "9155" .

<https://w3id.org/airo/incident/evidence/2663957faa7e> a airo:Evidence ;
    airo:evidenceText "Korean app-maker Scatter Lab fined for using private data to create homophobic and lewd chatbot" ;
    airo:sourceDocId "9157" .

<https://w3id.org/airo/incident/evidence/28eac23005b2> a airo:Evidence ;
    airo:evidenceText "This revelation emerged when the chatbot began exposing people’s names, nicknames, and home addresses in its responses." ;
    airo:sourceDocId "1238" .

<https://w3id.org/airo/incident/evidence/2b0974f6925a> a airo:Evidence ;
    airo:evidenceText "This was taken from Scatter Lab’s Science of Love app, which analyses the level of affection in conversations between young partners, according to Yonhap." ;
    airo:sourceDocId "2155" .

<https://w3id.org/airo/incident/evidence/303f12d8b22d> a airo:Evidence ;
    airo:evidenceText "2 years later, Amazon’s AI recruitment tool met the same fate after it was found guilty of gender bias." ;
    airo:sourceDocId "1233" .

<https://w3id.org/airo/incident/evidence/32d5174d72a6> a airo:Evidence ;
    airo:evidenceText "Korea’s controversial AI chatbot Luda to be shut down temporarily" ;
    airo:sourceDocId "1841" .

<https://w3id.org/airo/incident/evidence/34de2c1e53b8> a airo:Evidence ;
    airo:evidenceText "(2nd LD) Developer of AI chatbot service fined for massive personal data breach" ;
    airo:sourceDocId "1230" .

<https://w3id.org/airo/incident/evidence/3e4074e9ffd6> a airo:Evidence ;
    airo:evidenceText "AI Chatbot ‘Lee Luda’ and Data Ethics" ;
    airo:sourceDocId "1236" .

<https://w3id.org/airo/incident/evidence/3e68239b36b4> a airo:Evidence ;
    airo:evidenceText "The fate of the Korean service resembled the demise of Microsoft’s Tay chatbot in 2016 over racist and sexist tweets it sent, raising ethical questions about the use of artificial intelligence (AI) technology and how to prevent abuse." ;
    airo:sourceDocId "9159" .

<https://w3id.org/airo/incident/evidence/3e920bff81a8> a airo:Evidence ;
    airo:evidenceText "South Korean chatbot 'Lee Luda' killed off for spewing hate" ;
    airo:sourceDocId "1232" .

<https://w3id.org/airo/incident/evidence/3f1ed18991e5> a airo:Evidence ;
    airo:evidenceText "In 2016, Microsoft shut down its chatbot Tay within 16 hours, as some users of an anonymous bulletin board used by Islamophobes and white supremacists deliberately trained Tay to say racist things." ;
    airo:sourceDocId "1231" .

<https://w3id.org/airo/incident/evidence/401ceaaebf4f> a airo:Evidence ;
    airo:evidenceText "Did we learn nothing from Tay?" ;
    airo:sourceDocId "9155" .

<https://w3id.org/airo/incident/evidence/409f0ccea572> a airo:Evidence ;
    airo:evidenceText "[1234] Scatter Lab's AI chatbot, Lee Luda, became an instant success among young locals... [1232] Scatter Lab, the chatbot’s developer, took Lee Luda offline after receiving many complaints from users." ;
    airo:sourceDocId "1234" .

<https://w3id.org/airo/incident/evidence/4d097118445a> a airo:Evidence ;
    airo:evidenceText "Luda is reminiscent of Microsoft's Tay, an AI Twitter bot that was silenced within 16 hours in 2016 after posting inflammatory and offensive tweets." ;
    airo:sourceDocId "1234" .

<https://w3id.org/airo/incident/evidence/505795f286de> a airo:Evidence ;
    airo:evidenceText "Luda was launched on Dec. 23 as a 20-year-old female bot running on Facebook Messenger." ;
    airo:sourceDocId "1841" .

<https://w3id.org/airo/incident/evidence/5461d183288b> a airo:Evidence ;
    airo:evidenceText "[1230] Scatter Lab... was ordered to pay 103.3 million won (US$92,900) in penalties -- a penalty surcharge of 55.5 million won and an administrative fine of 47.8 million won" ;
    airo:sourceDocId "1230" .

<https://w3id.org/airo/incident/evidence/65cbf821c245> a airo:Evidence ;
    airo:evidenceText "some Science of Lab users are reportedly working on a class-action lawsuit about their information being used for the bot" ;
    airo:sourceDocId "1232" .

<https://w3id.org/airo/incident/evidence/6f16fcba4500> a airo:Evidence ;
    airo:evidenceText "Civic groups file petition over human rights violations by chatbot Luda" ;
    airo:sourceDocId "1237" .

<https://w3id.org/airo/incident/evidence/80156e851c61> a airo:Evidence ;
    airo:evidenceText "Scatter Lab said its developers erased real names with its filtering algorithms but failed to remove all of them depending on the context, saying all data used in training Luda has been unverifiable and that it removed sensitive personal information, including names, phone numbers and addresses." ;
    airo:sourceDocId "1234" .

<https://w3id.org/airo/incident/evidence/844d41a5edbe> a airo:Evidence ;
    airo:evidenceText "[1234] chat like a real person on Facebook messenger, attracting more than 750,000 users" ;
    airo:sourceDocId "1234" .

<https://w3id.org/airo/incident/evidence/95766d560ef3> a airo:Evidence ;
    airo:evidenceText "[1230] using about 600,000 people's 9.4 billion KakaoTalk conversations... without obtaining their prior consent." ;
    airo:sourceDocId "1230" .

<https://w3id.org/airo/incident/evidence/96baef2d422d> a airo:Evidence ;
    airo:evidenceText "[1235] Lee Luda (a homonym for “realized” in Korean) is an open-domain conversational AI chatbot developed by ScatterLab, a South Korean start-up established in 2011." ;
    airo:sourceDocId "1235" .

<https://w3id.org/airo/incident/evidence/9de95b651065> a airo:Evidence ;
    airo:evidenceText "[1232] The South Korean bot, which went by the name of Lee Luda, was also caught using hate speech against trans, Black, and disabled people." ;
    airo:sourceDocId "1232" .

<https://w3id.org/airo/incident/evidence/a0035eaefe6f> a airo:Evidence ;
    airo:evidenceText "[1235] The coalition of civil society organizations... released a statement on January 13, denouncing the promotion of the AI industry" ;
    airo:sourceDocId "1235" .

<https://w3id.org/airo/incident/evidence/a8572d112a40> a airo:Evidence ;
    airo:evidenceText "South Korea’s AI chatbot Lee Luda (Luda) will be temporarily suspended after coming under fire for its discriminatory and vulgar statements, as well as privacy breach allegations." ;
    airo:sourceDocId "1841" .

<https://w3id.org/airo/incident/evidence/b7f8e9aa419a> a airo:Evidence ;
    airo:evidenceText "[1230] Scatter Lab is accused of using about 600,000 people's 9.4 billion KakaoTalk conversations collected from its emotional analysis apps Science of Love and Text At in the process of developing and operating the Lee Luda chatbot service without obtaining their prior consent." ;
    airo:sourceDocId "1230" .

<https://w3id.org/airo/incident/evidence/bea34ad8aa25> a airo:Evidence ;
    airo:evidenceText "Luda was integrated into Facebook Messenger, and users were encouraged to develop a relationship with her through regular, day-to-day conversations." ;
    airo:sourceDocId "1235" .

<https://w3id.org/airo/incident/evidence/c0fad1440fa5> a airo:Evidence ;
    airo:evidenceText "Lee Luda, the artificial intelligence [AI] persona of a 20-year-old female university student, was removed from Facebook messenger this week, after attracting more than 750,000 users in the 20 days since it was launched." ;
    airo:sourceDocId "1233" .

<https://w3id.org/airo/incident/evidence/c3d7841c3ae9> a airo:Evidence ;
    airo:evidenceText "[1231] Luda is believed to use mesh autoencoders, a natural language processing technology introduced by Google." ;
    airo:sourceDocId "1231" .

<https://w3id.org/airo/incident/evidence/c85d8bd3c93b> a airo:Evidence ;
    airo:evidenceText "South Korean AI chatbot pulled from Facebook after hate speech towards minorities" ;
    airo:sourceDocId "1233" .

<https://w3id.org/airo/incident/evidence/cae9e3fbb147> a airo:Evidence ;
    airo:evidenceText "AI chatbot creator to suspend service amid controversy over vulgar language" ;
    airo:sourceDocId "9153" .

<https://w3id.org/airo/incident/evidence/d1039659ecb5> a airo:Evidence ;
    airo:evidenceText "No evidence of verification testing mentioned in the provided text." ;
    airo:sourceDocId "1222" .

<https://w3id.org/airo/incident/evidence/d209230ed237> a airo:Evidence ;
    airo:evidenceText "Emotional chatbots capable of having natural conversations with humans are nothing new among English speakers, but a new controversy over a South Korean startup's AI chatbot has raised ethical questions over its learning algorithms and data collection process." ;
    airo:sourceDocId "1234" .

<https://w3id.org/airo/incident/evidence/d3b5b78ea770> a airo:Evidence ;
    airo:evidenceText "The service quickly gained popularity, attracting more than 750,000 users since its launch in December, largely on the back of its deep-learning-based program designed to be able to talk like a real person in a mobile messenger." ;
    airo:sourceDocId "9153" .

<https://w3id.org/airo/incident/evidence/d41bf50ee7e5> a airo:Evidence ;
    airo:evidenceText "AI Chatbot Shut Down After Learning To Talk Like a Racist Asshole" ;
    airo:sourceDocId "9159" .

<https://w3id.org/airo/incident/evidence/da3169d5f1fb> a airo:Evidence ;
    airo:evidenceText "However, expansion came to a screeching halt when Scatter Lab added a chatbot service named \"Lee-Luda\", marketed as a 20-something AI friend available for those who'd given up on human interaction." ;
    airo:sourceDocId "9157" .

<https://w3id.org/airo/incident/evidence/daea0d03fc3f> a airo:Evidence ;
    airo:evidenceText "A South Korean Chatbot Shows Just How Sloppy Tech Companies Can Be With User Data" ;
    airo:sourceDocId "1238" .

<https://w3id.org/airo/incident/evidence/dd3547950190> a airo:Evidence ;
    airo:evidenceText "Luda had impressed users with the depth and natural tone of its responses, drawn from 10 billion real-life conversations between young couples taken from KakaoTalk, South Korea’s most popular messaging app." ;
    airo:sourceDocId "1233" .

<https://w3id.org/airo/incident/evidence/dede2c768626> a airo:Evidence ;
    airo:evidenceText "[1235] Lee Luda is an open-domain conversational AI chatbot developed by ScatterLab... [1234] chat like a real person on Facebook messenger" ;
    airo:sourceDocId "1235" .

<https://w3id.org/airo/incident/evidence/e3fb2e3061ca> a airo:Evidence ;
    airo:evidenceText "CEO says controversial AI chatbot ‘Luda’ will socialize in time" ;
    airo:sourceDocId "1231" .

<https://w3id.org/airo/incident/evidence/e7e64e1ff608> a airo:Evidence ;
    airo:evidenceText "For instance, in 2016, Microsoft launched its chatbot “Tay,” and had to shut it down within hours when users were training it to make offensive remarks against certain groups." ;
    airo:sourceDocId "1235" .

<https://w3id.org/airo/incident/evidence/f65912ebea7c> a airo:Evidence ;
    airo:evidenceText "[1230] Scatter Lab is accused of using about 600,000 people's 9.4 billion KakaoTalk conversations collected from its emotional analysis apps Science of Love and Text At in the process of developing and operating the Lee Luda chatbot service without obtaining their prior consent." ;
    airo:sourceDocId "1230" .

<https://w3id.org/airo/incident/evidence/fa18ed67cdda> a airo:Evidence ;
    airo:evidenceText "The fate of the Korean service resembled the demise of Microsoft’s Tay chatbot in 2016 over racist and sexist tweets it sent, raising ethical questions about the use of artificial intelligence (AI) technology and how to prevent abuse." ;
    airo:sourceDocId "1229" .

<https://w3id.org/airo/incident/evidence/fdaaecfaaa52> a airo:Evidence ;
    airo:evidenceText "AI chatbot mired in legal dispute over data collection" ;
    airo:sourceDocId "1222" .

